#!/usr/bin/env python3
"""`qbt-serve`: a long-lived sidecar for OmaqBT's QML bar widget.

It runs `qbt probe` once at startup (and again every 10s of ticking, or
on an explicit `refresh`), signs every WebUI request with the API key in the
probe's qBittorrent.conf (so its session is the key's, shared with qbt), and
polls `lib/qbtsync.build_status` on a cadence a QML `Process` controls
over stdin. Every stdout line is one
JSON object (`{"type":...}` first) with a trailing newline; diagnostics
(sanitized) go to stderr only.

Three threads touch stdout/stdin, and none of them may be stalled by a
qBittorrent daemon that accepts a connection and then never answers
(`build_status` can block for one `Client` timeout per call, and a
reprobe blocks on a `qbt probe` subprocess):

  - the main thread: reads commands off a queue and ticks.
  - a reader thread: parses stdin lines onto that queue, and -- this is
    the part that must not wait on the main thread -- exits the whole
    process the instant stdin hits EOF, however busy the main thread is.
  - a heartbeat thread: prints a heartbeat every 5s on its own clock,
    independent of whatever the main thread is doing.

The main and heartbeat threads write to stdout, and the reader thread
flushes it on its way out, so `emit()` serializes every write with a
lock rather than restricting writers to one thread.
"""
import fcntl
import http.cookiejar
import json
import os
import queue
import re
import subprocess
import sys
import threading
import time
import warnings

REPO_DIR = os.path.dirname(os.path.realpath(__file__))
# Omarchy's plugin watcher reloads the plugin (and closes its window) on any
# file write under the plugin folder, so the imports below must not write
# lib/__pycache__. Cache bytecode under the runtime state dir, resolved exactly
# as `qbt` resolves STATE_DIR (QBT_STATE_DIR, else $XDG_RUNTIME_DIR/omaqbt,
# else /tmp/omaqbt-<uid>), before anything is imported from lib/.
if os.environ.get("XDG_RUNTIME_DIR"):
    _state_dir = os.environ.get("QBT_STATE_DIR") or os.path.join(os.environ["XDG_RUNTIME_DIR"], "omaqbt")
else:
    _state_dir = os.environ.get("QBT_STATE_DIR") or "/tmp/omaqbt-%d" % os.getuid()
sys.pycache_prefix = os.path.join(_state_dir, "pycache")
sys.path.insert(0, os.path.join(REPO_DIR, "lib"))
import qbtsync  # noqa: E402
import speedhist  # noqa: E402

HEARTBEAT_INTERVAL = 5.0
PROBE_INTERVAL = 10.0
DEFAULT_CADENCE_MS = 5000
MIN_CADENCE_MS = 100
MAX_CADENCE_MS = 3600000
PROBE_TIMEOUT = 10
INSPECT_TIMEOUT = 1
WATCH_TABS = ("info", "trackers", "peers", "chart")
WATCH_BACKOFF_SECONDS = 5.0
WATCH_PIECES_INTERVAL = 5.0
# Slice 5a: the search watch (tests/fixtures/search-contract.md).
SEARCH_POLL_INTERVAL = 1.0
SEARCH_CAP = 2000
SEARCH_PAGE = 500
SEARCH_TIMEOUT = 1
SEARCH_ID_MAX = 2147483647

_HASH_RE = re.compile(r"[0-9a-fA-F]{40}|[0-9a-fA-F]{64}")
_STDOUT_LOCK = threading.Lock()


def emit(obj):
    """Write one JSON line to stdout under `_STDOUT_LOCK`, the one rule
    that keeps the main, heartbeat, and reader threads from interleaving
    partial lines. A dead reader on the other end (BrokenPipeError) means
    the consumer is gone: exit 0 immediately via os._exit, skipping
    interpreter finalization. Regular shutdown would re-flush stdout
    (which would raise again) and, worse, the stdin-reader thread may be
    blocked inside the buffered reader's lock, which can abort
    finalization outright."""
    line = json.dumps(obj, separators=(",", ":")) + "\n"
    with _STDOUT_LOCK:
        try:
            sys.stdout.write(line)
            sys.stdout.flush()
        except BrokenPipeError:
            try:
                sys.stderr.flush()
            except Exception:
                pass
            os._exit(0)


def run_probe(helper):
    """Run `<helper> probe` and parse its JSON. Returns (probe, error);
    exactly one of them is not None. `error` is unsanitized -- callers
    sanitize before printing it anywhere."""
    try:
        result = subprocess.run(
            [helper, "probe"], capture_output=True, text=True, timeout=PROBE_TIMEOUT
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return None, str(exc) or type(exc).__name__
    if result.returncode != 0:
        msg = (result.stderr or "").strip() or f"probe exited {result.returncode}"
        return None, msg
    try:
        probe = json.loads(result.stdout)
    except ValueError:
        return None, "invalid probe output"
    if not isinstance(probe, dict):
        return None, "invalid probe output"
    return probe, None


def _reader_thread(cmd_queue):
    """Reads stdin lines and puts (\"cmd\", dict-or-None) for each one.

    On EOF (or any read error) it does NOT hand off to the main thread:
    the main thread can be blocked for seconds inside an HTTP call or a
    `qbt probe` subprocess against a stalled daemon, and "exit within 1s
    of stdin EOF" has to hold regardless. So this thread flushes stdout
    itself, under the same lock `emit()` uses, and exits the whole
    process directly. The OS reclaims the flock and every fd on exit."""
    try:
        for line in sys.stdin:
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except ValueError:
                obj = None
            if not isinstance(obj, dict):
                obj = None
            cmd_queue.put(("cmd", obj))
    except Exception:
        pass
    with _STDOUT_LOCK:
        try:
            sys.stdout.flush()
        except Exception:
            pass
    os._exit(0)


def _heartbeat_thread():
    """Prints a heartbeat every 5s by its own monotonic clock, forever,
    on a daemon thread -- so a main thread stuck in an HTTP call or a
    reprobe never delays it. Scheduled off a fixed anchor rather than
    `time.sleep(HEARTBEAT_INTERVAL)` in a loop so it doesn't drift by
    however long each `emit()` call took."""
    next_at = time.monotonic() + HEARTBEAT_INTERVAL
    while True:
        delay = next_at - time.monotonic()
        if delay > 0:
            time.sleep(delay)
        emit({"type": "heartbeat"})
        next_at += HEARTBEAT_INTERVAL


def do_tick(state, force_probe=False):
    """Re-probes if stale (or if `force_probe`), then assembles and prints
    one status line, then reads whatever the current watch needs (F10:
    status always goes out first)."""
    now_mono = time.monotonic()
    if force_probe or now_mono - state["last_probe_at"] >= PROBE_INTERVAL:
        new_probe, err = run_probe(state["helper"])
        state["last_probe_at"] = now_mono
        if new_probe is not None:
            state["probe"] = new_probe
            # The probe names the conf the key is read from.
            for name in ("client", "inspect_client", "search_client"):
                state[name].conf = new_probe.get("conf") or None
        elif err:
            print(qbtsync.sanitize(err), file=sys.stderr)

    now_wall = time.time()
    status, errors = qbtsync.build_status(
        state["probe"], state["client"], state["sync"], state["slow"], now_wall
    )
    for message in errors:
        print(qbtsync.sanitize(message), file=sys.stderr)

    if status.get("api"):
        # Only when maindata was actually re-fetched this tick: a failed
        # fetch leaves state["sync"].torrents exactly as it was, and
        # feeding that stale snapshot in again would either replay old
        # speeds as fresh samples or (read as "every torrent left
        # maindata") wipe every buffer.
        state["speedhist"].record(state["sync"].torrents, now_wall)

    out = {"type": "status"}
    out.update(status)
    emit(out)

    read_inspect(state)


def _inspect_get_json(state, h, tab, path, now, expected_type):
    """GET `path` on the inspect client and parse the body as
    `expected_type` (list or dict).

    On a transport failure this already emits the inspect error line
    (sanitized, like `files`) and sets `watch_backoff_until`; callers just
    check the result for `None` and return -- there is nothing left for
    them to do. A malformed or wrong-shaped body (not a transport
    failure) comes back as an empty instance of `expected_type`, the same
    leniency `files` already applies, and is never confused with a `None`
    failure since `expected_type()` is falsy-but-not-`None`."""
    try:
        body = state["inspect_client"].get(path)
    except qbtsync.ApiError as exc:
        emit({"type": "inspect", "hash": h, "tab": tab, "error": qbtsync.sanitize(exc.message)})
        state["watch_backoff_until"] = now + WATCH_BACKOFF_SECONDS
        return None
    try:
        parsed = json.loads(body)
    except ValueError:
        parsed = None
    return parsed if isinstance(parsed, expected_type) else expected_type()


def _inspect_ok(state, obj):
    """Emits a successful inspect line and clears any back-off a prior
    failure on this watch had set."""
    emit(obj)
    state["watch_backoff_until"] = 0


def read_inspect(state):
    """Reads whatever `state["watch"]` currently needs and emits one
    `inspect` line, unless a prior failure's back-off is still in effect
    (at most one read attempt per `WATCH_BACKOFF_SECONDS` while failing,
    F10/OV7). Always clears `watch_due`, since this call -- whether it
    actually reads or is skipped by back-off -- is what a caller waits on
    to answer a fresh watch (F3)."""
    state["watch_due"] = False
    watch = state.get("watch")
    if not watch:
        return

    now = time.monotonic()
    if now < (state.get("watch_backoff_until") or 0):
        return

    h = watch["hash"]
    tab = watch["tab"]

    if tab == "chart":
        # F9: reads state["speedhist"]'s buffer, never the network -- the
        # buffer is fed once per tick, from maindata, in do_tick.
        points = state["speedhist"].points(h)
        _inspect_ok(state, {"type": "inspect", "hash": h, "tab": tab, "points": points})
        return

    if tab == "trackers":
        trackers = _inspect_get_json(
            state, h, tab, f"/api/v2/torrents/trackers?hash={h}", now, list
        )
        if trackers is None:
            return
        _inspect_ok(state, {"type": "inspect", "hash": h, "tab": tab, "trackers": trackers})
        return

    if tab == "peers":
        parsed = _inspect_get_json(
            state, h, tab, f"/api/v2/sync/torrentPeers?hash={h}&rid=0", now, dict
        )
        if parsed is None:
            return
        peers = parsed.get("peers")
        if not isinstance(peers, dict):
            peers = {}
        _inspect_ok(state, {"type": "inspect", "hash": h, "tab": tab, "peers": peers})
        return

    # tab == "info"
    props = _inspect_get_json(state, h, tab, f"/api/v2/torrents/properties?hash={h}", now, dict)
    if props is None:
        return

    pieces = None
    if state.get("watch_pieces_next", 0) <= now:
        pieces = _inspect_get_json(
            state, h, tab, f"/api/v2/torrents/pieceStates?hash={h}", now, list
        )
        if pieces is None:
            return
        state["watch_pieces_next"] = now + WATCH_PIECES_INTERVAL

    _inspect_ok(state, {"type": "inspect", "hash": h, "tab": tab, "props": props, "pieces": pieces})


def _search_int(value, low, high):
    return isinstance(value, int) and not isinstance(value, bool) and low <= value <= high


def _search_load_session(state):
    """Points the search client at qbt's WebUI session: a fresh
    `CurlCookieJar` read from the probe's cookieFile (curl's own jar), and a
    new client around it. Search jobs are per session in qBittorrent 5.2.3
    (webapplication.cpp:844, a SearchController per WebSession), and qbt
    starts them in its session, so the sidecar must read through the same
    one. Under the API key that session is the key itself, which the client
    sends, and the jar stays empty. Returns False on a failed load (a
    half-written or unreadable file), which is transient: the client is
    left as it was.

    Read-only: the jar is never saved (curl rewrites that file on every
    `qbt` run). A missing file is an empty jar -- qbt has made no request
    yet, so it holds no job -- and a request without a SID then reads 404.
    Nothing from a failed load is printed anywhere: a LoadError's message
    quotes the offending line, SID and all."""
    path = (state["probe"] or {}).get("cookieFile") or ""
    jar = qbtsync.CurlCookieJar(path or None)
    try:
        if path and os.path.exists(path):
            # A malformed line makes the stdlib print a "cookiejar bug!"
            # warning and traceback on stderr before raising LoadError.
            with warnings.catch_warnings():
                warnings.simplefilter("ignore")
                jar.load(path)
        client = qbtsync.Client(state["probe"]["base"], jar, timeout=SEARCH_TIMEOUT,
                                conf=state["probe"].get("conf") or None)
    except Exception:
        return False
    state["search_client"] = client
    return True


def _search_read(state, watch):
    """One read for `watch`: (status, total, rows), "missing" (a 404: not in
    this session), "gone" (a results 409), or None for a failure that is
    retried on the next poll. Below the cap it's one
    results page (status, total and rows from the same response); at the
    cap it's the job's status with no rows, since a results read with
    limit 0 would return every row (OV15)."""
    jid, offset = watch["id"], watch["offset"]
    if offset < SEARCH_CAP:
        limit = min(SEARCH_PAGE, SEARCH_CAP - offset)
        path = f"/api/v2/search/results?id={jid}&limit={limit}&offset={offset}"
    else:
        limit = 0
        path = f"/api/v2/search/status?id={jid}"
    try:
        body = state["search_client"].get(path)
    except qbtsync.ApiError as exc:
        # 404: the job is gone (a qBittorrent restart). A results 409
        # (offset past the end) can't happen while the window's offset
        # invariant holds; if one does, it's treated the same, so a watch
        # never retries a bad offset forever.
        if exc.code == 404:
            return "missing"
        if exc.code == 409 and limit:
            return "gone"
        # Anything else (qBittorrent down, another code) sends nothing: the
        # status line's api:false already says so, and the next poll retries.
        return None
    try:
        parsed = json.loads(body)
    except ValueError:
        return None
    if not limit:
        parsed = parsed[0] if isinstance(parsed, list) and len(parsed) == 1 else None
    if not isinstance(parsed, dict):
        return None
    status, total = parsed.get("status"), parsed.get("total")
    rows = parsed.get("results", []) if limit else []
    if status not in ("Running", "Stopped") or not _search_int(total, 0, 2**53) or not isinstance(rows, list):
        return None
    # Never past row 2000, whatever came back; the rows themselves pass
    # through untouched (OV9: sanitising lives only in SearchView.js).
    return status, total, rows[:limit]


def read_search(state):
    """Polls the search watch once and emits a reply when one is due: after
    a command, whenever rows arrive, whenever status or total changed, and
    always for the final reply (Ruling FB: Stopped and offset + rows ==
    min(total, 2000), zero rows allowed), after which the watch drops.

    Ruling FH: a watch whose session load failed loads again first (and
    sends nothing if that fails too). A 404 reloads qbt's cookie file once
    and retries, so a SID that rotated since the load is picked up; only a
    second 404 is `gone`."""
    watch = state.get("search")
    state["search_next"] = time.monotonic() + SEARCH_POLL_INTERVAL
    if not watch:
        return
    if not watch["session"]:
        watch["session"] = _search_load_session(state)
        if not watch["session"]:
            return
    result = _search_read(state, watch)
    if result == "missing":
        watch["session"] = _search_load_session(state)
        if not watch["session"]:
            return
        result = _search_read(state, watch)
    if result is None:
        return
    if result in ("missing", "gone"):
        emit({"type": "search", "id": watch["id"], "error": "gone"})
        state["search"] = None
        return
    status, total, rows = result
    offset = watch["offset"]
    final = status == "Stopped" and offset + len(rows) == min(total, SEARCH_CAP)
    changed = (status, total) != (watch.get("status"), watch.get("total"))
    if watch.get("due") or rows or changed or final:
        emit({
            "type": "search",
            "id": watch["id"],
            "status": status,
            "total": total,
            "offset": offset,
            "rows": rows,
            "capped": total > SEARCH_CAP,
        })
        watch["status"], watch["total"] = status, total
    watch["due"] = False
    watch["offset"] = offset + len(rows)
    if final:
        state["search"] = None


def handle_command(cmd, state):
    """Dispatches one non-`refresh` command. `refresh` is handled by the
    caller instead, so that several queued refreshes collapse into one
    tick rather than one blocking HTTP round-trip apiece."""
    name = cmd.get("cmd")
    cid = cmd.get("id")

    if name == "cadence":
        ms = cmd.get("ms")
        if isinstance(ms, bool) or not isinstance(ms, (int, float)):
            emit({"type": "error", "id": cid, "error": "bad command"})
            return
        clamped = max(MIN_CADENCE_MS, min(MAX_CADENCE_MS, ms))
        state["cadence_ms"] = clamped
        # Takes effect from the next wait: reschedule right away rather
        # than waiting out whatever interval was already in flight.
        state["next_tick"] = time.monotonic() + clamped / 1000.0
        return

    if name == "refresh-slow":
        # Forces the SlowCache's next `due()` check to reread
        # /app/preferences (Service sends this after a successful
        # setPref), and pulls the next tick forward to now rather than
        # waiting out whatever cadence interval is already in flight --
        # the same "reschedule right away" trick `cadence` uses above.
        # No probe reprobe and no reply of its own: the caller sees the
        # refreshed preferences on the status line that follows.
        state["slow"].fetched_at = None
        state["next_tick"] = time.monotonic()
        return

    if name == "files":
        h = cmd.get("hash")
        if not isinstance(h, str) or not _HASH_RE.fullmatch(h):
            emit({"type": "error", "id": cid, "error": "bad command"})
            return
        try:
            body = state["client"].get(f"/api/v2/torrents/files?hash={h}")
        except qbtsync.ApiError as exc:
            emit({"type": "files", "id": cid, "hash": h, "error": qbtsync.sanitize(exc.message)})
            return
        try:
            parsed = json.loads(body)
        except ValueError:
            parsed = None
        files = parsed if isinstance(parsed, list) else []
        emit({"type": "files", "id": cid, "hash": h, "files": files})
        return

    if name == "watch":
        h = cmd.get("hash")
        tab = cmd.get("tab")
        if tab not in WATCH_TABS:
            emit({"type": "error", "id": cid, "error": "bad command"})
            return
        if h is not None and (not isinstance(h, str) or not _HASH_RE.fullmatch(h)):
            emit({"type": "error", "id": cid, "error": "bad command"})
            return
        if h is None:
            state["watch"] = None
            state["watch_due"] = False
            return
        new_watch = {"hash": h, "tab": tab}
        # An identical re-send (same hash and tab -- e.g. a duplicate
        # command, or the cursor settling back where it started) leaves
        # any running back-off and the pieceStates timer alone; only an
        # actually *changed* watch resets them.
        if new_watch != state.get("watch"):
            state["watch_pieces_next"] = 0
            state["watch_backoff_until"] = 0
        state["watch"] = new_watch
        state["watch_due"] = True
        return

    if name == "search":
        # The window owns the offset (OV7): the watch is only the latest
        # command's {id, offset} plus what was last reported.
        # The id key must be present (null or an int): a bare
        # {"cmd":"search"} is a bad command, never a stop.
        if "id" not in cmd:
            emit({"type": "error", "id": None, "error": "bad command"})
            return
        jid = cmd.get("id")
        if jid is None:
            state["search"] = None
            return
        offset = cmd.get("offset")
        if not _search_int(jid, 1, SEARCH_ID_MAX) or not _search_int(offset, 0, SEARCH_CAP):
            emit({"type": "error", "id": cid, "error": "bad command"})
            return
        state["search"] = {"id": jid, "offset": offset, "status": None, "total": None, "due": True,
                           "session": _search_load_session(state)}
        return

    emit({"type": "error", "id": cid, "error": "bad command"})


def _is_refresh(item):
    kind, payload = item
    return kind == "cmd" and payload is not None and payload.get("cmd") == "refresh"


def _is_watch(item):
    kind, payload = item
    return kind == "cmd" and payload is not None and payload.get("cmd") == "watch"


def _is_search(item):
    kind, payload = item
    return kind == "cmd" and payload is not None and payload.get("cmd") == "search"


def drain_and_dispatch(cmd_queue, first_item, state):
    """Handles `first_item` plus everything already queued behind it,
    without blocking for more. Any number of queued `refresh` commands
    collapse into a single tick at the end, instead of one `do_tick` (and
    its HTTP round-trip) per queued refresh. Queued `watch` commands
    collapse the same way: only the last one in the batch is applied (a
    burst of cursor movement answers only where the cursor ended up, not
    every torrent it passed over). So do queued `search` commands: each
    replaces the whole watch, so only the last one matters."""
    pending_refresh = False
    pending_watch = None
    pending_search = None
    item = first_item
    while item is not None:
        kind, payload = item
        if _is_refresh(item):
            pending_refresh = True
        elif _is_watch(item):
            pending_watch = payload
        elif _is_search(item):
            pending_search = payload
        elif kind == "cmd":
            if payload is None:
                emit({"type": "error", "id": None, "error": "bad command"})
            else:
                handle_command(payload, state)
        try:
            item = cmd_queue.get_nowait()
        except queue.Empty:
            item = None
    if pending_watch is not None:
        handle_command(pending_watch, state)
    if pending_search is not None:
        handle_command(pending_search, state)
    return pending_refresh


def main():
    helper = os.environ.get("QBT_HELPER") or os.path.join(REPO_DIR, "qbt")

    probe, err = run_probe(helper)
    if probe is None:
        emit({"type": "fatal", "error": qbtsync.sanitize(err or "probe failed")})
        return 2

    try:
        qbtsync.assert_local(probe.get("base") or "")
    except ValueError as exc:
        emit({"type": "fatal", "error": qbtsync.sanitize(str(exc))})
        return 2

    state_dir = probe.get("stateDir") or "."
    lock_path = os.path.join(state_dir, "serve.lock")
    try:
        lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    except OSError as exc:
        emit({"type": "fatal", "error": qbtsync.sanitize(str(exc))})
        return 2

    deadline = time.monotonic() + 3.0
    acquired = False
    while True:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            acquired = True
            break
        except OSError:
            if time.monotonic() >= deadline:
                break
            time.sleep(0.1)
    if not acquired:
        emit({"type": "fatal", "error": "locked"})
        os.close(lock_fd)
        return 3

    cmd_queue = queue.Queue()
    threading.Thread(target=_reader_thread, args=(cmd_queue,), daemon=True).start()
    threading.Thread(target=_heartbeat_thread, daemon=True).start()

    jar = http.cookiejar.CookieJar()
    conf = probe.get("conf") or None
    client = qbtsync.Client(probe["base"], jar, conf=conf)
    # Inspect reads share the status client's cookie jar (same session) but
    # get their own short timeout, so a stalled inspect route can never
    # hold up the status client's much longer 5s budget.
    inspect_client = qbtsync.Client(probe["base"], jar, timeout=INSPECT_TIMEOUT, conf=conf)
    # qBittorrent keeps search jobs per WebUI session. Every client here,
    # and qbt too, sends the Bearer API key, so qBittorrent sees one
    # session (the key's) and search reads see qbt's jobs. The search
    # client keeps its CurlCookieJar only for the old cookie path
    # (_search_load_session), which is now inert.
    search_client = qbtsync.Client(probe["base"], qbtsync.CurlCookieJar(), timeout=SEARCH_TIMEOUT, conf=conf)
    state = {
        "helper": helper,
        "probe": probe,
        "client": client,
        "inspect_client": inspect_client,
        "search_client": search_client,
        "search": None,
        "search_next": 0,
        "sync": qbtsync.SyncState(),
        "slow": qbtsync.SlowCache(interval=10),
        "speedhist": speedhist.SpeedHistory(),
        "cadence_ms": DEFAULT_CADENCE_MS,
        "last_probe_at": time.monotonic(),
        "watch": None,
        "watch_due": False,
        "watch_pieces_next": 0,
        "watch_backoff_until": 0,
    }

    # The first tick runs immediately after the lock is acquired.
    do_tick(state)
    state["next_tick"] = time.monotonic() + state["cadence_ms"] / 1000.0

    # Runs forever: the reader thread exits the whole process on stdin
    # EOF (or a dead stdout, via emit()'s BrokenPipeError handler), so
    # there is no in-band condition for this loop itself to break on.
    while True:
        now = time.monotonic()
        wake = state["next_tick"]
        if state["search"]:
            # The search watch polls about once a second, whatever the
            # status cadence is.
            wake = min(wake, state["search_next"])
        timeout = max(0.0, wake - now)
        try:
            item = cmd_queue.get(timeout=timeout)
        except queue.Empty:
            item = None
        if item is not None:
            pending_refresh = drain_and_dispatch(cmd_queue, item, state)
            if pending_refresh:
                # An explicit refresh usually follows Start daemon /
                # Install, so it reprobes now rather than waiting out
                # PROBE_INTERVAL. do_tick's own read_inspect covers a
                # freshly-applied watch too, so there is no separate read
                # here in this branch.
                do_tick(state, force_probe=True)
                state["next_tick"] = time.monotonic() + state["cadence_ms"] / 1000.0
            elif state["watch_due"]:
                # A changed watch is answered at once (F3), rather than
                # waiting out the cadence for the next tick.
                read_inspect(state)
            if state["search"] and state["search"]["due"]:
                # A search command is answered at once too.
                read_search(state)

        now = time.monotonic()
        if now >= state["next_tick"]:
            do_tick(state)
            state["next_tick"] = now + state["cadence_ms"] / 1000.0
        if state["search"] and time.monotonic() >= state["search_next"]:
            read_search(state)


if __name__ == "__main__":
    sys.exit(main())
