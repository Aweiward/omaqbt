#!/usr/bin/env bash
# An exported SHELLOPTS turns options on before this line runs: allexport
# would put a secret read from stdin into every child's environment, and
# xtrace would print it on stderr (Ruling EE). The group's stderr hides
# the trace of this very line.
{ set +o xtrace +o allexport; } 2>/dev/null
set -euo pipefail

HOME_DIR="${QBT_HOME:-$HOME}"
CONF="${QBT_CONF:-$HOME_DIR/.config/qBittorrent/qBittorrent.conf}"
# Prefer the private per-user runtime dir (/run/user/UID, mode 0700). Only when
# it is missing fall back to a uid-scoped /tmp path, never the shared /tmp/omaqbt
# that any local user could pre-create as a symlink.
if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
  STATE_DIR="${QBT_STATE_DIR:-$XDG_RUNTIME_DIR/omaqbt}"
else
  STATE_DIR="${QBT_STATE_DIR:-/tmp/omaqbt-$(id -u)}"
fi
# Omarchy watches the deployed plugin folder with `inotifywait -r` and reloads
# the plugin (closing its window) on any file write under it, so Python must
# never write .pyc files into lib/__pycache__. Cache bytecode under the state
# dir instead; Python creates the directory itself. Exported before any python3
# child runs. qbt-serve mirrors this location (sys.pycache_prefix).
export PYTHONPYCACHEPREFIX="$STATE_DIR/pycache"
RID_FILE="${QBT_RID_FILE:-$STATE_DIR/rid.json}"
# qBittorrent keeps sync/maindata rid state per WebUI session. Without a
# persisted SID every poll opens a new session and gets a full update.
COOKIE_FILE="${QBT_COOKIE_FILE:-$(dirname "$RID_FILE")/cookies}"
UNIT_DIR="$HOME_DIR/.config/systemd/user"
UNIT_FILE="$UNIT_DIR/omaqbt-nox.service"

# The one refusal message for a 403 (qBittorrent turned the API key away),
# and the shape of a key qBittorrent 5.2.3 accepts (Utils::APIKey::isValid:
# "qbt_" plus 28 characters).
API_KEY_REFUSED="qBittorrent refused OmaqBT's API key"
API_KEY_PATTERN='^qbt_[A-Za-z0-9]{28}$'

sanitize() {
  sed -E 's/SID=[^;[:space:]]*/SID=<redacted>/gi; s/password=[^;[:space:]]*/password=<redacted>/gi; s/qbt_[A-Za-z0-9]{28}/qbt_<redacted>/g'
}

die() {
  printf '%s\n' "$*" | sanitize >&2
  exit 1
}

# A value percent-encoded for a form body. It reaches jq through the
# environment (owner-only), never its argv: /proc/*/cmdline is world
# readable, and a tracker URL, magnet or download link can carry a passkey.
uri_encode() {
  URI_V=$1 jq -nr 'env.URI_V|@uri'
}

# Reads stdin to EOF into STDIN_FIELDS, split on NUL: no trailing NUL (a
# trailing one is one more, empty, field). Anything but exactly $1 fields,
# or an empty one, dies with the usage line $2. How the widget hands qbt a
# value that may carry a passkey (`--stdin`), off every argv. A stdin that
# never ends (Quickshell leaves the pipe open when nothing is written) is
# given up after 10 s, so a mistake can't hold the widget's queue forever.
stdin_fields() {
  local want=$1 usage=$2 f="" v rc
  STDIN_FIELDS=()
  while :; do
    f="" rc=0
    IFS= read -t 10 -r -d '' f || rc=$?
    (( rc == 0 )) || break
    STDIN_FIELDS+=("$f")
  done
  (( rc > 128 )) && die "$usage"
  STDIN_FIELDS+=("$f")
  (( ${#STDIN_FIELDS[@]} == want )) || die "$usage"
  for v in "${STDIN_FIELDS[@]}"; do
    [[ -n $v ]] || die "$usage"
  done
}

# Accepts "all", or one or more torrent hashes joined by "|" (each a 40-char
# v1 or 64-char v2 infohash). Anything else -- extra params, shell
# metacharacters, empty segments -- is rejected before it ever reaches a
# form body or query string.
#
# Uses the POSIX [:xdigit:] class, not a [0-9a-fA-F] range: under a UTF-8
# locale (e.g. en_US.UTF-8), bash's =~ collates character *ranges* by the
# locale's LC_COLLATE order, not raw code points, so [0-9a-fA-F] can end up
# matching non-ASCII characters (accented letters, fullwidth digits,
# superscripts) that collate between the range's endpoints. POSIX classes
# are defined against LC_CTYPE instead and stay ASCII-only.
valid_hashes() {
  local input=${1:-}
  local hash_re='[[:xdigit:]]{40}|[[:xdigit:]]{64}'
  local re="^(${hash_re})(\|(${hash_re}))*\$"
  [[ $input == all || $input =~ $re ]]
}

valid_single_hash() {
  local input=${1:-}
  [[ $input =~ ^([[:xdigit:]]{40}|[[:xdigit:]]{64})$ ]]
}

# F5: udp://, http://, https:// or wss://, at most 2048 characters,
# printable ASCII only (0x21-0x7E: no whitespace, no control or non-ASCII
# character), no "|". "&" and "=" are legal (tracker URLs carry passkeys as
# query-string params) -- the value is always @uri-encoded before it goes
# into a form body, so it can never be split into extra fields. LC_ALL=C
# (local to this function) makes ${#input} count bytes and [!-~] a byte
# range, so the checks match InspectorView.trackerUrlError exactly (Ruling
# AE; shared cases in tests/fixtures/validation-cases.json).
valid_tracker_url() {
  local input=${1:-}
  local LC_ALL=C
  [[ -n $input ]] || return 1
  [[ ${#input} -le 2048 ]] || return 1
  [[ $input =~ ^(udp|https?|wss):// ]] || return 1
  [[ $input =~ ^[!-~]+$ ]] || return 1
  [[ $input != *'|'* ]] || return 1
  return 0
}

valid_port() {
  local port=${1:-}
  # [:digit:] (not [0-9], see valid_hashes above) so a fullwidth or other
  # locale-collated digit-lookalike can't slip through here either -- and a
  # leading zero (e.g. "089") would make bash read the number as octal and
  # abort on the invalid digit, so force base 10 too.
  # At most 5 digits before any arithmetic: a longer string could wrap a
  # 64-bit integer back into range (18446744073709551617 is 1).
  [[ $port =~ ^[[:digit:]]{1,5}$ ]] || return 1
  (( 10#$port >= 1 && 10#$port <= 65535 ))
}

valid_ipv4() {
  local ip=${1:-}
  [[ $ip =~ ^([[:digit:]]{1,3})\.([[:digit:]]{1,3})\.([[:digit:]]{1,3})\.([[:digit:]]{1,3})$ ]] || return 1
  local o
  for o in "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"; do
    (( 10#$o <= 255 )) || return 1
  done
  return 0
}

# A ban target is exactly one IPv4:port or [IPv6]:port (port 1-65535).
valid_peer() {
  local input=${1:-}
  [[ -n $input ]] || return 1
  if [[ $input == \[*\]:* ]]; then
    [[ $input =~ ^\[([[:xdigit:]:]+)\]:([[:digit:]]+)$ ]] || return 1
    valid_port "${BASH_REMATCH[2]}"
    return $?
  fi
  local ip=${input%:*}
  local port=${input##*:}
  [[ $input == "$ip:$port" ]] || return 1
  valid_ipv4 "$ip" || return 1
  valid_port "$port"
}

# Slice 3b (D5): the canonical limit values on the wire. The boundaries are
# pinned in tests/fixtures/validation-cases.json ("speeds", "ratios",
# "seedTimes"), which the window's parser is tested against too. Every
# regex caps the length before any 10# arithmetic, so a long digit string
# can't wrap a 64-bit integer back into range; no leading zeros.
# Speed: bytes/s, 0-2147483647 (0 = unlimited).
valid_speed() {
  local input=${1:-} LC_ALL=C
  [[ $input =~ ^(0|[1-9][[:digit:]]{0,9})$ ]] || return 1
  (( 10#$input <= 2147483647 ))
}

# Ratio: -2 (default), -1 (none), or 0-9998 with at most 2 decimals.
valid_ratio() {
  local input=${1:-} LC_ALL=C
  [[ $input == -2 || $input == -1 ]] && return 0
  [[ $input =~ ^(0|[1-9][[:digit:]]{0,3})(\.([[:digit:]]{1,2}))?$ ]] || return 1
  local whole=$(( 10#${BASH_REMATCH[1]} )) frac=${BASH_REMATCH[3]}
  (( whole < 9998 )) && return 0
  (( whole == 9998 )) && [[ $frac =~ ^0*$ ]]
}

# Seed time: minutes, -2 (default), -1 (none), or 0-525600.
valid_seed_minutes() {
  local input=${1:-} LC_ALL=C
  [[ $input == -2 || $input == -1 ]] && return 0
  [[ $input =~ ^(0|[1-9][[:digit:]]{0,5})$ ]] || return 1
  (( 10#$input <= 525600 ))
}

ensure_state_dir() {
  local dir=$1
  [[ -n $dir ]] || return 0
  # A pre-planted symlink would redirect our write; refuse to follow it.
  if [[ -L $dir ]]; then
    die "refusing symlinked state dir: $dir"
  fi
  if [[ ! -d $dir ]]; then
    (umask 077; mkdir -p "$dir") || die "cannot create state dir: $dir"
  fi
  local owner
  owner=$(stat -c '%u' "$dir" 2>/dev/null || printf '')
  if [[ -n $owner && $owner != "$(id -u)" ]]; then
    die "state dir not owned by current user: $dir"
  fi
}

# Only a plain 1-5 digit port in 1-65535 is ever spliced into the base; a
# conf line like "WebUI\Port=80@example.invalid" would otherwise turn the
# port into userinfo and send every request to a foreign host.
read_port() {
  local port=""
  if [[ -f $CONF ]]; then
    port=$(grep -E '^WebUI\\Port=' "$CONF" | tail -n1 | cut -d= -f2 || true)
    port=${port%$'\r'}
  fi
  [[ -n $port ]] || port=8080
  local LC_ALL=C
  [[ $port =~ ^[[:digit:]]{1,5}$ ]] && (( 10#$port >= 1 && 10#$port <= 65535 )) \
    || die "invalid WebUI\\Port in qBittorrent.conf"
  printf '%s' "$(( 10#$port ))"
}

base_url() {
  if [[ -n ${QBT_BASE:-} ]]; then
    printf '%s' "$QBT_BASE"
    return
  fi
  printf 'http://127.0.0.1:%s' "$(read_port)"
}

# The [Preferences] value of a qBittorrent.conf key ("" when absent). The key
# reaches awk through the environment: -v would read "WebUI\APIKey"'s
# backslash as an escape.
conf_pref() {
  [[ -f $CONF ]] || return 0
  local val
  # QSettings trims blanks around the key and the value, so a hand-edited
  # "WebUI\LocalHostAuth = 0" counts too.
  val=$(PREF_KEY=$1 awk '
    /^[ \t]*\[/ { sect = ($0 ~ /^[ \t]*\[Preferences\][ \t\r]*$/); next }
    sect {
      line = $0; sub(/^[ \t]+/, "", line)
      if (index(line, ENVIRON["PREF_KEY"]) != 1) next
      rest = substr(line, length(ENVIRON["PREF_KEY"]) + 1)
      if (rest !~ /^[ \t]*=/) next
      sub(/^[ \t]*=[ \t]*/, "", rest); sub(/[ \t\r]+$/, "", rest)
      val = rest
    }
    END { printf "%s", val }' "$CONF" 2>/dev/null || true)
  printf '%s' "${val%$'\r'}"
}

# qBittorrent 5.2.3's Web API key (WebUI\APIKey), when the conf holds a valid
# one. OmaqBT signs every request with it: the localhost login bypass is off
# (marketplace review, 2026-10-02), since loopback is shared by every local
# account.
api_key() {
  local key LC_ALL=C
  key=$(conf_pref 'WebUI\APIKey')
  [[ $key =~ $API_KEY_PATTERN ]] && printf '%s' "$key"
  return 0
}

# A fresh key in qBittorrent's own format and alphabet (no 0, 1, I, O, l, o),
# from the OS CSPRNG. It comes back on stdout, never through an argv.
generate_api_key() {
  local key LC_ALL=C
  key=$(python3 -c 'import secrets
alphabet = "23456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz"
print("qbt_" + "".join(secrets.choice(alphabet) for _ in range(28)), end="")') || true
  [[ $key =~ $API_KEY_PATTERN ]] || die "cannot generate an API key"
  printf '%s' "$key"
}

# qBittorrent rewrites its conf at 0644 on exit, key and all, so every probe
# and every signed request puts a key-holding conf back to owner-only. Only
# this user's own regular file; any failure is left to the next run.
secure_conf_mode() {
  [[ -f $CONF && ! -L $CONF && -O $CONF && -n $(api_key) ]] || return 0
  [[ $(stat -c '%a' "$CONF" 2>/dev/null) == 600 ]] || chmod 600 "$CONF" 2>/dev/null || true
}

# Sets AUTH_ARGS to curl's arguments for the API key: a header file, never the
# key itself, so it stays off every process's argv (/proc/*/cmdline is world
# readable). The file lives in the owner-only state dir and is replaced
# atomically. A process substitution can't stand in for it: its fd is closed
# by the time curl runs. With no valid key nothing is sent, and qBittorrent
# answers 403.
AUTH_ARGS=()
prepare_auth() {
  AUTH_ARGS=()
  local dir file key line tmp
  dir=$(dirname "$COOKIE_FILE")
  ensure_state_dir "$dir"
  file="$dir/auth-header"
  key=$(api_key)
  if [[ -z $key ]]; then
    rm -f "$file"
    return 0
  fi
  secure_conf_mode
  line="Authorization: Bearer $key"
  if [[ -L $file || ! -f $file || $(<"$file") != "$line" ]]; then
    tmp=$(umask 077; mktemp "$dir/.auth-header.XXXXXX") || die "cannot write the API key header"
    printf '%s\n' "$line" >"$tmp"
    mv -f "$tmp" "$file"
  fi
  AUTH_ARGS=(-H "@$file")
}

# "bypass" while the conf still skips the login for localhost (OmaqBT's old
# setup, fixed by `qbt secure-daemon`), "nokey" without a valid API key, else
# "ok". qBittorrent's defaults: LocalHostAuth on, the subnet whitelist off.
# A conf value read the way QVariant::toBool reads a string: "", "0" and
# "false" (any case) are false, anything else is true.
conf_bool() {
  local v=${1,,}
  v=${v#\"}; v=${v%\"}
  [[ -n $v && $v != 0 && $v != false ]]
}

auth_state() {
  local lha wle
  lha=$(conf_pref 'WebUI\LocalHostAuth')
  wle=$(conf_pref 'WebUI\AuthSubnetWhitelistEnabled')
  if { [[ -n $lha ]] && ! conf_bool "$lha"; } || conf_bool "$wle"; then
    printf 'bypass'
  elif [[ -z $(api_key) ]]; then
    printf 'nokey'
  else
    printf 'ok'
  fi
}

# The whole base must be http://127.0.0.1:<port>, optionally followed by a
# path. Matching the full prefix (not a sed-extracted "host") is what stops
# userinfo ("http://127.0.0.1:80@127.0.0.2:1"), a backslash
# ("http://127.0.0.1:1\@x") or another scheme ("gopher://127.0.0.1:1").
# The base is never echoed: a refused one may carry something private.
assert_local_base() {
  local base LC_ALL=C
  base=$(base_url)
  [[ $base =~ ^http://127\.0\.0\.1:[[:digit:]]{1,5}(/|$) ]] \
    || die "refusing non-localhost host (base must be http://127.0.0.1:<port>)"
}

# Only this user's processes: another account's qBittorrent holds its own
# profile, not ours.
lock_holder() {
  if [[ -n ${QBT_LOCK:-} ]]; then
    printf '%s' "$QBT_LOCK"
    return
  fi
  if pgrep -u "$(id -u)" -x qbittorrent >/dev/null 2>&1; then
    printf 'gui'
  elif pgrep -u "$(id -u)" -x qbittorrent-nox >/dev/null 2>&1; then
    printf 'nox'
  else
    printf 'none'
  fi
}

vpn_iface() {
  if [[ -n ${QBT_BIND_IFACE:-} ]]; then
    printf '%s' "$QBT_BIND_IFACE"
    return
  fi
  if [[ -d ${QBT_NET_DIR:-/sys/class/net}/wg0-mullvad ]]; then
    printf 'wg0-mullvad'
  fi
}

is_installed() {
  if [[ -n ${QBT_INSTALLED:-} ]]; then
    [[ $QBT_INSTALLED == 1 ]]
    return
  fi
  command -v qbittorrent-nox >/dev/null 2>&1
}

is_daemon() {
  if [[ -n ${QBT_DAEMON:-} ]]; then
    [[ $QBT_DAEMON == 1 ]]
    return
  fi
  pgrep -u "$(id -u)" -x qbittorrent-nox >/dev/null 2>&1
}

api_exec() {
  local out code resp
  # Ruling EG: the body stays in memory, never in a file (for preferences
  # it holds every stored secret, and a kill mid-curl would leave a file
  # behind). curl appends "\n<status>" and the last line is split off; no
  # output at all, or a last line that isn't three digits, counts as 000,
  # never as a body.
  out=$(curl -w '\n%{http_code}' "$@" || true)
  if [[ $out == *$'\n'* ]]; then
    code=${out##*$'\n'}
    resp=${out%$'\n'*}
  else
    code=$out
    resp=""
  fi
  [[ $code =~ ^[[:digit:]]{3}$ ]] || code=000
  # As the old $(cat "$tmp") did: trailing newlines go.
  while [[ $resp == *$'\n' ]]; do resp=${resp%$'\n'}; done
  if [[ $code == 403 ]]; then
    die "$API_KEY_REFUSED"
  fi
  # B1: torrents/add answers 202 (APIStatus::Async) when a source is a URL
  # qBittorrent must download first (an https .torrent). Only the add call
  # sites opt in, with `local api_accept_202=1` (dynamically scoped, like
  # api_error_detail below), so no other endpoint takes a 202 as success.
  if [[ $code == 202 && ${api_accept_202:-0} == 1 ]]; then
    code=200
  fi
  if [[ $code != 200 && $code != 204 ]]; then
    # F12: a command that sets `local api_error_detail=code` (the slice-2b
    # tracker/peer/fetch-metadata commands) reports the status only. The
    # body can carry a tracker URL or passkey, and sanitize only scrubs
    # SID/password. Locals are dynamically scoped, so this reaches here
    # through api()'s subshell and any $(...) around it.
    if [[ ${api_error_detail:-full} == code ]]; then
      [[ $code =~ ^[[:digit:]]{3}$ && $code != 000 ]] || die "Couldn't reach qBittorrent."
      die "qBittorrent refused it (HTTP $code)"
    fi
    die "HTTP $code $(printf '%s' "$resp" | sanitize)"
  fi
  printf '%s' "$resp"
}

api() {
  assert_local_base
  local method=$1 path=$2
  local body=${3:-}
  local url
  url="$(base_url)$path"
  ensure_state_dir "$(dirname "$COOKIE_FILE")"
  prepare_auth
  local args=(-sS -g --noproxy '*' --max-time 5 -X "$method" -b "$COOKIE_FILE" -c "$COOKIE_FILE" "${AUTH_ARGS[@]}" "$url")
  if [[ -z $body ]]; then
    (umask 077; api_exec "${args[@]}")
    return
  fi
  # The body goes on curl's stdin, never its argv: it may hold a tracker
  # URL, magnet or download link with a passkey in it.
  args+=(-H "Content-Type: application/x-www-form-urlencoded" --data-binary @-)
  (umask 077; printf '%s' "$body" | api_exec "${args[@]}")
}

api_form() {
  assert_local_base
  local method=$1 path=$2
  shift 2
  prepare_auth
  api_exec -sS -g --noproxy '*' --max-time 30 -X "$method" "${AUTH_ARGS[@]}" "$(base_url)$path" "$@"
}

cmd_probe() {
  assert_local_base
  secure_conf_mode
  ensure_state_dir "$(dirname "$RID_FILE")"
  ensure_state_dir "$(dirname "$COOKIE_FILE")"
  local installed=false daemon=false
  if is_installed; then installed=true; fi
  if is_daemon; then daemon=true; fi
  local lock vpn_if pcre=false
  lock=$(lock_holder)
  vpn_if=$(vpn_iface)
  # Slice 5b2: rule regexes are checked by pcre2grep (lib/rssautorules.py).
  if command -v pcre2grep >/dev/null 2>&1; then pcre=true; fi
  jq -n \
    --argjson installed "$installed" \
    --argjson daemon "$daemon" \
    --argjson pcre2grep "$pcre" \
    --arg lock "$lock" \
    --arg vpnIface "$vpn_if" \
    --arg base "$(base_url)" \
    --arg stateDir "$(dirname "$RID_FILE")" \
    --arg ridFile "$RID_FILE" \
    --arg cookieFile "$COOKIE_FILE" \
    --arg conf "$CONF" \
    --arg auth "$(auth_state)" \
    '{installed:$installed, daemon:$daemon, lockHolder:$lock, vpnIface:$vpnIface, base:$base, stateDir:$stateDir, ridFile:$ridFile, cookieFile:$cookieFile, conf:$conf, auth:$auth, pcre2grep:$pcre2grep}'
}

# The lib/ directory next to this script (the python modules).
qbt_lib_dir() {
  local exec_path
  exec_path=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
  [[ $exec_path == /* ]] || exec_path="$PWD/$0"
  printf '%s/lib' "$(dirname "$exec_path")"
}

cmd_status() {
  local lib_dir
  lib_dir=$(qbt_lib_dir)
  cmd_probe | python3 "$lib_dir/qbtsync.py" status
}

cmd_add() {
  local stopped=false savepath="" category="" target="" from_stdin=false
  while [[ $# -gt 0 ]]; do
    case $1 in
      --stopped) stopped=true; shift ;;
      --stdin) from_stdin=true; shift ;;
      --savepath) [[ $# -ge 2 ]] || die "--savepath needs a value"; savepath=$2; shift 2 ;;
      --category) [[ $# -ge 2 ]] || die "--category needs a value"; category=$2; shift 2 ;;
      *) target=$1; shift ;;
    esac
  done
  local add_usage="usage: qbt add [--stopped] [--savepath <dir>] [--category <name>] <magnet, .torrent URL, or .torrent file> | --stdin"
  if [[ $from_stdin == true ]]; then
    [[ -z $target ]] || die "$add_usage"
    stdin_fields 1 "$add_usage"
    target=${STDIN_FIELDS[0]}
  fi
  [[ -n $target ]] || die "$add_usage"
  local path=$target
  [[ $path == file://* ]] && path=${path#file://}
  [[ $path == "~/"* ]] && path=$HOME/${path#\~/}
  if [[ $path == /* ]]; then
    [[ -f $path ]] || die "no such torrent file: $path"
    local args=(-F "torrents=@${path}")
    # qBittorrent 5 reads "stopped"; older builds read "paused". Send both.
    [[ $stopped == true ]] && args+=(-F "stopped=true" -F "paused=true")
    [[ -n $savepath ]] && args+=(-F "savepath=${savepath}")
    [[ -n $category ]] && args+=(-F "category=${category}")
    api_form POST "/api/v2/torrents/add" "${args[@]}" >/dev/null
  else
    local body api_accept_202=1
    body="urls=$(uri_encode "$target")"
    [[ $stopped == true ]] && body+="&stopped=true&paused=true"
    [[ -n $savepath ]] && body+="&savepath=$(uri_encode "$savepath")"
    [[ -n $category ]] && body+="&category=$(uri_encode "$category")"
    api POST "/api/v2/torrents/add" "$body" >/dev/null
  fi
  printf '%s\n' '{"ok":true}'
}

cmd_start() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt start <hash|all>"
  valid_hashes "$hash" || die "invalid hash list"
  api POST "/api/v2/torrents/start" "hashes=${hash}" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_stop() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt stop <hash|all>"
  valid_hashes "$hash" || die "invalid hash list"
  api POST "/api/v2/torrents/stop" "hashes=${hash}" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_recheck() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt recheck <hash>"
  valid_hashes "$hash" || die "invalid hash list"
  api POST "/api/v2/torrents/recheck" "hashes=${hash}" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_set_location() {
  local hash=${1:-} location=${2:-}
  [[ -n $hash && -n $location ]] || die "usage: qbt set-location <hash> <dir>"
  valid_hashes "$hash" || die "invalid hash list"
  [[ $location == "~/"* ]] && location=$HOME/${location#\~/}
  [[ $location == /* ]] || die "location must be an absolute path"
