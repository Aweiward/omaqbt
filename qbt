#!/usr/bin/env bash
set -euo pipefail

HOME_DIR="${QBT_HOME:-$HOME}"
CONF="${QBT_CONF:-$HOME_DIR/.config/qBittorrent/qBittorrent.conf}"
# Prefer the private per-user runtime dir (/run/user/UID, mode 0700). Only when
# it is missing fall back to a uid-scoped /tmp path, never the shared /tmp/omaqbt
# that any local user could pre-create as a symlink.
if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
  STATE_DIR="${QBT_STATE_DIR:-$XDG_RUNTIME_DIR/omaqbt}"
else
  STATE_DIR="${QBT_STATE_DIR:-/tmp/omaqbt-$(id -u)}"
fi
RID_FILE="${QBT_RID_FILE:-$STATE_DIR/rid.json}"
# qBittorrent keeps sync/maindata rid state per WebUI session. Without a
# persisted SID every poll opens a new session and gets a full update.
COOKIE_FILE="${QBT_COOKIE_FILE:-$(dirname "$RID_FILE")/cookies}"
UNIT_DIR="$HOME_DIR/.config/systemd/user"
UNIT_FILE="$UNIT_DIR/omaqbt-nox.service"

sanitize() {
  sed -E 's/SID=[^;[:space:]]*/SID=<redacted>/gi; s/password=[^;[:space:]]*/password=<redacted>/gi'
}

die() {
  printf '%s\n' "$*" | sanitize >&2
  exit 1
}

# Accepts "all", or one or more torrent hashes joined by "|" (each a 40-char
# v1 or 64-char v2 infohash). Anything else -- extra params, shell
# metacharacters, empty segments -- is rejected before it ever reaches a
# form body or query string.
valid_hashes() {
  local input=${1:-}
  local hash_re='[0-9a-fA-F]{40}|[0-9a-fA-F]{64}'
  local re="^(${hash_re})(\|(${hash_re}))*\$"
  [[ $input == all || $input =~ $re ]]
}

valid_single_hash() {
  local input=${1:-}
  [[ $input =~ ^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$ ]]
}

# F5: udp://, http://, https:// or wss://, at most 2048 characters, no
# whitespace, no "|". "&" and "=" are legal (tracker URLs carry passkeys as
# query-string params) -- the value is always @uri-encoded before it goes
# into a form body, so it can never be split into extra fields.
valid_tracker_url() {
  local input=${1:-}
  [[ -n $input ]] || return 1
  [[ ${#input} -le 2048 ]] || return 1
  [[ $input =~ ^(udp|https?|wss):// ]] || return 1
  [[ $input != *[[:space:]]* ]] || return 1
  [[ $input != *'|'* ]] || return 1
  return 0
}

valid_port() {
  local port=${1:-}
  # A leading zero (e.g. "089") would make bash read the number as octal
  # and abort on the invalid digit; force base 10.
  [[ $port =~ ^[0-9]+$ ]] || return 1
  (( 10#$port >= 1 && 10#$port <= 65535 ))
}

valid_ipv4() {
  local ip=${1:-}
  [[ $ip =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  local o
  for o in "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"; do
    (( 10#$o <= 255 )) || return 1
  done
  return 0
}

# A ban target is exactly one IPv4:port or [IPv6]:port (port 1-65535).
valid_peer() {
  local input=${1:-}
  [[ -n $input ]] || return 1
  if [[ $input == \[*\]:* ]]; then
    [[ $input =~ ^\[([0-9a-fA-F:]+)\]:([0-9]+)$ ]] || return 1
    valid_port "${BASH_REMATCH[2]}"
    return $?
  fi
  local ip=${input%:*}
  local port=${input##*:}
  [[ $input == "$ip:$port" ]] || return 1
  valid_ipv4 "$ip" || return 1
  valid_port "$port"
}

ensure_state_dir() {
  local dir=$1
  [[ -n $dir ]] || return 0
  # A pre-planted symlink would redirect our write; refuse to follow it.
  if [[ -L $dir ]]; then
    die "refusing symlinked state dir: $dir"
  fi
  if [[ ! -d $dir ]]; then
    (umask 077; mkdir -p "$dir") || die "cannot create state dir: $dir"
  fi
  local owner
  owner=$(stat -c '%u' "$dir" 2>/dev/null || printf '')
  if [[ -n $owner && $owner != "$(id -u)" ]]; then
    die "state dir not owned by current user: $dir"
  fi
}

read_port() {
  local port=""
  if [[ -f $CONF ]]; then
    port=$(grep -E '^WebUI\\Port=' "$CONF" | tail -n1 | cut -d= -f2 || true)
  fi
  if [[ -z ${port:-} ]]; then
    port=8080
  fi
  printf '%s' "$port"
}

base_url() {
  if [[ -n ${QBT_BASE:-} ]]; then
    printf '%s' "$QBT_BASE"
    return
  fi
  printf 'http://127.0.0.1:%s' "$(read_port)"
}

assert_local_base() {
  local base host
  base=$(base_url)
  host=$(printf '%s' "$base" | sed -E 's#^[a-z]+://([^/:]+).*#\1#')
  [[ $host == 127.0.0.1 ]] || die "refusing non-localhost host: $host"
}

lock_holder() {
  if [[ -n ${QBT_LOCK:-} ]]; then
    printf '%s' "$QBT_LOCK"
    return
  fi
  if pgrep -x qbittorrent >/dev/null 2>&1; then
    printf 'gui'
  elif pgrep -x qbittorrent-nox >/dev/null 2>&1; then
    printf 'nox'
  else
    printf 'none'
  fi
}

vpn_iface() {
  if [[ -n ${QBT_BIND_IFACE:-} ]]; then
    printf '%s' "$QBT_BIND_IFACE"
    return
  fi
  if [[ -d ${QBT_NET_DIR:-/sys/class/net}/wg0-mullvad ]]; then
    printf 'wg0-mullvad'
  fi
}

is_installed() {
  if [[ -n ${QBT_INSTALLED:-} ]]; then
    [[ $QBT_INSTALLED == 1 ]]
    return
  fi
  command -v qbittorrent-nox >/dev/null 2>&1
}

is_daemon() {
  if [[ -n ${QBT_DAEMON:-} ]]; then
    [[ $QBT_DAEMON == 1 ]]
    return
  fi
  pgrep -x qbittorrent-nox >/dev/null 2>&1
}

api_exec() {
  local tmp code
  tmp=$(mktemp)
  code=$(curl -o "$tmp" -w '%{http_code}' "$@" || true)
  local resp
  resp=$(cat "$tmp")
  rm -f "$tmp"
  if [[ $code == 403 ]]; then
    die "localhost auth is required"
  fi
  if [[ $code != 200 && $code != 204 ]]; then
    die "HTTP $code $(printf '%s' "$resp" | sanitize)"
  fi
  printf '%s' "$resp"
}

api() {
  assert_local_base
  local method=$1 path=$2
  local body=${3:-}
  local url
  url="$(base_url)$path"
  ensure_state_dir "$(dirname "$COOKIE_FILE")"
  local args=(-sS -g --noproxy '*' --max-time 5 -X "$method" -b "$COOKIE_FILE" -c "$COOKIE_FILE" "$url")
  if [[ -n $body ]]; then
    args+=(-H "Content-Type: application/x-www-form-urlencoded" --data "$body")
  fi
  (umask 077; api_exec "${args[@]}")
}

api_form() {
  assert_local_base
  local method=$1 path=$2
  shift 2
  api_exec -sS -g --noproxy '*' --max-time 30 -X "$method" "$(base_url)$path" "$@"
}

cmd_probe() {
  assert_local_base
  ensure_state_dir "$(dirname "$RID_FILE")"
  ensure_state_dir "$(dirname "$COOKIE_FILE")"
  local installed=false daemon=false
  if is_installed; then installed=true; fi
  if is_daemon; then daemon=true; fi
  local lock vpn_if
  lock=$(lock_holder)
  vpn_if=$(vpn_iface)
  jq -n \
    --argjson installed "$installed" \
    --argjson daemon "$daemon" \
    --arg lock "$lock" \
    --arg vpnIface "$vpn_if" \
    --arg base "$(base_url)" \
    --arg stateDir "$(dirname "$RID_FILE")" \
    --arg ridFile "$RID_FILE" \
    --arg cookieFile "$COOKIE_FILE" \
    '{installed:$installed, daemon:$daemon, lockHolder:$lock, vpnIface:$vpnIface, base:$base, stateDir:$stateDir, ridFile:$ridFile, cookieFile:$cookieFile}'
}

cmd_status() {
  local exec_path
  exec_path=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
  [[ $exec_path == /* ]] || exec_path="$PWD/$0"
  local lib_dir
  lib_dir="$(dirname "$exec_path")/lib"
  cmd_probe | python3 "$lib_dir/qbtsync.py" status
}

cmd_add() {
  local stopped=false savepath="" category="" target=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      --stopped) stopped=true; shift ;;
      --savepath) [[ $# -ge 2 ]] || die "--savepath needs a value"; savepath=$2; shift 2 ;;
      --category) [[ $# -ge 2 ]] || die "--category needs a value"; category=$2; shift 2 ;;
      *) target=$1; shift ;;
    esac
  done
  [[ -n $target ]] || die "usage: qbt add [--stopped] [--savepath <dir>] [--category <name>] <magnet, .torrent URL, or .torrent file>"
  local path=$target
  [[ $path == file://* ]] && path=${path#file://}
  [[ $path == "~/"* ]] && path=$HOME/${path#\~/}
  if [[ $path == /* ]]; then
    [[ -f $path ]] || die "no such torrent file: $path"
    local args=(-F "torrents=@${path}")
    # qBittorrent 5 reads "stopped"; older builds read "paused". Send both.
    [[ $stopped == true ]] && args+=(-F "stopped=true" -F "paused=true")
    [[ -n $savepath ]] && args+=(-F "savepath=${savepath}")
    [[ -n $category ]] && args+=(-F "category=${category}")
    api_form POST "/api/v2/torrents/add" "${args[@]}" >/dev/null
  else
    local body
    body="urls=$(jq -nr --arg u "$target" '$u|@uri')"
    [[ $stopped == true ]] && body+="&stopped=true&paused=true"
    [[ -n $savepath ]] && body+="&savepath=$(jq -nr --arg v "$savepath" '$v|@uri')"
    [[ -n $category ]] && body+="&category=$(jq -nr --arg v "$category" '$v|@uri')"
    api POST "/api/v2/torrents/add" "$body" >/dev/null
  fi
  printf '%s\n' '{"ok":true}'
}

cmd_start() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt start <hash|all>"
  valid_hashes "$hash" || die "invalid hash list"
  api POST "/api/v2/torrents/start" "hashes=${hash}" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_stop() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt stop <hash|all>"
  valid_hashes "$hash" || die "invalid hash list"
  api POST "/api/v2/torrents/stop" "hashes=${hash}" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_recheck() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt recheck <hash>"
  valid_hashes "$hash" || die "invalid hash list"
  api POST "/api/v2/torrents/recheck" "hashes=${hash}" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_set_location() {
  local hash=${1:-} location=${2:-}
  [[ -n $hash && -n $location ]] || die "usage: qbt set-location <hash> <dir>"
  valid_hashes "$hash" || die "invalid hash list"
  [[ $location == "~/"* ]] && location=$HOME/${location#\~/}
  [[ $location == /* ]] || die "location must be an absolute path"
  api POST "/api/v2/torrents/setLocation" "hashes=${hash}&location=$(jq -nr --arg v "$location" '$v|@uri')" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_delete() {
  local hash=${1:-}
  local files=false
  shift || true
  if [[ ${1:-} == --files ]]; then files=true; fi
  [[ -n $hash ]] || die "usage: qbt delete <hash> [--files]"
  valid_hashes "$hash" || die "invalid hash list"
  api POST "/api/v2/torrents/delete" "hashes=${hash}&deleteFiles=${files}" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_reannounce() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt reannounce <hash>"
  valid_single_hash "$hash" || die "invalid hash"
  api POST "/api/v2/torrents/reannounce" "hashes=${hash}" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_tracker_add() {
  local hash=${1:-} url=${2:-}
  [[ -n $hash && -n $url ]] || die "usage: qbt tracker-add <hash> <url>"
  valid_single_hash "$hash" || die "invalid hash"
  valid_tracker_url "$url" || die "invalid tracker url"
  api POST "/api/v2/torrents/addTrackers" "hash=${hash}&urls=$(jq -nr --arg v "$url" '$v|@uri')" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_tracker_edit() {
  local hash=${1:-} old=${2:-} new=${3:-}
  [[ -n $hash && -n $old && -n $new ]] || die "usage: qbt tracker-edit <hash> <old-url> <new-url>"
  valid_single_hash "$hash" || die "invalid hash"
  # F13: qBittorrent's WebUI joins a torrent's trackers with "|"; a tracker
  # whose own URL contains "|" can't be addressed unambiguously through
  # editTracker/removeTrackers.
  [[ $old != *'|'* ]] || die "This tracker's URL can't be edited through the WebUI API"
  valid_tracker_url "$old" || die "invalid tracker url"
  valid_tracker_url "$new" || die "invalid tracker url"
  api POST "/api/v2/torrents/editTracker" "hash=${hash}&origUrl=$(jq -nr --arg v "$old" '$v|@uri')&newUrl=$(jq -nr --arg v "$new" '$v|@uri')" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_tracker_remove() {
  local hash=${1:-} url=${2:-}
  [[ -n $hash && -n $url ]] || die "usage: qbt tracker-remove <hash> <url>"
  valid_single_hash "$hash" || die "invalid hash"
  [[ $url != *'|'* ]] || die "This tracker's URL can't be edited through the WebUI API"
  valid_tracker_url "$url" || die "invalid tracker url"
  api POST "/api/v2/torrents/removeTrackers" "hash=${hash}&urls=$(jq -nr --arg v "$url" '$v|@uri')" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_ban_peer() {
  local peer=${1:-}
  [[ -n $peer ]] || die "usage: qbt ban-peer <ip:port>"
  valid_peer "$peer" || die "invalid peer"
  api POST "/api/v2/transfer/banPeers" "peers=$(jq -nr --arg v "$peer" '$v|@uri')" >/dev/null
  printf '%s\n' '{"ok":true}'
}

# Number of hash-count polls that fit in $2 seconds at a 0.2s interval, used
# by fetch-metadata below to wait for a delete to take effect and for a
# re-add to reappear. Production default is 5s; QBT_FETCH_METADATA_TIMEOUT
# lets tests shrink it so a deliberately-failing poll doesn't stall the
# suite.
fetch_metadata_hash_count() {
  local hash=$1
  api GET "/api/v2/torrents/info?hashes=${hash}" 2>/dev/null | jq --arg h "$hash" '[.[] | select((.hash // "" | ascii_downcase) == ($h | ascii_downcase))] | length'
}

fetch_metadata_wait_gone() {
  local hash=$1 timeout=$2 interval=0.2
  local iters=$(( timeout * 5 ))
  (( iters >= 1 )) || iters=1
  local i n
  for (( i = 0; i < iters; i++ )); do
    # A failed GET (dropped connection, timeout) must not read as "gone" --
    # the pipeline would print nothing, and `[[ "" -eq 0 ]]` is true in
    # bash, so check the assignment succeeded before trusting the count.
    n=$(fetch_metadata_hash_count "$hash") && [[ $n == 0 ]] && return 0
    sleep "$interval"
  done
  n=$(fetch_metadata_hash_count "$hash") && [[ $n == 0 ]]
}

fetch_metadata_wait_present() {
  local hash=$1 timeout=$2 interval=0.2
  local iters=$(( timeout * 5 ))
  (( iters >= 1 )) || iters=1
  local i n
  for (( i = 0; i < iters; i++ )); do
    n=$(fetch_metadata_hash_count "$hash") && [[ $n -ge 1 ]] && return 0
    sleep "$interval"
  done
  n=$(fetch_metadata_hash_count "$hash") && [[ $n -ge 1 ]]
}

# F4, Deviation 1. Swaps a metadata-less torrent for a fresh magnet add so
# qBittorrent goes looking for metadata again. Every refusal below happens
# before the delete; nothing is destroyed unless we already hold the magnet,
# save path, category and tags needed to put it back.
cmd_fetch_metadata() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt fetch-metadata <hash>"
  valid_single_hash "$hash" || die "invalid hash"

  local info row count
  info=$(api GET "/api/v2/torrents/info?hashes=${hash}")
  row=$(jq -c --arg h "$hash" '[.[] | select((.hash // "" | ascii_downcase) == ($h | ascii_downcase))]' <<<"$info")
  count=$(jq 'length' <<<"$row")
  [[ $count -eq 1 ]] || die "torrent not found"

  local total_size state magnet savepath category tags
  total_size=$(jq -r '.[0].total_size // -1' <<<"$row")
  state=$(jq -r '.[0].state // empty' <<<"$row")
  magnet=$(jq -r '.[0].magnet_uri // empty' <<<"$row")
  savepath=$(jq -r '.[0].save_path // empty' <<<"$row")
  category=$(jq -r '.[0].category // empty' <<<"$row")
  tags=$(jq -r '.[0].tags // empty' <<<"$row")

  if [[ $total_size =~ ^-?[0-9]+$ ]] && (( total_size > 0 )); then
    die "It already has metadata."
  fi
  [[ $state == stoppedDL || $state == pausedDL ]] || die "Stop it first."
  [[ -n $magnet ]] || die "No magnet link for this torrent."

  api POST "/api/v2/torrents/delete" "hashes=${hash}&deleteFiles=false" >/dev/null

  local timeout=${QBT_FETCH_METADATA_TIMEOUT:-5}
  fetch_metadata_wait_gone "$hash" "$timeout" || die "qBittorrent didn't remove it in time"

  local add_body
  add_body="urls=$(jq -nr --arg v "$magnet" '$v|@uri')"
  add_body+="&savepath=$(jq -nr --arg v "$savepath" '$v|@uri')"
  add_body+="&category=$(jq -nr --arg v "$category" '$v|@uri')"
  add_body+="&tags=$(jq -nr --arg v "$tags" '$v|@uri')"
  add_body+="&stopCondition=MetadataReceived&stopped=false&paused=false"

  local add_ok=true add_resp
  if ! add_resp=$(api POST "/api/v2/torrents/add" "$add_body" 2>&1); then
    add_ok=false
  elif [[ $add_resp != "Ok." ]]; then
    add_ok=false
  elif ! fetch_metadata_wait_present "$hash" "$timeout"; then
    add_ok=false
  fi

  if [[ $add_ok != true ]]; then
    # The torrent is already gone from qBittorrent at this point, so the
    # magnet must not be lost too. Run the inbox in a subshell: its own
    # `die` (e.g. inbox full) only ends that subshell, and its stdout
    # ({"ok":true}) must not leak onto ours.
    if (cmd_magnet_inbox "$magnet") >/dev/null 2>&1; then
      die "Couldn't re-add it; the magnet is back in your inbox."
    else
      die "Couldn't re-add it and couldn't save it either; the magnet is: $magnet"
    fi
  fi

  printf '%s\n' '{"ok":true}'
}

cmd_turtle() {
  api POST "/api/v2/transfer/toggleSpeedLimitsMode" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_limit() {
  local hash=${1:-} kind=${2:-} bytes=${3:-}
  [[ -n $hash && -n $bytes && ( $kind == dl || $kind == up ) ]] || die "usage: qbt limit <hash|all> <dl|up> <bytes-per-sec, 0 = unlimited>"
  valid_hashes "$hash" || die "invalid hash list"
  local endpoint=setDownloadLimit
  [[ $kind == up ]] && endpoint=setUploadLimit
  api POST "/api/v2/torrents/${endpoint}" "hashes=${hash}&limit=${bytes}" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_sequential() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt sequential <hash>"
  valid_hashes "$hash" || die "invalid hash list"
  api POST "/api/v2/torrents/toggleSequentialDownload" "hashes=${hash}" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_sharelimit() {
  local hash=${1:-} ratio=${2:-}
  [[ -n $hash && -n $ratio ]] || die "usage: qbt sharelimit <hash> <ratio, -2 = global, -1 = none>"
  valid_hashes "$hash" || die "invalid hash list"
  api POST "/api/v2/torrents/setShareLimits" "hashes=${hash}&ratioLimit=${ratio}&seedingTimeLimit=-2&inactiveSeedingTimeLimit=-2" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_files() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt files <hash>"
  valid_hashes "$hash" || die "invalid hash list"
  api GET "/api/v2/torrents/files?hash=${hash}"
  printf '\n'
}

cmd_prio() {
  local hash=${1:-} index=${2:-} prio=${3:-}
  [[ -n $hash && -n $index && -n $prio ]] || die "usage: qbt prio <hash> <index> <0|1|6|7>"
  valid_hashes "$hash" || die "invalid hash list"
  api POST "/api/v2/torrents/filePrio" "hash=${hash}&id=${index}&priority=${prio}" >/dev/null
  printf '%s\n' '{"ok":true}'
