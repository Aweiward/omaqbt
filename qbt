  status) shift; cmd_status "$@" ;;
  add) shift; cmd_add "$@" ;;
  start) shift; cmd_start "$@" ;;
  stop) shift; cmd_stop "$@" ;;
  delete) shift; cmd_delete "$@" ;;
  files) shift; cmd_files "$@" ;;
  prio) shift; cmd_prio "$@" ;;
  turtle) shift; cmd_turtle "$@" ;;
  limit) shift; cmd_limit "$@" ;;
  sequential) shift; cmd_sequential "$@" ;;
  sharelimit) shift; cmd_sharelimit "$@" ;;
  install) shift; cmd_install "$@" ;;
  start-daemon) shift; cmd_start_daemon "$@" ;;
  stop-daemon) shift; cmd_stop_daemon "$@" ;;
  magnet-paths) shift; cmd_magnet_paths "$@" ;;
  magnet-snapshot) shift; cmd_magnet_snapshot "$@" ;;
  magnet-inbox) shift; cmd_magnet_inbox "$@" ;;
  magnet-inbox-drop) shift; cmd_magnet_inbox_drop "$@" ;;
  magnet-drain) shift; cmd_magnet_drain "$@" ;;
  magnet-pending-list) shift; cmd_magnet_pending_list "$@" ;;
  magnet-pending-drop) shift; cmd_magnet_pending_drop "$@" ;;
  magnet-install-handler) shift; cmd_magnet_install_handler "$@" ;;
  magnet-uninstall-handler) shift; cmd_magnet_uninstall_handler "$@" ;;
  *) die "usage: qbt status|add|start|stop|delete|files|prio|turtle|limit|sequential|sharelimit|install|start-daemon|stop-daemon|magnet-paths|magnet-inbox|magnet-drain|magnet-pending-list|magnet-pending-drop|magnet-install-handler|magnet-uninstall-handler" ;;
esac
