#!/usr/bin/env bash
set -euo pipefail

HOME_DIR="${QBT_HOME:-$HOME}"
CONF="${QBT_CONF:-$HOME_DIR/.config/qBittorrent/qBittorrent.conf}"
# Prefer the private per-user runtime dir (/run/user/UID, mode 0700). Only when
# it is missing fall back to a uid-scoped /tmp path, never the shared /tmp/omaqbt
# that any local user could pre-create as a symlink.
if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
  STATE_DIR="${QBT_STATE_DIR:-$XDG_RUNTIME_DIR/omaqbt}"
else
  STATE_DIR="${QBT_STATE_DIR:-/tmp/omaqbt-$(id -u)}"
fi
RID_FILE="${QBT_RID_FILE:-$STATE_DIR/rid.json}"
# qBittorrent keeps sync/maindata rid state per WebUI session. Without a
# persisted SID every poll opens a new session and gets a full update.
COOKIE_FILE="${QBT_COOKIE_FILE:-$(dirname "$RID_FILE")/cookies}"
UNIT_DIR="$HOME_DIR/.config/systemd/user"
UNIT_FILE="$UNIT_DIR/omaqbt-nox.service"

sanitize() {
  sed -E 's/SID=[^;[:space:]]*/SID=<redacted>/gi; s/password=[^;[:space:]]*/password=<redacted>/gi'
}

die() {
  printf '%s\n' "$*" | sanitize >&2
  exit 1
}

# Accepts "all", or one or more torrent hashes joined by "|" (each a 40-char
# v1 or 64-char v2 infohash). Anything else -- extra params, shell
# metacharacters, empty segments -- is rejected before it ever reaches a
# form body or query string.
#
# Uses the POSIX [:xdigit:] class, not a [0-9a-fA-F] range: under a UTF-8
# locale (e.g. en_US.UTF-8), bash's =~ collates character *ranges* by the
# locale's LC_COLLATE order, not raw code points, so [0-9a-fA-F] can end up
# matching non-ASCII characters (accented letters, fullwidth digits,
# superscripts) that collate between the range's endpoints. POSIX classes
# are defined against LC_CTYPE instead and stay ASCII-only.
valid_hashes() {
  local input=${1:-}
  local hash_re='[[:xdigit:]]{40}|[[:xdigit:]]{64}'
  local re="^(${hash_re})(\|(${hash_re}))*\$"
  [[ $input == all || $input =~ $re ]]
}

valid_single_hash() {
  local input=${1:-}
  [[ $input =~ ^([[:xdigit:]]{40}|[[:xdigit:]]{64})$ ]]
}

# F5: udp://, http://, https:// or wss://, at most 2048 characters,
# printable ASCII only (0x21-0x7E: no whitespace, no control or non-ASCII
# character), no "|". "&" and "=" are legal (tracker URLs carry passkeys as
# query-string params) -- the value is always @uri-encoded before it goes
# into a form body, so it can never be split into extra fields. LC_ALL=C
# (local to this function) makes ${#input} count bytes and [!-~] a byte
# range, so the checks match InspectorView.trackerUrlError exactly (Ruling
# AE; shared cases in tests/fixtures/validation-cases.json).
valid_tracker_url() {
  local input=${1:-}
  local LC_ALL=C
  [[ -n $input ]] || return 1
  [[ ${#input} -le 2048 ]] || return 1
  [[ $input =~ ^(udp|https?|wss):// ]] || return 1
  [[ $input =~ ^[!-~]+$ ]] || return 1
  [[ $input != *'|'* ]] || return 1
  return 0
}

valid_port() {
  local port=${1:-}
  # [:digit:] (not [0-9], see valid_hashes above) so a fullwidth or other
  # locale-collated digit-lookalike can't slip through here either -- and a
  # leading zero (e.g. "089") would make bash read the number as octal and
  # abort on the invalid digit, so force base 10 too.
  # At most 5 digits before any arithmetic: a longer string could wrap a
  # 64-bit integer back into range (18446744073709551617 is 1).
  [[ $port =~ ^[[:digit:]]{1,5}$ ]] || return 1
  (( 10#$port >= 1 && 10#$port <= 65535 ))
}

valid_ipv4() {
  local ip=${1:-}
  [[ $ip =~ ^([[:digit:]]{1,3})\.([[:digit:]]{1,3})\.([[:digit:]]{1,3})\.([[:digit:]]{1,3})$ ]] || return 1
  local o
  for o in "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"; do
    (( 10#$o <= 255 )) || return 1
  done
  return 0
}

# A ban target is exactly one IPv4:port or [IPv6]:port (port 1-65535).
valid_peer() {
  local input=${1:-}
  [[ -n $input ]] || return 1
  if [[ $input == \[*\]:* ]]; then
    [[ $input =~ ^\[([[:xdigit:]:]+)\]:([[:digit:]]+)$ ]] || return 1
    valid_port "${BASH_REMATCH[2]}"
    return $?
  fi
  local ip=${input%:*}
  local port=${input##*:}
  [[ $input == "$ip:$port" ]] || return 1
  valid_ipv4 "$ip" || return 1
  valid_port "$port"
}

# Slice 3b (D5): the canonical limit values on the wire. The boundaries are
# pinned in tests/fixtures/validation-cases.json ("ratios", "seedTimes"),
# which the window's parser is tested against too. Every regex caps the
# length before any 10# arithmetic, so a long digit string can't wrap a
# 64-bit integer back into range; no leading zeros.

# Ratio: -2 (default), -1 (none), or 0-9998 with at most 2 decimals.
valid_ratio() {
  local input=${1:-} LC_ALL=C
  [[ $input == -2 || $input == -1 ]] && return 0
  [[ $input =~ ^(0|[1-9][[:digit:]]{0,3})(\.([[:digit:]]{1,2}))?$ ]] || return 1
  local whole=$(( 10#${BASH_REMATCH[1]} )) frac=${BASH_REMATCH[3]}
  (( whole < 9998 )) && return 0
  (( whole == 9998 )) && [[ $frac =~ ^0*$ ]]
}

# Seed time: minutes, -2 (default), -1 (none), or 0-525600.
valid_seed_minutes() {
  local input=${1:-} LC_ALL=C
  [[ $input == -2 || $input == -1 ]] && return 0
  [[ $input =~ ^(0|[1-9][[:digit:]]{0,5})$ ]] || return 1
  (( 10#$input <= 525600 ))
}

ensure_state_dir() {
  local dir=$1
  [[ -n $dir ]] || return 0
  # A pre-planted symlink would redirect our write; refuse to follow it.
  if [[ -L $dir ]]; then
    die "refusing symlinked state dir: $dir"
  fi
  if [[ ! -d $dir ]]; then
    (umask 077; mkdir -p "$dir") || die "cannot create state dir: $dir"
  fi
  local owner
  owner=$(stat -c '%u' "$dir" 2>/dev/null || printf '')
  if [[ -n $owner && $owner != "$(id -u)" ]]; then
    die "state dir not owned by current user: $dir"
  fi
}

# Only a plain 1-5 digit port in 1-65535 is ever spliced into the base; a
# conf line like "WebUI\Port=80@example.invalid" would otherwise turn the
# port into userinfo and send every request to a foreign host.
read_port() {
  local port=""
  if [[ -f $CONF ]]; then
    port=$(grep -E '^WebUI\\Port=' "$CONF" | tail -n1 | cut -d= -f2 || true)
    port=${port%$'\r'}
  fi
  [[ -n $port ]] || port=8080
  local LC_ALL=C
  [[ $port =~ ^[[:digit:]]{1,5}$ ]] && (( 10#$port >= 1 && 10#$port <= 65535 )) \
    || die "invalid WebUI\\Port in qBittorrent.conf"
  printf '%s' "$(( 10#$port ))"
}

base_url() {
  if [[ -n ${QBT_BASE:-} ]]; then
    printf '%s' "$QBT_BASE"
    return
  fi
  printf 'http://127.0.0.1:%s' "$(read_port)"
}

# The whole base must be http://127.0.0.1:<port>, optionally followed by a
# path. Matching the full prefix (not a sed-extracted "host") is what stops
# userinfo ("http://127.0.0.1:80@127.0.0.2:1"), a backslash
# ("http://127.0.0.1:1\@x") or another scheme ("gopher://127.0.0.1:1").
# The base is never echoed: a refused one may carry something private.
assert_local_base() {
  local base LC_ALL=C
  base=$(base_url)
  [[ $base =~ ^http://127\.0\.0\.1:[[:digit:]]{1,5}(/|$) ]] \
    || die "refusing non-localhost host (base must be http://127.0.0.1:<port>)"
}

lock_holder() {
  if [[ -n ${QBT_LOCK:-} ]]; then
    printf '%s' "$QBT_LOCK"
    return
  fi
  if pgrep -x qbittorrent >/dev/null 2>&1; then
    printf 'gui'
  elif pgrep -x qbittorrent-nox >/dev/null 2>&1; then
    printf 'nox'
  else
    printf 'none'
  fi
}

vpn_iface() {
  if [[ -n ${QBT_BIND_IFACE:-} ]]; then
    printf '%s' "$QBT_BIND_IFACE"
    return
  fi
  if [[ -d ${QBT_NET_DIR:-/sys/class/net}/wg0-mullvad ]]; then
    printf 'wg0-mullvad'
  fi
}

is_installed() {
  if [[ -n ${QBT_INSTALLED:-} ]]; then
    [[ $QBT_INSTALLED == 1 ]]
    return
  fi
  command -v qbittorrent-nox >/dev/null 2>&1
}

is_daemon() {
  if [[ -n ${QBT_DAEMON:-} ]]; then
    [[ $QBT_DAEMON == 1 ]]
    return
  fi
  pgrep -x qbittorrent-nox >/dev/null 2>&1
}

api_exec() {
  local tmp code
  tmp=$(mktemp)
  code=$(curl -o "$tmp" -w '%{http_code}' "$@" || true)
  local resp
  resp=$(cat "$tmp")
  rm -f "$tmp"
  if [[ $code == 403 ]]; then
    die "localhost auth is required"
  fi
  if [[ $code != 200 && $code != 204 ]]; then
    # F12: a command that sets `local api_error_detail=code` (the slice-2b
    # tracker/peer/fetch-metadata commands) reports the status only. The
    # body can carry a tracker URL or passkey, and sanitize only scrubs
    # SID/password. Locals are dynamically scoped, so this reaches here
    # through api()'s subshell and any $(...) around it.
    if [[ ${api_error_detail:-full} == code ]]; then
      [[ $code =~ ^[[:digit:]]{3}$ && $code != 000 ]] || die "Couldn't reach qBittorrent."
      die "qBittorrent refused it (HTTP $code)"
    fi
    die "HTTP $code $(printf '%s' "$resp" | sanitize)"
  fi
  printf '%s' "$resp"
}

api() {
  assert_local_base
  local method=$1 path=$2
  local body=${3:-}
  local url
  url="$(base_url)$path"
  ensure_state_dir "$(dirname "$COOKIE_FILE")"
  local args=(-sS -g --noproxy '*' --max-time 5 -X "$method" -b "$COOKIE_FILE" -c "$COOKIE_FILE" "$url")
  if [[ -n $body ]]; then
    args+=(-H "Content-Type: application/x-www-form-urlencoded" --data "$body")
  fi
  (umask 077; api_exec "${args[@]}")
}

api_form() {
  assert_local_base
  local method=$1 path=$2
  shift 2
  api_exec -sS -g --noproxy '*' --max-time 30 -X "$method" "$(base_url)$path" "$@"
}

cmd_probe() {
  assert_local_base
  ensure_state_dir "$(dirname "$RID_FILE")"
  ensure_state_dir "$(dirname "$COOKIE_FILE")"
  local installed=false daemon=false
  if is_installed; then installed=true; fi
  if is_daemon; then daemon=true; fi
  local lock vpn_if
  lock=$(lock_holder)
  vpn_if=$(vpn_iface)
  jq -n \
    --argjson installed "$installed" \
    --argjson daemon "$daemon" \
    --arg lock "$lock" \
    --arg vpnIface "$vpn_if" \
    --arg base "$(base_url)" \
    --arg stateDir "$(dirname "$RID_FILE")" \
    --arg ridFile "$RID_FILE" \
    --arg cookieFile "$COOKIE_FILE" \
    '{installed:$installed, daemon:$daemon, lockHolder:$lock, vpnIface:$vpnIface, base:$base, stateDir:$stateDir, ridFile:$ridFile, cookieFile:$cookieFile}'
}

cmd_status() {
  local exec_path
  exec_path=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
  [[ $exec_path == /* ]] || exec_path="$PWD/$0"
  local lib_dir
  lib_dir="$(dirname "$exec_path")/lib"
  cmd_probe | python3 "$lib_dir/qbtsync.py" status
}

cmd_add() {
  local stopped=false savepath="" category="" target=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      --stopped) stopped=true; shift ;;
      --savepath) [[ $# -ge 2 ]] || die "--savepath needs a value"; savepath=$2; shift 2 ;;
      --category) [[ $# -ge 2 ]] || die "--category needs a value"; category=$2; shift 2 ;;
      *) target=$1; shift ;;
    esac
  done
  [[ -n $target ]] || die "usage: qbt add [--stopped] [--savepath <dir>] [--category <name>] <magnet, .torrent URL, or .torrent file>"
  local path=$target
  [[ $path == file://* ]] && path=${path#file://}
  [[ $path == "~/"* ]] && path=$HOME/${path#\~/}
  if [[ $path == /* ]]; then
    [[ -f $path ]] || die "no such torrent file: $path"
    local args=(-F "torrents=@${path}")
    # qBittorrent 5 reads "stopped"; older builds read "paused". Send both.
    [[ $stopped == true ]] && args+=(-F "stopped=true" -F "paused=true")
    [[ -n $savepath ]] && args+=(-F "savepath=${savepath}")
    [[ -n $category ]] && args+=(-F "category=${category}")
    api_form POST "/api/v2/torrents/add" "${args[@]}" >/dev/null
  else
    local body
    body="urls=$(jq -nr --arg u "$target" '$u|@uri')"
    [[ $stopped == true ]] && body+="&stopped=true&paused=true"
    [[ -n $savepath ]] && body+="&savepath=$(jq -nr --arg v "$savepath" '$v|@uri')"
    [[ -n $category ]] && body+="&category=$(jq -nr --arg v "$category" '$v|@uri')"
    api POST "/api/v2/torrents/add" "$body" >/dev/null
  fi
  printf '%s\n' '{"ok":true}'
}

cmd_start() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt start <hash|all>"
  valid_hashes "$hash" || die "invalid hash list"
  api POST "/api/v2/torrents/start" "hashes=${hash}" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_stop() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt stop <hash|all>"
  valid_hashes "$hash" || die "invalid hash list"
  api POST "/api/v2/torrents/stop" "hashes=${hash}" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_recheck() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt recheck <hash>"
  valid_hashes "$hash" || die "invalid hash list"
  api POST "/api/v2/torrents/recheck" "hashes=${hash}" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_set_location() {
  local hash=${1:-} location=${2:-}
  [[ -n $hash && -n $location ]] || die "usage: qbt set-location <hash> <dir>"
  valid_hashes "$hash" || die "invalid hash list"
  [[ $location == "~/"* ]] && location=$HOME/${location#\~/}
  [[ $location == /* ]] || die "location must be an absolute path"
  api POST "/api/v2/torrents/setLocation" "hashes=${hash}&location=$(jq -nr --arg v "$location" '$v|@uri')" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_delete() {
  local hash=${1:-}
  local files=false
  shift || true
  if [[ ${1:-} == --files ]]; then files=true; fi
  [[ -n $hash ]] || die "usage: qbt delete <hash> [--files]"
  valid_hashes "$hash" || die "invalid hash list"
  api POST "/api/v2/torrents/delete" "hashes=${hash}&deleteFiles=${files}" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_reannounce() {
  local hash=${1:-}
  local api_error_detail=code
  [[ -n $hash ]] || die "usage: qbt reannounce <hash>"
  valid_single_hash "$hash" || die "invalid hash"
  api POST "/api/v2/torrents/reannounce" "hashes=${hash}" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_tracker_add() {
  local hash=${1:-} url=${2:-}
  local api_error_detail=code
  [[ -n $hash && -n $url ]] || die "usage: qbt tracker-add <hash> <url>"
  valid_single_hash "$hash" || die "invalid hash"
  valid_tracker_url "$url" || die "invalid tracker url"
  api POST "/api/v2/torrents/addTrackers" "hash=${hash}&urls=$(jq -nr --arg v "$url" '$v|@uri')" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_tracker_edit() {
  local hash=${1:-} old=${2:-} new=${3:-}
  local api_error_detail=code
  [[ -n $hash && -n $old && -n $new ]] || die "usage: qbt tracker-edit <hash> <old-url> <new-url>"
  valid_single_hash "$hash" || die "invalid hash"
  # F13: qBittorrent's WebUI joins a torrent's trackers with "|"; a tracker
  # whose own URL contains "|" can't be addressed unambiguously through
  # editTracker/removeTrackers.
  [[ $old != *'|'* ]] || die "This tracker's URL can't be edited through the WebUI API"
  valid_tracker_url "$old" || die "invalid tracker url"
  valid_tracker_url "$new" || die "invalid tracker url"
  api POST "/api/v2/torrents/editTracker" "hash=${hash}&origUrl=$(jq -nr --arg v "$old" '$v|@uri')&newUrl=$(jq -nr --arg v "$new" '$v|@uri')" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_tracker_remove() {
  local hash=${1:-} url=${2:-}
  local api_error_detail=code
  [[ -n $hash && -n $url ]] || die "usage: qbt tracker-remove <hash> <url>"
  valid_single_hash "$hash" || die "invalid hash"
  [[ $url != *'|'* ]] || die "This tracker's URL can't be edited through the WebUI API"
  valid_tracker_url "$url" || die "invalid tracker url"
  api POST "/api/v2/torrents/removeTrackers" "hash=${hash}&urls=$(jq -nr --arg v "$url" '$v|@uri')" >/dev/null
  printf '%s\n' '{"ok":true}'
}

cmd_ban_peer() {
  local peer=${1:-}
  local api_error_detail=code
  [[ -n $peer ]] || die "usage: qbt ban-peer <ip:port>"
  valid_peer "$peer" || die "invalid peer"
  api POST "/api/v2/transfer/banPeers" "peers=$(jq -nr --arg v "$peer" '$v|@uri')" >/dev/null
  printf '%s\n' '{"ok":true}'
}

# Number of matching rows for $1, used by fetch-metadata below to wait for a
# delete to take effect and for a re-add to reappear.
fetch_metadata_hash_count() {
  local hash=$1
  api GET "/api/v2/torrents/info?hashes=${hash}" 2>/dev/null | jq --arg h "$hash" '[.[] | select((.hash // "" | ascii_downcase) == ($h | ascii_downcase))] | length'
}

# Polls fetch_metadata_hash_count against an overall wall-clock deadline
# (SECONDS, bash's own elapsed-time counter), not an iteration count: each
# GET can itself take up to api()'s own --max-time before failing, so an
# iteration budget (N tries * 0.2s) can't bound the real wall time -- N
# slow/failing GETs at up to 5s each would stretch a 5s budget to N*5s.
# $3 selects "gone" (0) or "present" (nonzero).
fetch_metadata_wait_for() {
  local hash=$1 timeout=$2 want=$3 interval=0.2
  # Belt and suspenders: cmd_fetch_metadata already validates timeout
  # before calling here, but this expansion is the one that would actually
  # blow up, so it re-checks rather than trusting every future caller to
  # have done it first.
  [[ $timeout =~ ^[[:digit:]]+$ ]] || timeout=5
  (( ${#timeout} <= 3 )) || timeout=600
  timeout=$(( 10#$timeout ))
  local deadline=$(( SECONDS + timeout ))
  local n
  while true; do
    # A failed GET (dropped connection, timeout, 5xx) must not read as
    # "gone" -- the pipeline prints nothing, and `[[ "" -eq 0 ]]` is true in
    # bash, so check the assignment's own exit status before trusting $n.
    if n=$(fetch_metadata_hash_count "$hash"); then
      if [[ $want == gone && $n == 0 ]]; then return 0; fi
      if [[ $want == present && $n -ge 1 ]]; then return 0; fi
    fi
    (( SECONDS < deadline )) || return 1
    sleep "$interval"
  done
}

# F12/Review Focus 5: the magnet (and any tracker passkeys inside it) must
# never be printed. Recovery always tries the inbox first -- with the
# 20-item cap bypassed, since that cap guards against a flood of browser
# clicks, not a rescue, and magnet-drain already dedupes an inbox entry
# against the library, so inboxing a torrent that (rarely) still exists in
# qBittorrent is harmless. Only if the inbox itself can't be written (e.g. a
# hardened state dir) does this fall back to a 0600 file, naming only its
# path.
fetch_metadata_rescue() {
  local hash=$1 magnet=$2
  # Disarm the swap's signal trap first, so a second signal can't start
  # a second rescue while this one runs.
  trap - TERM HUP INT
  # A subshell: cmd_magnet_inbox's own `die` (e.g. some unexpected failure)
  # must only end that subshell, never this command, and its stdout
  # ({"ok":true}) must never leak onto ours.
  if (cmd_magnet_inbox "$magnet" --force) >/dev/null 2>&1; then
    die "Couldn't finish re-adding it; the magnet is in your inbox."
  fi
  local dir fallback
  dir=$(magnet_state_dir)
  if (ensure_state_dir "$dir") >/dev/null 2>&1; then
    fallback="$dir/lost-magnet-$(date +%s)-$$.txt"
    if (umask 077; printf '%s\n' "$magnet" >"$fallback") 2>/dev/null && [[ -s $fallback ]]; then
      die "Couldn't finish re-adding it or save it to the inbox; the magnet is saved at: $fallback"
    fi
  fi
  die "Couldn't finish re-adding it, and couldn't save the magnet anywhere; check qBittorrent for hash $hash"
}

# F4, Deviation 1. Swaps a metadata-less torrent for a fresh magnet add so
# qBittorrent goes looking for metadata again. Every refusal below happens
# before the delete; nothing is destroyed unless we already hold the magnet,
# save path, category and tags needed to put it back. Past that point the
# torrent may already be gone no matter what a later step reports, so every
# failure from here on -- the delete call itself failing, the wait-for-gone
# deadline passing, a GET failing mid-poll, or any add failure -- runs the
# same rescue rather than ever claiming the torrent is still safe.
cmd_fetch_metadata() {
  local hash=${1:-}
  local api_error_detail=code
  [[ -n $hash ]] || die "usage: qbt fetch-metadata <hash>"
  valid_single_hash "$hash" || die "invalid hash"

  # Validated, capped and arithmetic-proved before anything else -- in
  # particular before the very first request -- so a bad
  # QBT_FETCH_METADATA_TIMEOUT can never reach `SECONDS + timeout` inside
  # fetch_metadata_wait_for with a raw bash arithmetic error and no rescue
  # able to run once the delete has gone out. [:digit:] not [0-9]: under a
  # UTF-8 locale a non-ASCII "digit"-lookalike (e.g. a fullwidth "１") can
  # otherwise pass a [0-9] range. Unlike the refusals below (which only
  # reject what qBittorrent's own data says), an unparseable override is a
  # broken environment, not qBittorrent's business, so it's rejected
  # outright rather than silently swapped for the default; a parseable but
  # out-of-range value is merely clamped.
  local timeout=${QBT_FETCH_METADATA_TIMEOUT:-5}
  [[ $timeout =~ ^[[:digit:]]+$ ]] || die "invalid QBT_FETCH_METADATA_TIMEOUT"
  # A digit string long enough to overflow bash's integer type would make
  # `10#$timeout` wrap to an unpredictable value rather than just being
  # "large" -- reject the length before doing that arithmetic at all, so
  # the cap below never depends on wraparound behavior. 3 digits comfortably
  # covers the 600 cap with room to spare.
  if (( ${#timeout} > 3 )); then
    timeout=600
  else
    timeout=$(( 10#$timeout ))
    if (( timeout < 1 )); then
      timeout=5
    elif (( timeout > 600 )); then
      timeout=600
    fi
  fi
  # Exercise the exact expansion fetch_metadata_wait_for will do, here,
  # while it's still safe to just die: if this ever fails for a reason the
  # checks above didn't anticipate, it fails before anything has been sent.
  local _deadline_canary
  (( _deadline_canary = SECONDS + timeout )) || die "invalid fetch-metadata timeout"

  local info row count
  info=$(api GET "/api/v2/torrents/info?hashes=${hash}")
  row=$(jq -c --arg h "$hash" '[.[] | select((.hash // "" | ascii_downcase) == ($h | ascii_downcase))]' <<<"$info")
  count=$(jq 'length' <<<"$row")
  [[ $count -eq 1 ]] || die "torrent not found"

  local total_size state magnet savepath category tags
  total_size=$(jq -r '.[0].total_size // -1' <<<"$row")
  state=$(jq -r '.[0].state // empty' <<<"$row")
  magnet=$(jq -r '.[0].magnet_uri // empty' <<<"$row")
  savepath=$(jq -r '.[0].save_path // empty' <<<"$row")
  category=$(jq -r '.[0].category // empty' <<<"$row")
  tags=$(jq -r '.[0].tags // empty' <<<"$row")
  # qBittorrent joins tags with ", "; the WebUI add endpoint wants a bare
  # comma list.
  tags=${tags//, /,}

  # Fail closed: only a clean integer that's <= 0 counts as "no metadata".
  # Anything jq couldn't read as a plain integer is treated the same as
  # "has metadata" rather than assumed safe. [:digit:] (not [0-9], see
  # valid_hashes above): under a UTF-8 locale a non-ASCII "digit"-lookalike
  # can otherwise pass a [0-9] range and reach the `((...))` below with a
  # raw bash arithmetic error on stderr before this dies cleanly.
  [[ $total_size =~ ^-?[[:digit:]]+$ ]] || die "It already has metadata."
  (( total_size <= 0 )) || die "It already has metadata."
  [[ $state == stoppedDL || $state == pausedDL ]] || die "Stop it first."
  [[ -n $magnet ]] || die "No magnet link for this torrent."

  # Not a bare `api POST ...`: that runs in this shell, so `die`'s `exit`
  # would abort the whole command before any rescue ever ran (this is the
  # exact bug: a delete that qBittorrent already applied, but whose
  # response curl never delivered -- e.g. it timed out -- would otherwise
  # kill the script here with the torrent already gone and no rescue).
  # Wrapping it in a command substitution runs it in a subshell instead, so
  # a `die` there only fails the assignment.
  # From the delete on, the torrent may be gone: a TERM/HUP/INT (the
  # window closing, a logout) must still put the magnet in the inbox.
  # "$hash"/"$magnet" expand when the trap fires, from this function's
  # locals. Cleared once the re-add is listed, or by the rescue itself.
  trap 'fetch_metadata_rescue "$hash" "$magnet"; exit 1' TERM HUP INT
  local delete_resp
  if ! delete_resp=$(api POST "/api/v2/torrents/delete" "hashes=${hash}&deleteFiles=false" 2>&1); then
    fetch_metadata_rescue "$hash" "$magnet"
  fi

  fetch_metadata_wait_for "$hash" "$timeout" gone || fetch_metadata_rescue "$hash" "$magnet"

  local add_body
  add_body="urls=$(jq -nr --arg v "$magnet" '$v|@uri')"
  add_body+="&savepath=$(jq -nr --arg v "$savepath" '$v|@uri')"
  add_body+="&category=$(jq -nr --arg v "$category" '$v|@uri')"
  add_body+="&tags=$(jq -nr --arg v "$tags" '$v|@uri')"
  add_body+="&stopCondition=MetadataReceived&stopped=false&paused=false"

  # The add's response body is not read: qBittorrent's success body for it
  # isn't a confirmed contract (every other add path ignores it too). The
  # wait-for-present poll below is the proof -- a failed add never lists
  # the hash, so it still ends in the rescue.
  if ! (api POST "/api/v2/torrents/add" "$add_body") >/dev/null 2>&1; then
    fetch_metadata_rescue "$hash" "$magnet"
  fi
  fetch_metadata_wait_for "$hash" "$timeout" present || fetch_metadata_rescue "$hash" "$magnet"
  trap - TERM HUP INT

  printf '%s\n' '{"ok":true}'
}

