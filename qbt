cmd_magnet_inbox() {
  local url=${1:-}
  # --force is deliberately left out of the usage string below: it exists
  # only so fetch_metadata_rescue (above) can bypass the 20-item cap when
  # it's saving a torrent that would otherwise be lost, not for interactive
  # use. Run by hand it's a harmless no-op under 20 entries and, over that,
  # simply skips a warning the caller doesn't need.
  local force=0
  [[ ${2:-} == --force ]] && force=1
  [[ $url == magnet:* ]] || die "usage: qbt magnet-inbox <magnet-url>"
  export PATH="/usr/bin:$PATH"
  local dir inbox pending meta
  dir=$(magnet_state_dir)
  ensure_state_dir "$dir"
  inbox=$(magnet_inbox_path)
  pending=$(magnet_pending_path)
  meta=$(magnet_meta "$url")
  set +e
  MAGNET_URL=$url python3 - "$inbox" "$pending" "$meta" "$force" <<'PY'
import json, os, sys, time
inbox_path, pending_path, meta_raw, force_raw = sys.argv[1:5]
url = os.environ["MAGNET_URL"]
force = force_raw == "1"
meta = json.loads(meta_raw)
ids = set(meta.get("ids") or [])
pending = []
if os.path.isfile(pending_path):
    pending = json.loads(open(pending_path).read() or "[]")
lines = []
if os.path.isfile(inbox_path):
    lines = [ln for ln in open(inbox_path) if ln.strip()]
def line_ids(obj):
    m = obj.get("ids") or []
    if m:
        return set(m)
    # parsed later; compare url
    return set()
count = len(lines) + len(pending)
# The cap guards against a flood of browser-clicked magnets; a fetch-metadata
# rescue is recovery, not a new arrival, and must never be dropped by it.
if count >= 20 and not force:
    sys.exit(20)
for ln in lines:
    obj = json.loads(ln)
    if obj.get("url") == url:
        sys.exit(0)
    if ids and set(obj.get("ids") or []) & ids:
        sys.exit(0)
for row in pending:
    if row.get("url") == url:
        sys.exit(0)
    if ids and set(row.get("hashes") or [row.get("hash")]) & ids:
        sys.exit(0)
obj = {"url": url, "ts": int(time.time()), "notified": False, "ids": list(ids), "dn": meta.get("dn") or ""}
with open(inbox_path, "a") as f:
    f.write(json.dumps(obj) + "\n")
os.chmod(inbox_path, 0o600)
sys.exit(0)
PY
  local st=$?
  set -e
  if [[ $st -eq 20 ]]; then
    magnet_notify "Inbox full. Click the mark when the daemon is up."
    die "inbox full"
  fi
  [[ $st -eq 0 ]] || die "magnet-inbox failed"
  local raised=0
  local raise_cmd
  raise_cmd=${QBT_RAISE_CMD:-omarchy-shell}
  # `magnet` lets an open window show the confirm without the popup. A
  # shell without that IPC function exits non-zero, so fall back to `open`.
  if command -v "$raise_cmd" >/dev/null 2>&1; then
    if "$raise_cmd" aweiward.omaqbt magnet >/dev/null 2>&1; then
      raised=1
    elif "$raise_cmd" aweiward.omaqbt open >/dev/null 2>&1; then
      raised=1
    fi
  fi
  if [[ $raised -eq 0 ]]; then
    local label
    label=$(jq -r '.dn // empty' <<<"$meta")
    [[ -n $label ]] || label=$(jq -r '.ids[0] // "magnet"' <<<"$meta")
    magnet_notify "Click the mark to start ${label}"
    MAGNET_URL=$url python3 - "$(magnet_inbox_path)" <<'PY'
import json, os, sys
path = sys.argv[1]
url = os.environ["MAGNET_URL"]
rows = []
if os.path.isfile(path):
    for ln in open(path):
        if not ln.strip():
            continue
        obj = json.loads(ln)
        if obj.get("url") == url:
            obj["notified"] = True
        rows.append(obj)
with open(path, "w") as f:
    for obj in rows:
        f.write(json.dumps(obj) + "\n")
PY
  fi
  printf '%s\n' '{"ok":true}'
}

