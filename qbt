# D4 (slice 3b). `sequential <hashes> on|off` and `first-last <hashes>
# on|off`: 5.2.3 only has toggle endpoints, so read each target's current
# value and toggle only the ones that differ, in one POST; when none differ
# nothing is sent. A double press stays where it was asked to be.
cmd_toggle_to() {
  local label=$1 field=$2 route=$3 hashes=$4 want=$5
  local api_error_detail=code
  valid_hashes "$hashes" || die "invalid hash list"
  local query=""
  [[ $hashes == all ]] || query="?hashes=${hashes}"
  api_or_die GET "/api/v2/torrents/info${query}"
  local plan
  plan=$(printf '%s\n' "$API_BODY" | jq -c --arg want "$hashes" --arg field "$field" --argjson on "$([[ $want == on ]] && echo true || echo false)" "$TARGETS_JQ"'
    try (
      targets($want)
      | [.[] | select(has("missing"))] as $missing
      | if ($missing | length) > 0 then {missing: ($missing | length)}
        else {hashes: ([.[] | if (.[$field] | type) != "boolean" then error("unreadable") else . end
                         | select(.[$field] != $on) | .hash] | join("|"))}
        end
    ) catch {unreadable: true}' 2>/dev/null) || die "qBittorrent sent something unreadable"
  [[ $(jq -r '.unreadable // false' <<<"$plan") == false ]] || die "qBittorrent sent something unreadable"
  local missing
  missing=$(jq -r '.missing // 0' <<<"$plan")
  (( missing == 0 )) || die_gone "$missing"
  local differ
  differ=$(jq -r '.hashes' <<<"$plan")
  if [[ -n $differ ]]; then
    valid_hashes "$differ" && [[ $differ != all ]] || die "qBittorrent sent something unreadable"
    api_or_die POST "/api/v2/torrents/${route}" "hashes=${differ}"
  fi
  printf '%s\n' '{"ok":true}'
}

