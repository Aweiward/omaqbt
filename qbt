cmd_magnet_drain() {
  local inbox first url
  inbox=$(magnet_inbox_path)
  [[ -f $inbox ]] || die "inbox empty"
  first=$(head -1 "$inbox" || true)
  [[ -n $first ]] || die "inbox empty"
  url=$(jq -r '.url // empty' <<<"$first")
  [[ -n $url ]] || die "inbox empty"
  local meta ids_json
  meta=$(magnet_meta "$url")
  ids_json=$(jq -c '.ids' <<<"$meta")
  local info
  info=$(magnet_info)
  local match
  match=$(INFO="$info" IDS="$ids_json" URL="$url" python3 - <<'PY'
import json, os
info = json.loads(os.environ["INFO"] or "[]")
ids = set(json.loads(os.environ["IDS"] or "[]"))
hits = []
for row in info:
    cands = [row.get("hash"), row.get("infohash_v1"), row.get("infohash_v2")]
    for c in cands:
        if c and str(c).lower() in ids:
            hits.append(row)
            break
print(json.dumps(hits))
PY
)
  local pending
  pending=$(magnet_read_pending)
  local already_pending
  already_pending=$(JQ_U=$url jq -e --argjson ids "$ids_json" '
    [.[] | select(.url == env.JQ_U or ((.hashes // [.hash]) | map(ascii_downcase) | any(. as $h | ($ids | map(ascii_downcase) | index($h)))) ) ] | length > 0
  ' <<<"$pending" && echo yes || echo no)
  if [[ $already_pending == yes ]]; then
    tail -n +2 "$inbox" >"${inbox}.tmp" || true
    mv "${inbox}.tmp" "$inbox"
    printf '%s\n' '{"ok":true,"duplicate":"pending"}'
    return 0
  fi
  local n_hits
  n_hits=$(jq 'length' <<<"$match")
  if [[ $n_hits -gt 0 ]]; then
    tail -n +2 "$inbox" >"${inbox}.tmp" || true
    mv "${inbox}.tmp" "$inbox"
    magnet_notify "Already in the list"
    printf '%s\n' '{"ok":true,"duplicate":"library"}'
    return 0
  fi
  local body
  body="urls=$(uri_encode "$url")"
  body+="&stopCondition=MetadataReceived&stopped=false&paused=false"
  api POST "/api/v2/torrents/add" "$body" >/dev/null
  info=$(magnet_info)
  match=$(INFO="$info" IDS="$ids_json" python3 - <<'PY'
import json, os
info = json.loads(os.environ["INFO"] or "[]")
ids = set(json.loads(os.environ["IDS"] or "[]"))
hits = []
for row in info:
    cands = [row.get("hash"), row.get("infohash_v1"), row.get("infohash_v2")]
    for c in cands:
        if c and str(c).lower() in ids:
            hits.append({"hash": row.get("hash") or "", "v1": row.get("infohash_v1") or "", "v2": row.get("infohash_v2") or ""})
            break
print(json.dumps(hits))
PY
)
  n_hits=$(jq 'length' <<<"$match")
  if [[ $n_hits -eq 0 ]]; then
    printf '%s\n' '{"ok":false,"error":"unidentified"}' >&2
    die "unidentified torrent"
  fi
  local hash hashes dn
  hash=$(jq -r '.[0].hash' <<<"$match")
  hashes=$(jq -c '[.[].hash, .[].v1, .[].v2] | map(select(. != "")) | unique' <<<"$match")
  dn=$(jq -r '.dn // empty' <<<"$meta")
  local cancel
  cancel=$(magnet_read_cancel)
  if JQ_U=$url jq -e --arg h "$hash" 'index(env.JQ_U) or index($h)' <<<"$cancel" >/dev/null; then
    api POST "/api/v2/torrents/delete" "hashes=${hash}&deleteFiles=true" >/dev/null || true
    tail -n +2 "$inbox" >"${inbox}.tmp" || true
    mv "${inbox}.tmp" "$inbox"
    magnet_write_cancel "$(JQ_U=$url jq -c --arg h "$hash" '[.[] | select(. != env.JQ_U and . != $h)]' <<<"$cancel")"
    printf '%s\n' '{"ok":true,"cancelled":true}'
    return 0
  fi
  tail -n +2 "$inbox" >"${inbox}.tmp" || true
  mv "${inbox}.tmp" "$inbox"
  local row
  row=$(JQ_U=$url jq -n --arg hash "$hash" --argjson hashes "$hashes" --arg dn "$dn" --argjson addedAt "$(date +%s)" \
    '{hash:$hash,url:env.JQ_U,hashes:$hashes,dn:$dn,addedAt:$addedAt}')
  magnet_write_pending "$(JQ_ROW=$row jq -c '. + [env.JQ_ROW|fromjson]' <<<"$pending")"
  printf '%s\n' '{"ok":true}'
}

# ---------------------------------------------------------------------------
# Slice 3a: categories and tags. Every name, path and hash is checked before
# any request; every value is @uri-encoded; API failures report only the
# HTTP code (api_error_detail=code), never a body.
# ---------------------------------------------------------------------------

uri() {
  jq -nr --arg v "$1" '$v|@uri'
}

# Leading/trailing "spaces": U+0020 plus every other character
# qBittorrent's QString::trimmed strips that isn't already a refused
# control character (U+00A0, U+1680, U+2000-200A, U+2028, U+2029,
# U+202F, U+205F, U+3000), as raw UTF-8 bytes so the prefix/suffix tests
# below are byte-exact under any locale. Shared cases:
# tests/fixtures/validation-cases.json "names".
NAME_EDGE_SPACES=(
  ' ' $'\xc2\xa0' $'\xe1\x9a\x80'
  $'\xe2\x80\x80' $'\xe2\x80\x81' $'\xe2\x80\x82' $'\xe2\x80\x83' $'\xe2\x80\x84' $'\xe2\x80\x85'
  $'\xe2\x80\x86' $'\xe2\x80\x87' $'\xe2\x80\x88' $'\xe2\x80\x89' $'\xe2\x80\x8a'
  $'\xe2\x80\xa8' $'\xe2\x80\xa9' $'\xe2\x80\xaf' $'\xe2\x81\x9f' $'\xe3\x80\x80'
)

# The UTF-8 locale the name validator counts characters under, whatever the
# caller's own locale is (the bar may run under C). C.UTF-8 first, then
# en_US.UTF-8; a candidate only counts if it really makes a 2-byte "é" one
# character.
name_utf8_locale() {
  local l
  for l in C.UTF-8 en_US.UTF-8; do
    if (LC_ALL=$l; s=$'\xc3\xa9'; [[ ${#s} == 1 ]]) 2>/dev/null; then
      printf '%s' "$l"
      return 0
    fi
  done
  return 1
}

# Bytes 0x01-0x1F and 0x7F (argv can't carry 0x00; LC_ALL=C makes
# [:cntrl:] exactly that byte set), plus the C1 controls U+0080-009F, whose
# UTF-8 form is 0xC2 followed by 0x80-0x9F (a byte range under LC_ALL=C).
name_has_control() {
  local LC_ALL=C
  [[ $1 == *[[:cntrl:]]* || $1 == *$'\xc2'[$'\x80'-$'\x9f']* ]]
}

# True when a name can be echoed in a message: valid UTF-8 with no control
# character. A name that only has to exist was never checked against either.
name_is_printable() {
  name_has_control "$1" && return 1
  local loc
  loc=$(name_utf8_locale) || return 1
  (LC_ALL=$loc; [[ $1 =~ ^.*$ ]]) 2>/dev/null
}

name_has_edge_space() {
  local LC_ALL=C sp
  for sp in "${NAME_EDGE_SPACES[@]}"; do
    [[ $1 == "$sp"* || $1 == *"$sp" ]] && return 0
  done
  return 1
}

# G4/OV5: prints nothing for a valid NEW name, else the message (the same
# strings the window's nameError gives, from validation-cases.json). $1 is
# "category" or "tag".
new_name_error() {
  local kind=$1 name=$2
  if [[ -z $name ]]; then printf 'Type a name.'; return; fi
  if name_has_control "$name"; then printf 'No control characters in a name.'; return; fi
  local loc
  loc=$(name_utf8_locale) || { printf 'No UTF-8 locale is available to check the name.'; return; }
  local count
  count=$(
    LC_ALL=$loc
    # An invalid UTF-8 sequence doesn't match "." under a UTF-8 locale.
    [[ $name =~ ^.*$ ]] || { printf 'bad'; exit 0; }
    printf '%s' "${#name}"
  ) 2>/dev/null
  if [[ $count == bad ]]; then printf 'Use valid UTF-8 text in a name.'; return; fi
  [[ $count =~ ^[[:digit:]]{1,6}$ ]] || { printf 'Use valid UTF-8 text in a name.'; return; }
  if (( 10#$count > 64 )); then printf 'Keep it to 64 characters.'; return; fi
  if name_has_edge_space "$name"; then printf 'No spaces at the start or end.'; return; fi
  if [[ $kind == tag ]]; then
    [[ $name != *,* ]] || printf 'No commas in a tag.'
    return
  fi
  if [[ $name == *\\* ]]; then printf 'No backslashes in a category.'; return; fi
  if [[ $name == /* || $name == */ ]]; then printf "A category can't start or end with /."; return; fi
  if [[ $name == *//* ]]; then printf 'No // in a category.'; return; fi
}

# An EXISTING name (removal, a rename's old name, a tag on a torrent) only
# has to be sendable; existence is checked against qBittorrent afterwards.
# Tags are sent comma-separated, and removeCategories splits on newlines, so
# a name holding either would address other names too.
existing_name_error() {
  local kind=$1 name=$2
  if [[ -z $name ]]; then printf 'Type a name.'; return; fi
  if [[ $kind == tag ]]; then
    [[ $name != *,* ]] || printf 'No commas in a tag.'
  elif [[ $name == *$'\n'* || $name == *$'\r'* ]]; then
    printf "This category's name can't be sent through the WebUI API."
  fi
}

check_new_name() {
  local msg
  msg=$(new_name_error "$1" "$2")
  [[ -z $msg ]] || die "$msg"
}

check_existing_name() {
  local msg
  msg=$(existing_name_error "$1" "$2")
  [[ -z $msg ]] || die "$msg"
}

# "" (qBittorrent's default) or an absolute / ~/ path, like set-location.
# Prints the path with ~/ expanded.
category_save_path() {
  local path=$1
  [[ $path == "~/"* ]] && path=$HOME/${path#\~/}
  [[ -z $path || $path == /* ]] || die "The save path must be absolute or start with ~/."
  printf '%s' "$path"
}

# One api call that may fail without ending the command. On success the
# body is in API_BODY. On failure API_FAIL is "HTTP <code>" or a short
# reason -- never a response body (api_error_detail=code in the caller makes
# api_exec's own message the status only; this keeps just the code).
api_try() {
  local out rc=0
  out=$(api "$@" 2>&1) || rc=$?
  api_try_result "$rc" "$out"
}

# Slice 5a: api_try for a form body that arrives on stdin (curl
# --data-binary @-), so no value is ever on curl's argv. Feed it with a
# process substitution (`< <(printf ...)`), never a pipe: a pipeline would
# run it in a subshell and lose API_BODY/API_FAIL. The response body stays
# in memory, as in api_exec.
api_try_stdin() {
  local method=$1 path=$2 out rc=0
  out=$(api_stdin_exec "$method" "$path" 2>&1) || rc=$?
  api_try_result "$rc" "$out"
}

api_stdin_exec() {
  assert_local_base
  local method=$1 path=$2
  ensure_state_dir "$(dirname "$COOKIE_FILE")"
  prepare_auth
  (umask 077; api_exec -sS -g --noproxy '*' --max-time 5 -X "$method" -b "$COOKIE_FILE" -c "$COOKIE_FILE" \
    "${AUTH_ARGS[@]}" -H "Content-Type: application/x-www-form-urlencoded" --data-binary @- "$(base_url)$path")
}

# $1 the call's status, $2 its output: the body into API_BODY, or the
# reason into API_FAIL (a code or a short reason, never a body).
api_try_result() {
  local rc=$1 out=$2
  API_BODY="" API_FAIL=""
  if (( rc == 0 )); then
    API_BODY=$out
    return 0
  fi
  if [[ $out =~ \(HTTP\ ([[:digit:]]{3})\) ]]; then
    API_FAIL="HTTP ${BASH_REMATCH[1]}"
  elif [[ $out == *"$API_KEY_REFUSED"* ]]; then
    API_FAIL="$API_KEY_REFUSED"
  else
    API_FAIL="couldn't reach qBittorrent"
  fi
  return 1
}

# Like api_try, but a failure ends the command with the plain API error.
api_or_die() {
  api_try "$@" || die "qBittorrent refused it (${API_FAIL})"
}

# Splits a validated "|" hash list into CHUNKS of at most 1000 (1a's
# Model.chunkHashes, OV3). "all" stays a single chunk.
hash_chunks() {
  local list=$1
  CHUNKS=()
  CHUNK_SIZES=()
  if [[ $list == all ]]; then
    CHUNKS=(all)
    CHUNK_SIZES=(0)
    return
  fi
  local -a all
  IFS='|' read -r -a all <<<"$list"
  local i
  for (( i = 0; i < ${#all[@]}; i += 1000 )); do
    local -a part=("${all[@]:i:1000}")
    CHUNKS+=("$(IFS='|'; printf '%s' "${part[*]}")")
    CHUNK_SIZES+=("${#part[@]}")
  done
}

hash_count() {
  local list=$1
  [[ $list == all ]] && { printf '0'; return; }
  local -a all
  IFS='|' read -r -a all <<<"$list"
  printf '%s' "${#all[@]}"
}

# torrents/categories or torrents/tags, as JSON, into NAMES_JSON; dies with
# the plain API error (or $1-prefixed wording) when the read fails.
read_names() {
  local kind=$1 prefix=${2:-}
  local route=categories
  [[ $kind == tag ]] && route=tags
  if ! api_try GET "/api/v2/torrents/${route}"; then
    [[ -n $prefix ]] && die "${prefix}${API_FAIL}"
    die "qBittorrent refused it (${API_FAIL})"
  fi
  NAMES_JSON=$API_BODY
  jq -e 'type == "object" or type == "array"' <<<"$NAMES_JSON" >/dev/null 2>&1 \
    || die "${prefix:-}qBittorrent sent something unreadable"
}

name_exists() {
  local kind=$1 name=$2
  if [[ $kind == tag ]]; then
    jq -e --arg n "$name" 'index($n) != null' <<<"$NAMES_JSON" >/dev/null
  else
    jq -e --arg n "$name" 'has($n)' <<<"$NAMES_JSON" >/dev/null
  fi
}

# A name that only passed the existing-name check, for the middle of a
# message: itself when name_is_printable, else "that category"/"that tag"
# (a legacy name may carry ESC/ANSI sequences or invalid UTF-8).
shown_name() {
  if name_is_printable "$2"; then printf '%s' "$2"; else printf 'that %s' "$1"; fi
}

require_name() {
  name_exists "$1" "$2" && return 0
  name_is_printable "$2" && die "$2 doesn't exist."
  die "That $1 doesn't exist."
}

# 5.2.3's createCategory/editCategory take only the save and download paths;
# every other option (the share limits: ratio_limit, seeding_time_limit,
# inactive_seeding_time_limit, share_limit_action) starts over at "use
# global" (-2, -2, -2, "Default"). So a category with its own limits can't
# be renamed (the copy would lose them) or have its path changed (editCategory
# would reset them). Missing fields count as the defaults.
require_default_share_limits() {
  local name=$1 own
  own=$(jq -r --arg n "$name" '.[$n] |
    ((.ratio_limit // -2) != -2) or ((.seeding_time_limit // -2) != -2)
    or ((.inactive_seeding_time_limit // -2) != -2) or ((.share_limit_action // "Default") != "Default")' <<<"$NAMES_JSON")
  [[ $own == false ]] && return 0
  local rest="has its own share limits, which the WebUI can't copy; change them in qBittorrent first."
  name_is_printable "$name" && die "$name $rest"
  die "That category $rest"
}

# A category's download path as qBittorrent 5.2.3 serves it
# (download_path: a path, false = disabled, null/absent = the global
# setting; downloadPath read too, like lib/qbtsync.py's category_paths),
# turned into the createCategory/editCategory fields that keep it:
# "&downloadPathEnabled=true&downloadPath=<path>", "&downloadPathEnabled=false"
# or nothing. editCategory resets the download path when these are missing.
category_download_fields() {
  # A string -- even "" (enabled with an empty path, a real 5.2.3 state) --
  # is kept as enabled; false as disabled; null or any other shape sends
  # nothing. The rename's merge check compares these same raw values, so a
  # copy always matches its source on a re-run.
  local name=$1
  jq -r --arg n "$name" '
    .[$n] | (if has("download_path") then .download_path elif has("downloadPath") then .downloadPath else null end) as $d
    | if ($d | type) == "string" then "&downloadPathEnabled=true&downloadPath=\($d | @uri)"
      elif $d == false then "&downloadPathEnabled=false"
      else "" end' <<<"$NAMES_JSON"
}

cmd_category_add() {
  local api_error_detail=code
  [[ $# -ge 1 && $# -le 2 ]] || die "usage: qbt category-add <name> [savepath]"
  local name=$1 path
  check_new_name category "$name"
  path=$(category_save_path "${2:-}")
  api_or_die POST "/api/v2/torrents/createCategory" "category=$(uri "$name")&savePath=$(uri "$path")"
  printf '%s\n' '{"ok":true}'
}

cmd_category_path() {
  local api_error_detail=code
  [[ $# -eq 2 ]] || die "usage: qbt category-path <name> <savepath, \"\" = default>"
  local name=$1 path
  check_existing_name category "$name"
  path=$(category_save_path "$2")
  read_names category
  require_name category "$name"
  require_default_share_limits "$name"
  api_or_die POST "/api/v2/torrents/editCategory" "category=$(uri "$name")&savePath=$(uri "$path")$(category_download_fields "$name")"
  printf '%s\n' '{"ok":true}'
}

cmd_category_remove() {
  local api_error_detail=code
  [[ $# -eq 1 ]] || die "usage: qbt category-remove <name>"
  local name=$1
  check_existing_name category "$name"
  read_names category
  require_name category "$name"
  api_or_die POST "/api/v2/torrents/removeCategories" "categories=$(uri "$name")"
  printf '%s\n' '{"ok":true}'
}

cmd_set_category() {
  local api_error_detail=code
  [[ $# -eq 2 ]] || die "usage: qbt set-category <hash|list> <name, \"\" = none>"
  local hashes=$1 name=$2
  valid_hashes "$hashes" || die "invalid hash list"
  if [[ -n $name ]]; then
    check_existing_name category "$name"
    read_names category
    require_name category "$name"
  fi
  hash_chunks "$hashes"
  local total done=0 i
  total=$(hash_count "$hashes")
  for i in "${!CHUNKS[@]}"; do
    if ! api_try POST "/api/v2/torrents/setCategory" "hashes=${CHUNKS[i]}&category=$(uri "$name")"; then
      (( done == 0 )) && die "qBittorrent refused it (${API_FAIL})"
      die "Category set on ${done} of ${total} torrents; qBittorrent refused the rest (${API_FAIL})"
    fi
    done=$(( done + CHUNK_SIZES[i] ))
  done
  printf '%s\n' '{"ok":true}'
}

cmd_tag_add() {
  local api_error_detail=code
  [[ $# -eq 1 ]] || die "usage: qbt tag-add <name>"
  check_new_name tag "$1"
  api_or_die POST "/api/v2/torrents/createTags" "tags=$(uri "$1")"
  printf '%s\n' '{"ok":true}'
}

cmd_tag_remove() {
  local api_error_detail=code
  [[ $# -eq 1 ]] || die "usage: qbt tag-remove <name>"
  check_existing_name tag "$1"
  read_names tag
  require_name tag "$1"
  api_or_die POST "/api/v2/torrents/deleteTags" "tags=$(uri "$1")"
  printf '%s\n' '{"ok":true}'
}

# True when $1 equals one of the remaining arguments.
in_list() {
  local needle=$1 x
  shift
  for x in "$@"; do
    [[ $x == "$needle" ]] && return 0
  done
  return 1
}

# Joins tag names with ", ", each through shown_name.
join_tag_names() {
  local out="" n
  for n in "$@"; do
    out+=${out:+, }$(shown_name tag "$n")
  done
  printf '%s' "$out"
}

# OV7: one addTags/removeTags call per changed tag (chunked), adds first.
# Stops at the first failure and says what already happened:
# "Tags: added keep; removing seedbox failed (HTTP 409)".
cmd_tags() {
  local api_error_detail=code
  local usage="usage: qbt tags <hash|list> [--add <name>]... [--remove <name>]..."
  [[ $# -ge 1 ]] || die "$usage"
  local hashes=$1
  shift
  local -a adds=() removes=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --add) [[ $# -ge 2 ]] || die "$usage"; adds+=("$2"); shift 2 ;;
      --remove) [[ $# -ge 2 ]] || die "$usage"; removes+=("$2"); shift 2 ;;
      *) die "$usage" ;;
    esac
  done
  (( ${#adds[@]} + ${#removes[@]} > 0 )) || die "$usage"
  valid_hashes "$hashes" || die "invalid hash list"
  local t
  for t in ${adds[@]+"${adds[@]}"} ${removes[@]+"${removes[@]}"}; do
    check_existing_name tag "$t"
  done
  for t in ${adds[@]+"${adds[@]}"}; do
    if in_list "$t" ${removes[@]+"${removes[@]}"}; then
      name_is_printable "$t" && die "Can't add and remove $t at once."
      die "Can't add and remove the same tag at once."
    fi
  done
  read_names tag
  for t in ${adds[@]+"${adds[@]}"} ${removes[@]+"${removes[@]}"}; do
    require_name tag "$t"
  done
  hash_chunks "$hashes"
  local -a added=() removed=()
  local verb route i
  for verb in add remove; do
    local -a list=()
    if [[ $verb == add ]]; then
      route=addTags
      list=(${adds[@]+"${adds[@]}"})
    else
      route=removeTags
      list=(${removes[@]+"${removes[@]}"})
    fi
    for t in ${list[@]+"${list[@]}"}; do
      # A repeated flag's tag is sent once.
      in_list "$t" ${added[@]+"${added[@]}"} ${removed[@]+"${removed[@]}"} && continue
      for i in "${!CHUNKS[@]}"; do
        if ! api_try POST "/api/v2/torrents/${route}" "hashes=${CHUNKS[i]}&tags=$(uri "$t")"; then
          local -a parts=()
          (( ${#added[@]} )) && parts+=("added $(join_tag_names "${added[@]}")")
          (( ${#removed[@]} )) && parts+=("removed $(join_tag_names "${removed[@]}")")
          local doing=adding
          [[ $verb == remove ]] && doing=removing
          parts+=("${doing} $(shown_name tag "$t") failed (${API_FAIL})")
          local msg="" p
          for p in "${parts[@]}"; do msg+=${msg:+; }$p; done
          die "Tags: ${msg}"
        fi
      done
      if [[ $verb == add ]]; then added+=("$t"); else removed+=("$t"); fi
    done
  done
  printf '%s\n' '{"ok":true}'
}

# Hashes (|-joined) of the torrents on category/tag $2, from a
# torrents/info body in $3. Tags come ", "-joined; a tag never holds a comma.
torrents_on() {
  local kind=$1 name=$2 info=$3
  if [[ $kind == tag ]]; then
    jq -r --arg n "$name" '[.[] | select((.tags // "") | split(", ") | index($n) != null) | .hash] | join("|")' <<<"$info"
  else
    jq -r --arg n "$name" '[.[] | select((.category // "") == $n) | .hash] | join("|")' <<<"$info"
  fi
}

# Review Focus 2, Deviation 1. Idempotent and resumable: every read happens
# before the first write, so M is known and a failed read or create changes
# nothing ("Rename didn't start: HTTP 409"). After that each failure names
# how far it got, and a re-run with --merge (the target now exists) picks up
# whatever is still on the old name. The old name is deleted only once a
# fresh read shows nothing on it: deleting a category that still has
# torrents un-categorizes them, which can move their files (G8).
cmd_rename() {
  local kind=$1
  shift
  local api_error_detail=code
  local usage="usage: qbt ${kind}-rename <old> <new> [--merge]"
  [[ $# -eq 2 || ( $# -eq 3 && $3 == --merge ) ]] || die "$usage"
  local old=$1 new=$2 merge=false
  [[ ${3:-} == --merge ]] && merge=true
  check_existing_name "$kind" "$old"
  check_new_name "$kind" "$new"
  [[ $old != "$new" ]] || die "It already has that name."
  # 5.2.3's removeCategory also removes every "old/..." category, so the
  # final delete would take the new one with it. (new passed the new-name
  # rules, so its "old/" prefix is safe to echo.)
  [[ $kind == category && $new == "$old/"* ]] && die "Can't rename $old into its own subcategory."

  local start="Rename didn't start: "
  read_names "$kind" "$start"
  require_name "$kind" "$old"
  if [[ $kind == category ]]; then
    # Same reason: deleting old would remove its subcategories and move
    # their torrents to old's parent.
    jq -e --arg p "$old/" 'any(keys[]; startswith($p))' <<<"$NAMES_JSON" >/dev/null \
      && { name_is_printable "$old" && die "$old has subcategories; rename or remove them first."
           die "That category has subcategories; rename or remove them first."; }
    require_default_share_limits "$old"
  fi
  local exists=false
  name_exists "$kind" "$new" && exists=true
  if [[ $exists == true ]]; then
    [[ $merge == true ]] || die "$new already exists."
    if [[ $kind == category ]]; then
      local same
      same=$(jq -r --arg a "$old" --arg b "$new" '
        def paths(c): [c.savePath // "", (if c | has("download_path") then c.download_path elif c | has("downloadPath") then c.downloadPath else null end)];
        paths(.[$a]) == paths(.[$b])' <<<"$NAMES_JSON")
      [[ $same == true ]] || die "$new already exists with a different save path."
    fi
  fi

  api_try GET "/api/v2/torrents/info" || die "${start}${API_FAIL}"
  local info=$API_BODY moving
  moving=$(torrents_on "$kind" "$old" "$info") || die "${start}qBittorrent sent something unreadable"
  # These hashes go into form bodies as-is, so they get the same check as
  # a caller's.
  [[ -z $moving ]] || valid_hashes "$moving" || die "${start}qBittorrent sent something unreadable"
  local total=0
  [[ -n $moving ]] && total=$(hash_count "$moving")

  if [[ $exists == false ]]; then
    if [[ $kind == category ]]; then
      local save
      save=$(jq -r --arg n "$old" '.[$n].savePath // ""' <<<"$NAMES_JSON")
      api_try POST "/api/v2/torrents/createCategory" "category=$(uri "$new")&savePath=$(uri "$save")$(category_download_fields "$old")" \
        || die "${start}${API_FAIL}"
    else
      api_try POST "/api/v2/torrents/createTags" "tags=$(uri "$new")" || die "${start}${API_FAIL}"
    fi
  fi

  local incomplete_tail
  incomplete_tail="press c on $(shown_name "$kind" "$old") again to finish."
  local moved=0 i
  if [[ -n $moving ]]; then
    hash_chunks "$moving"
    for i in "${!CHUNKS[@]}"; do
      if [[ $kind == category ]]; then
        api_try POST "/api/v2/torrents/setCategory" "hashes=${CHUNKS[i]}&category=$(uri "$new")" \
          || die "Rename incomplete (${moved} of ${total} moved); ${incomplete_tail}"
      else
        # A chunk counts as moved only once it has lost the old tag; a
        # re-run's addTags on it again is harmless.
        api_try POST "/api/v2/torrents/addTags" "hashes=${CHUNKS[i]}&tags=$(uri "$new")" \
          || die "Rename incomplete (${moved} of ${total} moved); ${incomplete_tail}"
        api_try POST "/api/v2/torrents/removeTags" "hashes=${CHUNKS[i]}&tags=$(uri "$old")" \
          || die "Rename incomplete (${moved} of ${total} moved); ${incomplete_tail}"
      fi
      moved=$(( moved + CHUNK_SIZES[i] ))
    done
  fi

  # Nothing may still be on the old name: a chunk qBittorrent didn't apply,
  # or a torrent added to it meanwhile.
  api_try GET "/api/v2/torrents/info" || die "Rename incomplete (${moved} of ${total} moved); ${incomplete_tail}"
  local left counts
  left=$(torrents_on "$kind" "$old" "$API_BODY") || die "Rename incomplete (${moved} of ${total} moved); ${incomplete_tail}"
  if [[ -n $left ]]; then
    # Of the torrents counted at the start, how many really left; anything
    # new on the old name adds to the total.
    counts=$(jq -rn --arg was "$moving" --arg now "$left" '
      ($was | split("|") | map(select(. != ""))) as $w
      | ($now | split("|") | map(select(. != ""))) as $n
      | "\(($w - $n) | length) \(($w | length) + (($n - $w) | length))"')
    [[ $counts =~ ^([[:digit:]]+)\ ([[:digit:]]+)$ ]] || counts="${moved} ${total}"
    die "Rename incomplete (${counts% *} of ${counts#* } moved); ${incomplete_tail}"
  fi

  # Unavoidable race: a torrent put on old between that read and this delete
  # moves to old's parent category (qBittorrent's removeCategory).
  if [[ $kind == category ]]; then
    api_try POST "/api/v2/torrents/removeCategories" "categories=$(uri "$old")" \
      || die "Rename incomplete (${moved} of ${total} moved); ${incomplete_tail}"
  else
    api_try POST "/api/v2/torrents/deleteTags" "tags=$(uri "$old")" \
      || die "Rename incomplete (${moved} of ${total} moved); ${incomplete_tail}"
  fi
  printf '%s\n' '{"ok":true}'
}

# ---------------------------------------------------------------------------
# Slice 4a: qBittorrent's preferences. settings-schema.json (plugin root,
# next to this script) types every key; the locks, the secrets, any
# *password* key and Other's refused patterns are hardcoded here on
# purpose, and the locks, secrets and *password* are checked before the
# schema is read, so an edited or missing schema can never unlock them
# (tests/test_prefs.py pins the lists equal to the schema's). Secret values
# never reach stdout, stderr or any argv; API failures report the HTTP
# code only.
# ---------------------------------------------------------------------------

# The VPN binding: "Set by OmaqBT's setup."
PREF_LOCKED_VPN=(
  current_network_interface
  current_interface_address
  current_interface_name
)
# The WebUI OmaqBT itself talks to: "OmaqBT needs this as it is." The two
# login-bypass switches stay off: loopback is shared by every local account
# (marketplace review, 2026-10-02). The two custom-header keys are eng 4b
# D8: 5.2.3 adds the headers to every WebUI reply unfiltered
# (appcontroller.cpp:953), and a bad one cuts qbt and the sidecar off from
# qBittorrent.
PREF_LOCKED_WEBUI=(
  web_ui_address
  web_ui_port
  bypass_local_auth
  bypass_auth_subnet_whitelist_enabled
  use_https
  'web_ui_https_*'
  web_ui_host_header_validation_enabled
  web_ui_domain_list
  'web_ui_reverse_prox*'
  'alternative_webui_*'
  web_ui_use_custom_http_headers_enabled
  web_ui_custom_http_headers
)
# A key the schema doesn't know (Other) is refused when it matches one.
PREF_OTHER_REFUSED=(
  'web_ui_*'
  'proxy_*'
  '*interface*'
  '*password*'
  '*https*'
  'autorun*'
  '*token*'
  '*secret*'
  '*api_key*'
)
# Printed as {"set": bool}, on top of the schema's secret flags.
# web_ui_api_key is read-only in qBittorrent.
PREF_SECRETS=(proxy_password dyndns_password mail_notification_password web_ui_api_key)
# Eng 4b D7: the only secrets OmaqBT writes, and only from stdin (`pref-set
# <key> --stdin`) or as "" (`--clear`). Checked before the schema is read,
# so no schema can add one; a schema without secretWritable on one of them
# refuses it too. tests/test_prefs.py pins this equal to the schema's.
PREF_SECRET_WRITABLE=(
  proxy_password
  dyndns_password
  mail_notification_password
)
# Every other key named like a secret is refused --stdin and --clear.
PREF_SECRET_REFUSED=('*password*' '*token*' '*secret*' '*api_key*')
# Ruling EB (eng 4b D9): OmaqBT's choice, not qBittorrent's, so it has its
# own sentence and is checked before the schema like the locks.
PREF_OMAQBT_READ_ONLY=bypass_auth_subnet_whitelist
PREF_OMAQBT_READ_ONLY_SENTENCE="OmaqBT keeps this read-only: it has no effect while the Web UI only listens on 127.0.0.1."
# Keys the schema doesn't know whose names sound secret (matched
# case-insensitively) are printed as {"set": bool} too.
PREF_SECRET_NAME_RE='password|token|secret|api_key'

pref_schema_path() {
  local exec_path
  exec_path=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
  [[ $exec_path == /* ]] || exec_path="$PWD/$0"
  printf '%s/settings-schema.json' "$(dirname "$exec_path")"
}

# True when $1 matches one of the globs after it ("*" is the only
# wildcard; keys are checked to be [A-Za-z0-9_] first).
pref_matches() {
  local key=$1 glob
  shift
  for glob in "$@"; do
    # shellcheck disable=SC2053 # the glob is meant to match
    [[ $key == $glob ]] && return 0
  done
  return 1
}

# Prints a JSON array of the secret keys' names.
pref_secret_names() {
  local schema=$1
  jq -c --arg extra "${PREF_SECRETS[*]}" \
    '[.keys | to_entries[] | select(.value.secret == true) | .key] + ($extra | split(" ")) | unique' "$schema"
}

# Reads /app/preferences into PREFS_JSON, or dies with the code only.
pref_read() {
  api_try GET "/api/v2/app/preferences" || die "qBittorrent refused it (${API_FAIL})"
  PREFS_JSON=$API_BODY
  printf '%s' "$PREFS_JSON" | jq -e 'type == "object"' >/dev/null 2>&1 || die "qBittorrent sent something unreadable"
}

cmd_prefs() {
  local api_error_detail=code
  [[ $# -eq 0 ]] || die "usage: qbt prefs"
  local schema secrets
  schema=$(pref_schema_path)
  [[ -f $schema ]] || die "The settings schema is missing."
  secrets=$(pref_secret_names "$schema") || die "The settings schema is unreadable."
  local known
  known=$(jq -c '.keys | keys' "$schema") || die "The settings schema is unreadable."
  pref_read
  # Secrets by name, plus any key the schema doesn't know that sounds like
  # a password, token, secret or API key (a schema key such as
  # bdecode_token_limit keeps its value). The values go through stdin only.
  printf '%s' "$PREFS_JSON" | jq -c --arg names "$secrets" --arg known "$known" --arg re "$PREF_SECRET_NAME_RE" '
    ($names | fromjson) as $s | ($known | fromjson) as $k
    | with_entries(
        if (.key as $n | $s | index([$n]))
           or ((.key as $n | $k | index([$n]) | not) and (.key | test($re; "i")))
        then .value = {set: (.value != null and .value != "" and .value != false)}
        else . end)' 2>/dev/null || die "qBittorrent sent something unreadable"
}

# IPv4/IPv6 text, shared by pref-set's announce_ip and ban-list.
PREF_IP_JQ='
def dec_octet: "(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])";
def ipv4: test("\\A(\(dec_octet)\\.){3}\(dec_octet)\\z");
def hex16: test("\\A[0-9A-Fa-f]{1,4}\\z");
# RFC 4291 text: 8 groups, or at most 7 around one "::"; the last group
# may be a dotted IPv4 (two groups). No zone id, no brackets.
def ipv6:
  split("::") as $p
  | if ($p | length) > 2 then false
    else
      ([$p[] | if . == "" then [] else split(":") end] | add // []) as $all
      | (if ($all | length) == 0 or (($p | length) == 2 and $p[1] == "") then false
         else $all[-1] | ipv4 end) as $tail4
      | (if $tail4 then $all[:-1] else $all end) as $hex
      | (($hex | length) + (if $tail4 then 2 else 0 end)) as $n
      | ($hex | all(hex16)) and (if ($p | length) == 2 then $n <= 7 else $n == 8 end)
    end;
def hexnum: ascii_downcase | explode | reduce .[] as $c (0; . * 16 + (if $c >= 97 then $c - 87 else $c - 48 end));
# An IPv6 address (already validated when sent) as its 8 numbers, so
# 2001:DB8::1 matches the 2001:db8::1 that QHostAddress::toString stores.
def ip6_groups:
  split("::") as $p
  | [$p[] | [if . == "" then empty else split(":")[] end
             | if test("\\.") then (split(".") | map(tonumber) | (.[0] * 256 + .[1]), (.[2] * 256 + .[3]))
               else hexnum end]] as $g
  | if ($g | length) == 2 then $g[0] + [range(8 - ($g[0] | length) - ($g[1] | length)) | 0] + $g[1] else $g[0] end;
def hexstr: if . < 16 then "0123456789abcdef"[.:. + 1]
  else (. / 16 | floor | hexstr) + ("0123456789abcdef"[. % 16:. % 16 + 1]) end;
def dotted($hi; $lo): "\($hi / 256 | floor).\($hi % 256).\($lo / 256 | floor).\($lo % 256)";
# A valid address as QHostAddress::toString writes it (checked against
# Qt 6.11): IPv4 as it is (ipv4 already refuses leading zeros); IPv6
# lowercase with the first longest run of 2+ zero groups as "::", a
# mapped address as ::ffff:a.b.c.d, and one whose first 96 bits are zero
# while its 7th group is not as ::a.b.c.d.
def qt_addr:
  if ipv4 then .
  else ip6_groups as $g
  | if ($g[0:5] | all(. == 0)) and $g[5] == 65535 then "::ffff:" + dotted($g[6]; $g[7])
    elif ($g[0:6] | all(. == 0)) and $g[6] != 0 then "::" + dotted($g[6]; $g[7])
    else
      (reduce range(8) as $i ({at: -1, len: 0, run: -1, n: 0};
         if $g[$i] == 0 then (if .run < 0 then .run = $i | .n = 1 else .n += 1 end)
           | if .n > .len then .at = .run | .len = .n else . end
         else .run = -1 | .n = 0 end)) as $z
      | ($g | map(hexstr)) as $h
      | if $z.len < 2 then $h | join(":")
        else ($h[:$z.at] | join(":")) + "::" + ($h[$z.at + $z.len:] | join(":")) end
    end
  end;
'

# Validates and casts one value for one key. $other is "" for a schema key,
# or the kind of an Other key's current value (boolean, integer, number,
# string).
# Prints {error} or {sent, label, type, exact}; the value only ever
# arrives through --arg and is cast by the schema's type, never its shape.
PREF_CAST_JQ="$PREF_IP_JQ"'
def one_line: test("[\n\r]") | not;
def whole: test("\\A(0|-?[1-9][0-9]{0,9})\\z");
def sentinel_text: (.sentinels // {}) | to_entries
  | map("\(.key | if . == "" then "nothing" else . end) for \(.value)")
  | if length == 0 then "" else ", or " + join(" or ") end;
def sentinel($n): (.sentinels // {}) | has($n | tostring);
def low: . as $e | $e.min | until(. as $n | $e | sentinel($n) | not; . + 1);
def high: . as $e | $e.max | until(. as $n | $e | sentinel($n) | not; . - 1);
def range_text: "from \(low) to \(high)\(sentinel_text)";
# A sentinel matches by value too, so "-1.0" is the -1 sentinel.
def sentinel_hit($n): [(.sentinels // {}) | keys[] | select(test("\\A-?[0-9]+\\z")) | tonumber | select(. == $n)] | first;
def in_range($n): (.sentinels // {} | has($v)) or (sentinel_hit($n) != null) or ($n >= .min and $n <= .max);
# QDir::cleanPath would rewrite these, and the read-back would differ.
def clean_path: test("//|/\\./|/\\.\\./|/\\.\\.?\\z") | not;
def out($x): {sent: {($key): $x}};
(if $other == "" then .keys[$key]
 else {label: $key, type: ({boolean: "bool", integer: "integer", number: "number", string: "text"}[$other])} end) as $e
| $e
# Eng 4b D5/D10: a whole newline-joined list. Ruling EC: only the lines
# not already stored ($stored, read just before) are checked per
# tests/fixtures/list-rules-cases.json, so a line qBittorrent itself holds
# goes back as it is. An empty tracker line is a tier break; a new empty
# pattern is refused, a stored one kept.
| (if .listKind == "trackerUrl" or .listKind == "pattern" then
     ($stored | split("\n")) as $old
     | [$v | split("\n")[] | . as $l | select(any($old[]; . == $l) | not)] as $new
     | (if .listKind == "trackerUrl" then
          if all($new[]; . == "" or (test("\\A(https?|udp)://[!-~]+\\z") and (contains("|") | not) and length <= 2048))
          then null else "Use an http, https or udp tracker URL." end
        else
          first($new[] | if . == "" then "Use a pattern such as *.exe."
                         elif test("\r") then "Keep each pattern to one line." else empty end) // null
        end) as $err
     | if $err then {error: $err} else out($v) + {exact: true} end
   elif .type == "bool" then
     if $v == "true" or $v == "false" then out($v == "true") else {error: "Use true or false."} end
   elif .type == "int" or .type == "speed" then
     if ($v | whole) and in_range($v | tonumber) then
       if .step and (($v | tonumber) % .step != 0) then {error: "Use whole KiB."}
       else out($v | tonumber) end
     else {error: "Use a whole number \(range_text)."} end
   elif .type == "float" then
     if ($v | test("\\A(0|-?[1-9][0-9]{0,9})(\\.[0-9]{1,2})?\\z")) and in_range($v | tonumber)
     then out(sentinel_hit($v | tonumber) // ($v | tonumber))
     else {error: "Use a number \(range_text), with at most 2 decimals."} end
   elif .type == "integer" then
     if $v | whole then out($v | tonumber) else {error: "Use a whole number."} end
   elif .type == "number" then
     if ($v | test("\\A-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,6})?\\z")) and ($v | test("\\A-0(\\.0+)?\\z") | not)
     then out($v | tonumber)
     else {error: "Use a number."} end
   elif .type == "choice-int" then
     if ($v | whole) and ([.choices[].value] | index([$v | tonumber])) then out($v | tonumber)
     else {error: "Use one of: \([.choices[].value | tostring] | join(", "))."} end
   elif .type == "choice-string" then
     if [.choices[].value] | index([$v]) then out($v)
     else {error: "Use one of: \([.choices[].value] | join(", "))."} end
   elif .type == "time" then
     if ($v | test("\\A([01][0-9]|2[0-3]):[0-5][0-9]\\z")) then
       {sent: {(.composite.hour): ($v[0:2] | tonumber), (.composite.min): ($v[3:5] | tonumber)}}
     else {error: "Use HH:MM, from 00:00 to 23:59."} end
   elif .type == "path" then
     if $v == "" and (.sentinels // {} | has("")) then out("")
     elif ($v | one_line) and (($v | startswith("/")) or ($v | startswith("~/"))) then
       (if $v | startswith("~/") then $home + $v[1:] else $v end) as $p
       | if $p | clean_path then out($p) else {error: "Use a clean path without //, /./ or /../."} end
     else {error: "Use an absolute path or one starting with ~/\(sentinel_text)."} end
   elif .type == "text" then
     if $v | one_line | not then {error: "Keep it to one line."}
     elif $key == "announce_ip" and ($v != "" and ($v | ipv4 | not) and ($v | ipv6 | not))
     then {error: "Use an IPv4 or IPv6 address, or leave it empty."}
     elif $key == "web_ui_username" and (($v | length) < 3 or ($v | contains(":")))
     then {error: "Use at least 3 characters and no colon."}
     else out($v) end
   else {error: "OmaqBT doesn'"'"'t change this setting."} end)
| . + {label: $e.label, type: $e.type}'

# True when the re-read preferences (stdin) hold what was sent, per type
# (Ruling DI, the same rule as SettingsView.js): numbers numerically,
# strings trimmed, paths trimmed and without a trailing slash (the sent
# path already has ~/ expanded); every key of a composite. A list
# (exact == "true") must come back exactly: tiers, empty entries and a
# trailing newline included.
PREF_SAME_JQ="$PREF_IP_JQ"'
def trim_ws: sub("\\A\\s+"; "") | sub("\\s+\\z"; "");
def clean: trim_ws | if . == "/" then . else sub("/+\\z"; "") end;
($sent | fromjson) as $s | . as $p
| all($s | to_entries[]; .value as $want | $p[.key] as $got
    | if ($want | type) == "boolean" then $got == $want
      elif ($want | type) == "number" then ($got | type) == "number" and $got == $want
      elif ($got | type) != "string" then false
      elif $exact == "true" then $got == $want
      elif $type == "path" then ($got | clean) == ($want | clean)
      elif .key == "announce_ip" and ($want | contains(":")) then
        ($got | contains(":")) and ($got | ip6_groups) == ($want | ip6_groups)
      else ($got | trim_ws) == ($want | trim_ws) end)'

# True when $1 is valid UTF-8 byte for byte: bash's regex under a UTF-8
# locale, then a round trip through jq, which turns what the regex lets by
# (a UTF-16 surrogate, an overlong form, a code point past U+10FFFF) into
# U+FFFD, must give the same bytes back. The value only reaches jq through
# builtin printf into a pipe. Status 2: no UTF-8 locale to check with.
utf8_exact() {
  local loc rt
  loc=$(name_utf8_locale) || return 2
  (LC_ALL=$loc; [[ $1 =~ ^.*$ ]]) 2>/dev/null || return 1
  rt=$(printf '%s' "$1" | jq -Rrsj . 2>/dev/null; printf x)
  local LC_ALL=C
  [[ ${rt%x} == "$1" ]]
}

# Like api, but the form body comes from stdin (curl --data-binary @-), so
# a secret is never on curl's argv. Prints the HTTP status only ("000" when
# qBittorrent can't be reached); the response body and curl's own errors
# are dropped. The caller runs assert_local_base first.
api_stdin() {
  local method=$1 path=$2
  ensure_state_dir "$(dirname "$COOKIE_FILE")"
  prepare_auth
  (umask 077; curl -sS -g --noproxy '*' --max-time 5 -o /dev/null -w '%{http_code}' -X "$method" \
    -b "$COOKIE_FILE" -c "$COOKIE_FILE" "${AUTH_ARGS[@]}" -H "Content-Type: application/x-www-form-urlencoded" \
    --data-binary @- "$(base_url)$path" 2>/dev/null) || true
}

# api_try's failure reason for an api_stdin status.
api_stdin_fail() {
  if [[ $1 == 403 ]]; then
    printf '%s' "$API_KEY_REFUSED"
  elif [[ $1 =~ ^[[:digit:]]{3}$ && $1 != 000 ]]; then
    printf 'HTTP %s' "$1"
  else
    printf "couldn't reach qBittorrent"
  fi
}

# Eng 4b D2/D7: `pref-set <key> --stdin` writes one of the three writable
# secrets from stdin, and `--clear` writes "". The value is never on any
# argv or in the environment: it lives in shell variables, reaches jq and
# curl only through builtin printf into a pipe, and never passes through
# uri, api or api_try. Nothing prints it.
pref_set_secret() {
  local key=$1 mode=$2
  local schema label
  schema=$(pref_schema_path)
  [[ -f $schema ]] || die "The settings schema is missing."
  label=$(jq -r --arg k "$key" '.keys[$k] | if .secretWritable == true then .label else "" end' "$schema" 2>/dev/null) \
    || die "The settings schema is unreadable."
  [[ -n $label ]] || die "OmaqBT doesn't change secrets yet."

  local value="" rc=0
  if [[ $mode == --stdin ]]; then
    # Ruling EB, read once, raw: NUL is the delimiter, so read stops at a
    # NUL (status 0) instead of dropping it the way a newline-delimited
    # read would. A clean EOF is status 1 with every newline kept in the
    # value, and a timeout is status > 128.
    IFS= read -r -t 5 -d '' value || rc=$?
    (( rc != 0 )) || die "Use a value without NUL characters."
    (( rc < 128 )) || die "The value didn't arrive within 5 seconds."
    [[ $value != *[$'\n\r']* ]] || die "Keep it to one line."
    [[ -n $value ]] || die "Type a value, or use --clear."
    # jq would turn invalid UTF-8 into U+FFFD and write something else.
    rc=0
    utf8_exact "$value" || rc=$?
    (( rc != 2 )) || die "No UTF-8 locale is available to check the value."
    (( rc == 0 )) || die "Use valid UTF-8 text."
    # Code points, whatever the locale.
    local count
    count=$(printf '%s' "$value" | jq -Rs 'length' 2>/dev/null) || die "Couldn't check the value."
    [[ $count =~ ^[[:digit:]]+$ ]] || die "Couldn't check the value."
    (( count <= 1024 )) || die "Use at most 1024 characters."
  fi

  # The whole form body in one jq step, checked before anything is sent:
  # a jq failure mid-pipe would otherwise POST an empty body.
  local body
  body=$(printf '%s' "$value" | jq -Rrsj --arg key "$key" '"json=" + ({($key): .} | tojson | @uri)' 2>/dev/null) \
    || die "Couldn't check the value."
  [[ $body == json=* ]] || die "Couldn't check the value."
  assert_local_base
  local code
  code=$(printf '%s' "$body" | api_stdin POST "/api/v2/app/setPreferences") || true
  body=""
  if [[ $code != 200 && $code != 204 ]]; then
    # Eng 4b fix wave (B3): anything other than a plain HTTP status (000,
    # or curl never printing one at all) means curl never got a response,
    # not that qBittorrent refused the write -- the body may have already
    # gone out and applied. Only the confirm read-back below can say for
    # sure, so this reports the same "can't confirm" shape it uses.
    [[ $code =~ ^[[:digit:]]{3}$ && $code != 000 ]] \
      || die "Couldn't confirm ${label} (couldn't reach qBittorrent)"
    die "qBittorrent refused it ($(api_stdin_fail "$code"))"
  fi

  # The write may already have applied: a failed re-read can't say "refused".
  api_try GET "/api/v2/app/preferences" || die "Couldn't confirm ${label} (${API_FAIL})"
  PREFS_JSON=$API_BODY
  printf '%s' "$PREFS_JSON" | jq -e 'type == "object"' >/dev/null 2>&1 \
    || die "Couldn't confirm ${label} (qBittorrent sent something unreadable)"
  # Exact, inside jq: the stored value arrives on stdin, the sent one on
  # fd 3, and jq prints only true or false.
  local same
  same=$(printf '%s' "$PREFS_JSON" | jq -r --arg key "$key" --rawfile v /dev/fd/3 '.[$key] == $v' 3< <(printf '%s' "$value") 2>/dev/null) \
    || same=false
  PREFS_JSON="" API_BODY="" value=""
  [[ $same == true ]] || die "qBittorrent ignored ${label}"
  printf '%s\n' '{"ok":true}'
}

# Confirms are window-only by design (eng D4): qbt's gates are the locks and refusals below.
cmd_pref_set() {
  local api_error_detail=code
  local usage="usage: qbt pref-set <key> (-- <value> | --stdin | --clear)"
  local mode
  if [[ $# -eq 3 && $2 == -- ]]; then
    mode=value
  elif [[ $# -eq 2 && ( $2 == --stdin || $2 == --clear ) ]]; then
    mode=$2
  else
    die "$usage"
  fi
  local key=$1 value=${3:-}
  (
    LC_ALL=C
    [[ $key =~ ^[A-Za-z][A-Za-z0-9_]{0,127}$ ]]
  ) || die "qBittorrent has no setting called that."
  pref_matches "$key" "${PREF_LOCKED_VPN[@]}" && die "Set by OmaqBT's setup."
  pref_matches "$key" "${PREF_LOCKED_WEBUI[@]}" && die "OmaqBT needs this as it is."
  [[ $key == "$PREF_OMAQBT_READ_ONLY" ]] && die "$PREF_OMAQBT_READ_ONLY_SENTENCE"
  # Like the locks, before the schema: no schema can unlock a secret.
  [[ $key == web_ui_api_key ]] && die "qBittorrent doesn't let this be changed."
  if [[ $mode != value ]]; then
    if pref_matches "$key" "${PREF_SECRET_WRITABLE[@]}"; then
      pref_set_secret "$key" "$mode"
      return
    fi
    pref_matches "${key,,}" "${PREF_SECRET_REFUSED[@]}" && die "OmaqBT won't change this setting."
    die "Only the proxy, Dynamic DNS and SMTP passwords take --stdin or --clear."
  fi
  pref_matches "$key" "${PREF_SECRET_WRITABLE[@]}" && die "Send this password with --stdin, never as an argument."
  pref_matches "${key,,}" '*password*' && die "OmaqBT won't change this setting."

  local schema
  schema=$(pref_schema_path)
  [[ -f $schema ]] || die "The settings schema is missing."
  local flags
  flags=$(jq -r --arg k "$key" '
    .keys[$k] as $e
    | if $e == null then "other"
      elif $e.readOnly then "readOnly" elif $e.secret or $e.type == "secret" then "secret"
      elif $e.hidden then "hidden" elif $e.deferred then "deferred"
      elif $e.locked then "locked"
      elif $e.listKind == "trackerUrl" or $e.listKind == "pattern" then "list"
      elif $e.multiline then "multiline" else "ok" end' "$schema") || die "The settings schema is unreadable."
  case $flags in
    readOnly) die "qBittorrent doesn't let this be changed." ;;
    secret) die "OmaqBT doesn't change secrets yet." ;;
    hidden) die "OmaqBT doesn't change this setting." ;;
    deferred) die "OmaqBT doesn't change this setting yet." ;;
    # A multi-line key that isn't a list OmaqBT edits (none in the schema
    # today: tests/settings-schema.test.js pins that). Ruling DH's words.
    multiline) die "Editing multi-line settings arrives in 4b." ;;
    # A schema lock the hardcoded lists above don't cover: refuse anyway.
    locked) die "OmaqBT needs this as it is." ;;
    ok|other|list) ;;
    *) die "The settings schema is unreadable." ;;
  esac

  # jq replaces invalid UTF-8 with U+FFFD, which would send (and read back)
  # something other than what was typed.
  local utf8=0
  utf8_exact "$value" || utf8=$?
  (( utf8 != 2 )) || die "No UTF-8 locale is available to check the value."
  (( utf8 == 0 )) || die "Use valid UTF-8 text."

  local other=""
  if [[ $flags == other ]]; then
    # Ruling DL: case-insensitive, so Proxy_foo or WEB_UI_x is refused too.
    pref_matches "${key,,}" "${PREF_OTHER_REFUSED[@]}" && die "OmaqBT won't change this setting."
    pref_read
    # A whole number stays whole: an integer's Other value refuses decimals.
    other=$(printf '%s' "$PREFS_JSON" | jq -r --arg k "$key" '
      if has($k) | not then "missing"
      elif (.[$k] | type) == "number" and .[$k] == (.[$k] | floor) then "integer"
      else .[$k] | type end' 2>/dev/null) \
      || die "qBittorrent sent something unreadable"
    case $other in
      missing) die "qBittorrent has no setting called ${key}." ;;
      boolean|integer|number|string) ;;
      *) die "OmaqBT can only change on/off, number and text settings." ;;
    esac
  fi

  local cast err
  # Ruling EC: a list's stored value, read just before the cast.
  local stored=""
  if [[ $flags == list ]]; then
    pref_read
    stored=$(printf '%s' "$PREFS_JSON" | jq -r --arg k "$key" '.[$k] | if type == "string" then . else "" end' 2>/dev/null \
      && printf x) || true
    [[ $stored == *$'\n'x ]] || die "qBittorrent sent something unreadable"
    stored=${stored%$'\n'x}
  fi
  cast=$(jq -c --arg key "$key" --arg v "$value" --arg other "$other" --arg home "${HOME%/}" --arg stored "$stored" \
    "$PREF_CAST_JQ" "$schema" 2>/dev/null) \
    || die "The settings schema is unreadable."
  err=$(jq -r '.error // empty' <<<"$cast")
  [[ -z $err ]] || die "$err"
  local sent label type exact
  sent=$(jq -c '.sent' <<<"$cast")
  label=$(jq -r '.label' <<<"$cast")
  type=$(jq -r '.type' <<<"$cast")
  exact=$(jq -r '.exact // false' <<<"$cast")

  local body="json=$(uri "$sent")"
  if [[ $flags == list ]]; then
    # Eng 4b fix wave (B2): a whole list's URI-encoded body can exceed a
    # single curl argument's limit (MAX_ARG_STRLEN, ~128 KiB); send it on
    # stdin, the way a secret's body already goes (pref_set_secret above).
    assert_local_base
    local code
    code=$(printf '%s' "$body" | api_stdin POST "/api/v2/app/setPreferences") || true
    body=""
    [[ $code == 200 || $code == 204 ]] || die "qBittorrent refused it ($(api_stdin_fail "$code"))"
  else
    api_try POST "/api/v2/app/setPreferences" "$body" || die "qBittorrent refused it (${API_FAIL})"
  fi
  # The write may already have applied: a failed re-read can't say "refused".
  api_try GET "/api/v2/app/preferences" || die "Couldn't confirm ${label} (${API_FAIL})"
  PREFS_JSON=$API_BODY
  printf '%s' "$PREFS_JSON" | jq -e 'type == "object"' >/dev/null 2>&1 \
    || die "Couldn't confirm ${label} (qBittorrent sent something unreadable)"
  printf '%s' "$PREFS_JSON" | jq -e --arg type "$type" --arg exact "$exact" --rawfile sent /dev/fd/3 \
    "$PREF_SAME_JQ" 3< <(printf '%s' "$sent") >/dev/null 2>&1 \
    || die "qBittorrent ignored ${label}"
  printf '%s\n' '{"ok":true}'
}

# Eng 4b D3/D11: `qbt ban-list add|remove <ip>` changes one address in
# banned_IPs. It re-reads the list just before writing, compares every
# address in QHostAddress's form (what 5.2.3 stores: sessionimpl.cpp:4167),
# and after the write reports a list that isn't what it wrote -- never
# restoring anything. An address already banned (add) or not banned
# (remove) writes nothing. qBittorrent has no compare-and-set: a change
# made elsewhere between the read and the write is overwritten, and one
# made after the write is reported.
# One jq call between the read and the write (Ruling EE): it checks the
# read, finds the address and builds the form body. Four lines out:
# unreadable|invalid|noop|send, the address as compared, the body, and
# the sent list as JSON. Ruling ED: remove also takes an address exactly
# as stored, even one add refuses (a zone id from qBittorrent's own UI).
BAN_PLAN_JQ="$PREF_IP_JQ"'
def addr: . != "" and (ipv4 or ipv6);
if type != "object" or (.banned_IPs | type) != "string" then "unreadable\n\n\n\n"
else
  (.banned_IPs | split("\n") | map(select(. != ""))) as $cur
  | ($cur | map(if addr then qt_addr else . end)) as $curn
  | (if $ip | addr then $ip | qt_addr
     elif $op == "remove" and any($cur[]; . == $ip) then $ip
     else null end) as $n
  | if $n == null then "invalid\n\n\n\n"
    else
      (if $op == "add" then (if any($curn[]; . == $n) then null else $cur + [$n] end)
       elif any($curn[]; . == $n) then [range($cur | length) | select($curn[.] != $n) | $cur[.]]
       else null end) as $new
      | if $new == null then "noop\n\($n)\n\n\n"
        else ($new | join("\n")) as $send
          | "send\n\($n)\n" + "json=" + ({banned_IPs: $send} | tojson | @uri) + "\n" + ($send | tojson) + "\n"
        end
    end
end'
BAN_CHECK_JQ="$PREF_IP_JQ"'
# Entries qbt would refuse came from qBittorrent itself (Qt keeps a zone
# id, for one), so they are carried as they are on both sides.
def norm: split("\n") | map(select(. != "") | if ipv4 or ipv6 then qt_addr else . end) | unique;
if (.banned_IPs | type) != "string" then "unreadable"
else (.banned_IPs | norm) as $got
  | if $got == ($sent | fromjson | norm) then "ok"
    elif $op == "add" and (any($got[]; . == $ip) | not) then "missing"
    elif $op == "remove" and any($got[]; . == $ip) then "present"
    else "changed" end
end'

cmd_ban_list() {
  local api_error_detail=code
  [[ $# -eq 2 && ( $1 == add || $1 == remove ) ]] || die "usage: qbt ban-list add|remove <ip>"
  local op=$1 ip=$2
  # add: announce_ip's rule without the empty case, never trimmed
  # (tests/fixtures/list-rules-cases.json, kind ip), before any request.
  # remove: the same, or a line exactly as stored (checked in the plan).
  [[ -n $ip && $ip != *$'\n'* ]] || die "Use an IPv4 or IPv6 address."
  if [[ $op == add ]]; then
    local valid
    valid=$(jq -nr --arg v "$ip" "$PREF_IP_JQ"'$v | ipv4 or ipv6' 2>/dev/null) || valid=false
    [[ $valid == true ]] || die "Use an IPv4 or IPv6 address."
  fi

  api_try GET "/api/v2/app/preferences" || die "qBittorrent refused it (${API_FAIL})"
  local plan status="" norm="" body="" sent=""
  plan=$(printf '%s' "$API_BODY" | jq -rj --arg ip "$ip" --arg op "$op" "$BAN_PLAN_JQ" 2>/dev/null) || plan=unreadable
  { IFS= read -r status; IFS= read -r norm; IFS= read -r body; IFS= read -r sent; } < <(printf '%s\n' "$plan") || true
  case $status in
    send)
      # Eng 4b fix wave (B2): the URI-encoded whole ban list can exceed a
      # single curl argument's limit (MAX_ARG_STRLEN, ~128 KiB); send it on
      # stdin, the way a secret's body already goes.
      assert_local_base
      local code
      code=$(printf '%s' "$body" | api_stdin POST "/api/v2/app/setPreferences") || true
      body=""
      [[ $code == 200 || $code == 204 ]] || die "qBittorrent refused it ($(api_stdin_fail "$code"))"
      ;;
    noop) printf '%s\n' '{"ok":true}'; return ;;
    invalid) die "Use an IPv4 or IPv6 address." ;;
    *) die "qBittorrent sent something unreadable" ;;
  esac

  api_try GET "/api/v2/app/preferences" || die "Couldn't confirm Banned IPs (${API_FAIL})"
  PREFS_JSON=$API_BODY
  printf '%s' "$PREFS_JSON" | jq -e 'type == "object"' >/dev/null 2>&1 \
    || die "Couldn't confirm Banned IPs (qBittorrent sent something unreadable)"
  local verdict
  verdict=$(printf '%s' "$PREFS_JSON" | jq -r --arg ip "$norm" --arg op "$op" --rawfile sent /dev/fd/3 \
    "$BAN_CHECK_JQ" 3< <(printf '%s' "$sent") 2>/dev/null) || verdict=unreadable
  case $verdict in
    ok) printf '%s\n' '{"ok":true}' ;;
    missing) die "qBittorrent didn't ban ${norm}." ;;
    present) die "qBittorrent still bans ${norm}." ;;
    changed) die "The ban list changed while OmaqBT saved it; check it." ;;
    *) die "Couldn't confirm Banned IPs (qBittorrent sent something unreadable)" ;;
  esac
}

# ---------------------------------------------------------------------------
# Slice 5a: `qbt search` and `qbt search-plugin`, exactly per
# tests/fixtures/search-contract.md. Every rule and message comes from
# tests/fixtures/search-rules-cases.json (the pageLink and magnetHash rules
# also in tests/fixtures/link-rules-cases.json), enforced by lib/searchrules.py
# (URLs split by the contract's text rule, never a URL library; Ruling FB).
# Arguments are checked before any request; every value reaches curl on
# stdin; failures report codes only (api_error_detail=code); response
# bodies stay in memory and reach jq through printf pipes.
# ---------------------------------------------------------------------------

SEARCH_USAGE="usage: qbt search start|stop|delete|add"
SEARCH_PLUGIN_USAGE="usage: qbt search-plugin list|install <url>|uninstall <name>|enable <name> on|off|update"

# One case-file rule on a value sent to lib/searchrules.py on stdin (the
# addLink plugin after a NUL, which argv can't carry). On success sets
# RULE_NORM and RULE_HOST; a refusal dies with the rule's own message.
search_rule() {
  local kind=$1 out rc=0
  shift
  if [[ $kind == addLink && $# -eq 2 ]]; then
    out=$(printf '%s\0%s' "$1" "$2" | python3 "$(qbt_lib_dir)/searchrules.py" "$kind" 2>/dev/null) || rc=$?
  else
    out=$(printf '%s' "$1" | python3 "$(qbt_lib_dir)/searchrules.py" "$kind" 2>/dev/null) || rc=$?
  fi
  if (( rc != 0 )); then
    (( rc == 1 )) && [[ -n $out ]] && die "$out"
    die "Couldn't check the value."
  fi
  RULE_NORM=${out%%$'\t'*}
  RULE_HOST=${out#*$'\t'}
}

# @uri of a value that goes through a pipe, never jq's argv.
uri_stdin() {
  printf '%s' "$1" | jq -Rsrj '@uri'
}

# GET /search/plugins into PLUGINS_JSON (an array of objects), else dies
# with the contract's sentence.
search_plugins_read() {
  api_try GET "/api/v2/search/plugins" || die "Couldn't read the search plugins (${API_FAIL})"
  PLUGINS_JSON=$API_BODY
  printf '%s' "$PLUGINS_JSON" | jq -e 'type == "array" and all(.[]; type == "object")' >/dev/null 2>&1 \
    || die "qBittorrent sent something unreadable"
}

# "1:<version>" when PLUGINS_JSON lists $1, else "0:". $1 passed the
# plugin-name rule.
search_plugin_version() {
  printf '%s' "$PLUGINS_JSON" | jq -rj --arg n "$1" \
    'first(.[] | select(.name == $n) | "1:" + (.version | if type == "string" then . else tojson end)) // "0:"'
}

search_require_plugin() {
  local v
  v=$(search_plugin_version "$1")
  [[ $v == 1:* ]] || die "There's no plugin named $1."
}

search_id_path() {
  printf '%s/search.id' "$STATE_DIR"
}

# $STATE_DIR/search.id: mode 0600, the id and a newline. Written to a
# temporary name and moved into place, so a planted symlink at search.id is
# replaced, never followed. The temporary name is opened with noclobber:
# anything already there (a planted file, or a symlink to one or to
# nowhere) fails the write rather than being written through, and only a
# regular file of our own is moved into place. A failed write still lets
# start print the id: the window deletes its job itself (the final read,
# the window closing).
search_id_write() {
  local f tmp
  f=$(search_id_path)
  (ensure_state_dir "$STATE_DIR") >/dev/null 2>&1 || return 0
  tmp="$f.$$.tmp"
  if (umask 077; set -o noclobber; printf '%s\n' "$1" >"$tmp") 2>/dev/null; then
    # noclobber still opens an existing non-regular target (a FIFO, a
    # device) without O_EXCL; never move such a thing into place.
    [[ -f $tmp && ! -L $tmp ]] || return 0
    mv -f -- "$tmp" "$f" 2>/dev/null || rm -f -- "$tmp" 2>/dev/null || true
  fi
}

# The id a regular search.id holds, or nothing.
search_id_read() {
  local f old=""
  f=$(search_id_path)
  [[ -f $f && ! -L $f ]] || return 0
  IFS= read -r old <"$f" 2>/dev/null || true
  printf '%s' "$old"
}

# Step 3 (OV14): a job search.id still names (a crash leftover, or the job
# a new / replaces) is deleted first; a 404 means it's already gone. Any
# other failure keeps the file, so the next start tries again.
search_drop_stale() {
  local f old
  f=$(search_id_path)
  [[ -e $f || -L $f ]] || return 0
  old=$(search_id_read)
  if [[ $old =~ ^[[:digit:]]{1,10}$ && $old != 0* ]] && (( 10#$old <= 2147483647 )); then
    if ! api_try_stdin POST "/api/v2/search/delete" < <(printf 'id=%s' "$old"); then
      [[ $API_FAIL == "HTTP 404" ]] || die "qBittorrent refused it (${API_FAIL})"
    fi
  fi
  rm -f -- "$f" 2>/dev/null || true
}

search_start() {
  local usage="usage: qbt search start --pattern <p> --category <c>"
  local pattern="" category="" have_pattern=0 have_category=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --pattern)
        [[ $# -ge 2 && $have_pattern == 0 ]] || die "$usage"
        pattern=$2 have_pattern=1
        shift 2 ;;
      --category)
        [[ $# -ge 2 && $have_category == 0 ]] || die "$usage"
        category=$2 have_category=1
        shift 2 ;;
      *) die "$usage" ;;
    esac
  done
  [[ $have_pattern == 1 && $have_category == 1 ]] || die "$usage"
  search_rule pattern "$pattern"
  search_rule category "$category"
  assert_local_base

  # OV8: searches use only the enabled plugins.
  search_plugins_read
  printf '%s' "$PLUGINS_JSON" | jq -e 'any(.[]; .enabled == true)' >/dev/null 2>&1 \
    || die "All search plugins are off."

  search_drop_stale

  local enc
  enc=$(uri_stdin "$pattern") || die "Couldn't check the value."
  if ! api_try_stdin POST "/api/v2/search/start" \
      < <(printf 'pattern=%s&category=%s&plugins=enabled' "$enc" "$category"); then
    [[ $API_FAIL == "HTTP 409" ]] || die "qBittorrent refused it (${API_FAIL})"
    # OV6: one code, two causes; the jobs' status tells them apart.
    api_try GET "/api/v2/search/status" || die "qBittorrent refused it (HTTP 409)"
    local running
    running=$(printf '%s' "$API_BODY" \
      | jq -r 'if type == "array" then [.[] | select(type == "object" and .status == "Running")] | length else error end' \
      2>/dev/null) || running=""
    [[ $running =~ ^[[:digit:]]{1,6}$ ]] || die "qBittorrent refused it (HTTP 409)"
    (( 10#$running >= 5 )) && die "qBittorrent is running 5 searches; stop one first."
    die "Search needs Python on this machine."
  fi

  local id
  id=$(printf '%s' "$API_BODY" | jq -r 'if type == "object" and (.id | type) == "number"
      and .id == (.id | floor) and .id >= 1 and .id <= 2147483647 then .id else empty end' 2>/dev/null) || id=""
  [[ $id =~ ^[[:digit:]]{1,10}$ && $id != 0* ]] || die "qBittorrent sent something unreadable"
  search_id_write "$id"
  printf '{"id":%s}\n' "$id"
}

# stop or delete <id>. A 404 is fine: the job is already gone, and cleanup
# must be idempotent. delete forgets search.id when it names <id>.
search_stop_delete() {
  local action=$1
  shift
  [[ $# -eq 1 ]] || die "usage: qbt search $action <id>"
  search_rule searchId "$1"
  assert_local_base
  local id=$1
  if ! api_try_stdin POST "/api/v2/search/$action" < <(printf 'id=%s' "$id"); then
    [[ $API_FAIL == "HTTP 404" ]] || die "qBittorrent refused it (${API_FAIL})"
  fi
  if [[ $action == delete && $(search_id_read) == "$id" ]]; then
    rm -f -- "$(search_id_path)" 2>/dev/null || true
  fi
  printf '%s\n' '{"ok":true}'
}

# OV3/OV5: a magnet, or an https .torrent without a plugin, goes through
# torrents/add (the request `qbt add <link>` makes); an https link with its
# plugin goes through search/downloadTorrent. via:"plugin" only means the
# request was accepted (downloadTorrent answers an empty 200 at once).
search_add() {
  # --stdin (the link on stdin, in place of <link>) is how the widget calls it.
  local usage="usage: qbt search add <link> [<plugin>]"
  [[ $# -eq 1 || $# -eq 2 ]] || die "$usage"
  local link=$1 plugin=${2:-}
  # A private plugin's link can carry a passkey: the widget sends it here.
  if [[ $link == --stdin ]]; then
    stdin_fields 1 "$usage"
    link=${STDIN_FIELDS[0]}
  fi
  if [[ $# -eq 2 ]]; then
    search_rule addLink "$link" "$plugin"
  else
    search_rule addLink "$link"
  fi
  assert_local_base
  local via=$RULE_NORM enc
  enc=$(uri_stdin "$link") || die "Couldn't check the value."
  if [[ $via == plugin ]]; then
    search_plugins_read
    search_require_plugin "$plugin"
    api_try_stdin POST "/api/v2/search/downloadTorrent" \
      < <(printf 'torrentUrl=%s&pluginName=%s' "$enc" "$plugin") || die "qBittorrent refused it (${API_FAIL})"
  else
    # B1: an https .torrent is pending (202) until qBittorrent fetches it.
    local api_accept_202=1
    api_try_stdin POST "/api/v2/torrents/add" < <(printf 'urls=%s' "$enc") \
      || die "qBittorrent refused it (${API_FAIL})"
  fi
  printf '{"ok":true,"via":"%s"}\n' "$via"
}

cmd_search() {
  local api_error_detail=code
  case ${1:-} in
    start) shift; search_start "$@" ;;
    stop|delete) search_stop_delete "$@" ;;
    add) shift; search_add "$@" ;;
    *) die "$SEARCH_USAGE" ;;
  esac
}

search_plugin_list() {
  assert_local_base
  search_plugins_read
  printf '%s' "$PLUGINS_JSON" | jq -c 'map({name, fullName, version, enabled, url, supportedCategories})'
}

# The microseconds since the epoch (EPOCHREALTIME without its separator,
# which follows the locale).
search_now_us() {
  printf '%s' "${EPOCHREALTIME//[!0-9]/}"
}

# A3/OV4: install, then re-read every 0.5 s for up to 20 s until the name
# (qBittorrent's naming: the URL's last path segment without .py) is
# listed with a version other than before. QBT_SEARCH_INSTALL_WAIT (whole
# seconds, tests only) shortens the wait.
search_plugin_install() {
  search_rule pluginUrl "$1"
  local name=$RULE_NORM enc before after fail=""
  assert_local_base
  search_plugins_read
  before=$(search_plugin_version "$name")
  enc=$(uri_stdin "$1") || die "Couldn't check the value."
  api_try_stdin POST "/api/v2/search/installPlugin" < <(printf 'sources=%s' "$enc") \
    || die "qBittorrent refused it (${API_FAIL})"

  local wait=${QBT_SEARCH_INSTALL_WAIT:-20}
  [[ $wait =~ ^[[:digit:]]{1,3}$ ]] || wait=20
  local deadline=$(( $(search_now_us) + 10#$wait * 1000000 ))
  after=$before
  while true; do
    sleep 0.5
    if api_try GET "/api/v2/search/plugins"; then
      PLUGINS_JSON=$API_BODY
      if printf '%s' "$PLUGINS_JSON" | jq -e 'type == "array" and all(.[]; type == "object")' >/dev/null 2>&1; then
        fail=""
        after=$(search_plugin_version "$name")
        if [[ $after == 1:* && $after != "$before" ]]; then
          printf '%s\n' '{"ok":true}'
          return 0
        fi
      else
        fail=unreadable
      fi
    else
      fail=$API_FAIL
    fi
    (( $(search_now_us) < deadline )) || break
  done
  [[ $fail == unreadable ]] && die "qBittorrent sent something unreadable"
  [[ -n $fail ]] && die "Couldn't read the search plugins (${fail})"
  [[ $before == 1:* && $after == "$before" ]] && die "$name v${before#1:} is already installed."
  die "Couldn't confirm the install of $name."
}

search_plugin_uninstall() {
  search_rule pluginName "$1"
  assert_local_base
  local name=$1
  search_plugins_read
  search_require_plugin "$name"
  api_try_stdin POST "/api/v2/search/uninstallPlugin" < <(printf 'names=%s' "$name") \
    || die "qBittorrent refused it (${API_FAIL})"
  search_plugins_read
  [[ $(search_plugin_version "$name") == 0: ]] || die "Couldn't confirm the uninstall of $name."
  printf '%s\n' '{"ok":true}'
}

search_plugin_enable() {
  search_rule pluginName "$1"
  local name=$1 want=false
  assert_local_base
  [[ $2 == on ]] && want=true
  search_plugins_read
  search_require_plugin "$name"
  api_try_stdin POST "/api/v2/search/enablePlugin" < <(printf 'names=%s&enable=%s' "$name" "$want") \
    || die "qBittorrent refused it (${API_FAIL})"
  search_plugins_read
  local now
  now=$(printf '%s' "$PLUGINS_JSON" | jq -rj --arg n "$name" 'first(.[] | select(.name == $n) | if .enabled == true then "true" else "false" end) // "gone"' 2>/dev/null) \
    || now=""
  if [[ $now != "$want" ]]; then
    [[ $want == true ]] && die "Couldn't confirm $name is on."
    die "Couldn't confirm $name is off."
  fi
  printf '%s\n' '{"ok":true}'
}

# A3: no version promise; qBittorrent checks and installs asynchronously.
search_plugin_update() {
  assert_local_base
  api_try POST "/api/v2/search/updatePlugins" || die "qBittorrent refused it (${API_FAIL})"
  search_plugins_read
  printf '%s\n' '{"ok":true}'
}

cmd_search_plugin() {
  local api_error_detail=code
  case "${1:-}:$#" in
    list:1) search_plugin_list ;;
    install:2) search_plugin_install "$2" ;;
    uninstall:2) search_plugin_uninstall "$2" ;;
    enable:3)
      [[ $3 == on || $3 == off ]] || die "$SEARCH_PLUGIN_USAGE"
      search_plugin_enable "$2" "$3" ;;
    update:1) search_plugin_update ;;
    *) die "$SEARCH_PLUGIN_USAGE" ;;
  esac
}

# ---------------------------------------------------------------------------
# Slice 5b1: `qbt rss`, exactly per tests/fixtures/rss-contract.md. Every
# rule and message comes from tests/fixtures/rss-rules-cases.json, enforced
# by lib/rssrules.py (5b0's lib/linkrules.py underneath); lib/rssitems.py
# reads qBittorrent's feed tree. Every value arrives on stdin, NUL-separated
# (argv holds only the subcommand), and reaches python, jq and curl on
# stdin too. Values are checked before any request; every write is a POST
# and every write but `add` reads rss/items back; failures report codes
# only, except the three 409s passed through in plain words. Response
# bodies stay in shell variables and reach python through printf pipes.
# ---------------------------------------------------------------------------

RSS_USAGE="usage: qbt rss items|article|error|add-feed|add-folder|rename|remove|refresh|mark-read|add"
RSS_FEED_GONE="That feed is gone."
RSS_FOLDER_GONE="That folder is gone."
RSS_ARTICLE_GONE="That article is gone."
RSS_FEED_DUP="That feed is already added."
RSS_UNCONFIRMED_RENAME="Couldn't confirm the rename."
RSS_UNCONFIRMED_READ="Couldn't confirm the articles were marked read."

rss_usage() {
  printf '%s\n' "$RSS_USAGE" >&2
  exit 2
}

# Reads stdin to EOF into RSS_FIELDS, split on NUL: no trailing NUL (a
# trailing one is one more, empty, field), and an empty stdin is one empty
# field. Anything but exactly $1 fields is the usage line.
rss_fields() {
  local want=$1 f=""
  RSS_FIELDS=()
  while IFS= read -r -d '' f; do
    RSS_FIELDS+=("$f")
  done
  RSS_FIELDS+=("$f")
  (( ${#RSS_FIELDS[@]} == want )) || rss_usage
}

# The last `\`-separated segment of a path (for messages).
rss_name_of() { printf '%s' "${1##*\\}"; }

# RSS_PARENT: everything before the last `\` ("" at the root). A variable,
# never a command substitution, which would drop trailing newlines.
rss_parent_of() {
  RSS_PARENT=""
  if [[ $1 == *\\* ]]; then RSS_PARENT=${1%\\*}; fi
}

# One rule of lib/rssrules.py on a value sent on stdin (hasTorrent: two
# values). Sets RULE_NORM; a refusal dies with the rule's own message.
rss_rule() {
  local kind=$1 out rc=0
  shift
  if [[ $kind == hasTorrent ]]; then
    out=$(printf '%s\0%s' "$1" "$2" | python3 "$(qbt_lib_dir)/rssrules.py" "$kind" 2>/dev/null) || rc=$?
  else
    out=$(printf '%s' "$1" | python3 "$(qbt_lib_dir)/rssrules.py" "$kind" 2>/dev/null) || rc=$?
  fi
  if (( rc != 0 )); then
    (( rc == 1 )) && [[ -n $out ]] && die "$out"
    die "Couldn't check the value."
  fi
  RULE_NORM=$out
}

# The name rule on the segment a command creates (the last one of $1): a
# refusal is the rule's message, and a segment the rule would change (a Qt
# space at either end) is the usage line, since the window always sends
# trimmed names. Existing segments are never checked (qBittorrent names a
# feed after its channel title, untrimmed).
rss_new_segment() {
  local seg=${1##*\\}
  rss_rule name "$seg"
  [[ $RULE_NORM == "$seg" ]] || rss_usage
}

# GET rss/items?withData=true into RSS_TREE, else dies.
rss_read_tree() {
  api_try GET "/api/v2/rss/items?withData=true" || die "qBittorrent refused it (${API_FAIL})"
  RSS_TREE=$API_BODY
}

# lib/rssitems.py <mode> with the NUL-joined values $2... on stdin (the
# last is usually RSS_TREE). Prints its answer; an unreadable body dies.
rss_items_py() {
  local mode=$1 out rc=0
  shift
  local IFS=
  out=$( { printf '%s' "$1"; shift; (( $# == 0 )) || printf '\0%s' "$@"; } \
    | python3 "$(qbt_lib_dir)/rssitems.py" "$mode" 2>/dev/null) || rc=$?
  (( rc == 4 )) && die "qBittorrent sent something unreadable"
  (( rc == 3 )) && { RSS_PY_RC=3; return 0; }
  (( rc == 0 )) || die "qBittorrent sent something unreadable"
  RSS_PY_RC=0
  RSS_PY_OUT=$out
}

# RSS_KIND: "feed", "folder" or "none" for a path in RSS_TREE ("" is the
# root folder). Never in a command substitution, so an unreadable tree
# ends the command.
rss_kind() {
  rss_items_py kind "$1" "$RSS_TREE"
  RSS_KIND=$RSS_PY_OUT
}

# POST a form body read from stdin (feed it with `< <(printf ...)`). The
# body stays in memory: a 409's text lands in RSS_409 for the three plain
# words below and is never printed; any other failure sets API_FAIL to a
# code or a short reason. $2 = 1 takes a 202 (torrents/add of a URL
# qBittorrent must download first) as success.
rss_post() {
  local path=$1 accept_202=${2:-0} out code resp
  assert_local_base
  ensure_state_dir "$(dirname "$COOKIE_FILE")"
  prepare_auth
  out=$(umask 077; curl -sS -g --noproxy '*' --max-time 5 -w '\n%{http_code}' -X POST \
    -b "$COOKIE_FILE" -c "$COOKIE_FILE" "${AUTH_ARGS[@]}" -H "Content-Type: application/x-www-form-urlencoded" \
    --data-binary @- "$(base_url)$path" 2>/dev/null) || true
  if [[ $out == *$'\n'* ]]; then
    code=${out##*$'\n'}
    resp=${out%$'\n'*}
  else
    code=$out
    resp=""
  fi
  RSS_409="" API_FAIL=""
  [[ $code =~ ^[[:digit:]]{3}$ ]] || code=000
  [[ $code == 202 && $accept_202 == 1 ]] && code=200
  case $code in
    200|204) return 0 ;;
    409) RSS_409=$resp API_FAIL="HTTP 409" ;;
    403) API_FAIL="$API_KEY_REFUSED" ;;
    000) API_FAIL="couldn't reach qBittorrent" ;;
    *) API_FAIL="HTTP $code" ;;
  esac
  return 1
}

# A failed write: qBittorrent's 409 bodies end in ": <path>." (rss_session.cpp
# :156/:434/:439), so each is matched on its prefix. $1 names the item.
rss_write_failed() {
  local name=$1
  if [[ $API_FAIL == "HTTP 409" ]]; then
    case $RSS_409 in
      "RSS feed with given URL already exists"*) die "$RSS_FEED_DUP" ;;
      "RSS item with given path already exists"*) die "There's already a feed or folder called ${name} there." ;;
      "Parent folder doesn't exist"*) die "$RSS_FOLDER_GONE" ;;
    esac
  fi
  die "qBittorrent refused it (${API_FAIL})"
}

# A JSON line {"ok":true,"path":<path>} (the path through jq's stdin).
rss_ok_path() {
  printf '%s' "$1" | jq -Rsc '{ok: true, path: .}'
}

rss_items() {
  local tree out rc=0
  assert_local_base
  rss_read_tree
  tree=$RSS_TREE
  api_try GET "/api/v2/app/preferences" || die "qBittorrent refused it (${API_FAIL})"
  out=$(printf '%s\0%s' "$tree" "$API_BODY" | python3 "$(qbt_lib_dir)/rssitems.py" flatten 2>/dev/null) || rc=$?
  (( rc == 0 )) || die "qBittorrent sent something unreadable"
  printf '%s\n' "$out"
}

rss_article() {
  rss_fields 2
  local path=${RSS_FIELDS[0]} guid=${RSS_FIELDS[1]}
  assert_local_base
  rss_read_tree
  rss_items_py article "$path" "$guid" "$RSS_TREE"
  (( RSS_PY_RC == 0 )) || die "$RSS_ARTICLE_GONE"
  printf '%s\n' "$RSS_PY_OUT"
}

# D6/OV13: the reason a failing feed's refresh gave, from log/main's
# warnings, cached in $STATE_DIR/rss-errors.json (0600, written by
# rssitems.py to a fresh name and moved into place). log/main is asked from
# one below the stored lastId, so the row lastId names comes back while the
# log still holds it; a reply without it means qBittorrent restarted, and
# the whole log is read again.
rss_error() {
  rss_fields 1
  local url=${RSS_FIELDS[0]} state since log full=""
  assert_local_base
  ensure_state_dir "$STATE_DIR"
  state="$STATE_DIR/rss-errors.json"
  since=$(python3 "$(qbt_lib_dir)/rssitems.py" error-since "$state" 2>/dev/null) || since=-1
  [[ $since =~ ^-?[[:digit:]]{1,15}$ ]] || since=-1
  local q="/api/v2/log/main?normal=false&info=false&warning=true&critical=false&last_known_id="
  api_try GET "$q$since" || die "qBittorrent refused it (${API_FAIL})"
  log=$API_BODY
  local restarted rc=0
  restarted=$(printf '%s' "$log" | python3 "$(qbt_lib_dir)/rssitems.py" error-restarted "$state" 2>/dev/null) || rc=$?
  (( rc == 0 )) || die "qBittorrent sent something unreadable"
  if [[ $restarted == yes ]]; then
    api_try GET "${q}-1" || die "qBittorrent refused it (${API_FAIL})"
    log=$API_BODY
    full=full
  fi
  rss_read_tree
  local out
  rc=0
  out=$(printf '%s\0%s\0%s\0%s' "$url" "$RSS_TREE" "$log" "$full" \
    | python3 "$(qbt_lib_dir)/rssitems.py" error "$state" 2>/dev/null) || rc=$?
  (( rc == 0 )) || die "qBittorrent sent something unreadable"
  printf '%s\n' "$out"
}

rss_add_feed() {
  rss_fields 2
  local url=${RSS_FIELDS[0]} path=${RSS_FIELDS[1]} name enc_url enc_path
  rss_rule feedUrl "$url"
  rss_new_segment "$path"
  name=$(rss_name_of "$path")
  assert_local_base
  enc_url=$(uri_stdin "$url") || die "Couldn't check the value."
  enc_path=$(uri_stdin "$path") || die "Couldn't check the value."
  rss_post "/api/v2/rss/addFeed" < <(printf 'url=%s&path=%s' "$enc_url" "$enc_path") || rss_write_failed "$name"
  rss_read_tree
  rss_kind "$path"
  [[ $RSS_KIND != none ]] || die "Couldn't confirm ${name} was added."
  # D8: a new feed fills at once, even while processing is off. The feed
  # is added either way, so a refused refresh doesn't undo the answer.
  rss_post "/api/v2/rss/refreshItem" < <(printf 'itemPath=%s' "$enc_path") || true
  rss_ok_path "$path"
}

rss_add_folder() {
  rss_fields 1
  local path=${RSS_FIELDS[0]} name enc
  rss_new_segment "$path"
  name=$(rss_name_of "$path")
  assert_local_base
  enc=$(uri_stdin "$path") || die "Couldn't check the value."
  rss_post "/api/v2/rss/addFolder" < <(printf 'path=%s' "$enc") || rss_write_failed "$name"
  rss_read_tree
  rss_kind "$path"
  [[ $RSS_KIND != none ]] || die "Couldn't confirm ${name} was added."
  rss_ok_path "$path"
}

# moveItem, for renames only: `to` must be in the same folder as `from`.
rss_rename() {
  rss_fields 2
  local from=${RSS_FIELDS[0]} to=${RSS_FIELDS[1]} enc_from enc_to
  local parent
  rss_parent_of "$from"
  parent=$RSS_PARENT
  rss_parent_of "$to"
  [[ $RSS_PARENT == "$parent" ]] || rss_usage
  rss_new_segment "$to"
  assert_local_base
  [[ -n $from ]] || die "$RSS_FEED_GONE"
  rss_read_tree
  rss_kind "$from"
  [[ $RSS_KIND != none ]] || die "$RSS_FEED_GONE"
  enc_from=$(uri_stdin "$from") || die "Couldn't check the value."
  enc_to=$(uri_stdin "$to") || die "Couldn't check the value."
  rss_post "/api/v2/rss/moveItem" < <(printf 'itemPath=%s&destPath=%s' "$enc_from" "$enc_to") \
    || rss_write_failed "$(rss_name_of "$to")"
  rss_read_tree
  rss_kind "$to"
  [[ $RSS_KIND != none ]] || die "$RSS_UNCONFIRMED_RENAME"
  rss_kind "$from"
  [[ $RSS_KIND == none ]] || die "$RSS_UNCONFIRMED_RENAME"
  rss_ok_path "$to"
}

rss_remove() {
  rss_fields 1
  local path=${RSS_FIELDS[0]} name enc
  name=$(rss_name_of "$path")
  assert_local_base
  [[ -n $path ]] || die "$RSS_FEED_GONE"
  rss_read_tree
  rss_kind "$path"
  [[ $RSS_KIND != none ]] || die "$RSS_FEED_GONE"
  enc=$(uri_stdin "$path") || die "Couldn't check the value."
  rss_post "/api/v2/rss/removeItem" < <(printf 'path=%s' "$enc") || rss_write_failed "$name"
  rss_read_tree
  rss_kind "$path"
  [[ $RSS_KIND == none ]] || die "Couldn't confirm ${name} was removed."
  printf '%s\n' '{"ok":true}'
}

# "" refreshes everything (qBittorrent's root folder).
rss_refresh() {
  rss_fields 1
  local path=${RSS_FIELDS[0]} enc
  assert_local_base
  rss_read_tree
  rss_kind "$path"
  [[ $RSS_KIND != none ]] || die "$RSS_FEED_GONE"
  enc=$(uri_stdin "$path") || die "Couldn't check the value."
  rss_post "/api/v2/rss/refreshItem" < <(printf 'itemPath=%s' "$enc") || rss_write_failed ""
  printf '%s\n' '{"ok":true}'
}

# path NUL guid NUL expect. With a guid, one article; without, a whole
# feed or folder ("" is everything) after OV11's re-count: more unread
# than the confirm named answers {"ok":false,"unread":M} and posts
# nothing. The whole-scope POST omits articleId entirely
# (rsscontroller.cpp:143 branches on it being null).
rss_mark_read() {
  rss_fields 3
  local path=${RSS_FIELDS[0]} guid=${RSS_FIELDS[1]} expect=${RSS_FIELDS[2]} enc enc_guid unread
  # LC_ALL=C: under a UTF-8 locale [1-9] collates in non-ASCII digits.
  (LC_ALL=C; [[ $expect =~ ^(0|[1-9][[:digit:]]{0,8})$ ]]) || rss_usage
  assert_local_base
  rss_read_tree
  enc=$(uri_stdin "$path") || die "Couldn't check the value."
  if [[ -n $guid ]]; then
    rss_items_py read "$path" "$guid" "$RSS_TREE"
    case $RSS_PY_OUT in
      nofeed)
        rss_kind "$path"
        [[ $RSS_KIND == folder ]] && die "$RSS_ARTICLE_GONE"
        die "$RSS_FEED_GONE" ;;
      noarticle) die "$RSS_ARTICLE_GONE" ;;
    esac
    enc_guid=$(uri_stdin "$guid") || die "Couldn't check the value."
    rss_post "/api/v2/rss/markAsRead" < <(printf 'itemPath=%s&articleId=%s' "$enc" "$enc_guid") \
      || rss_write_failed ""
    rss_read_tree
    rss_items_py read "$path" "$guid" "$RSS_TREE"
    [[ $RSS_PY_OUT == read ]] || die "$RSS_UNCONFIRMED_READ"
    printf '%s\n' '{"ok":true}'
    return 0
  fi
  rss_items_py unread "$path" "$RSS_TREE"
  unread=$RSS_PY_OUT
  [[ $unread != none ]] || die "$RSS_FEED_GONE"
  [[ $unread =~ ^[[:digit:]]{1,9}$ ]] || die "qBittorrent sent something unreadable"
  if (( 10#$unread > 10#$expect )); then
    printf '{"ok":false,"unread":%s}\n' "$(( 10#$unread ))"
    return 0
  fi
  rss_post "/api/v2/rss/markAsRead" < <(printf 'itemPath=%s' "$enc") || rss_write_failed ""
  rss_read_tree
  rss_items_py unread "$path" "$RSS_TREE"
  [[ $RSS_PY_OUT == 0 ]] || die "$RSS_UNCONFIRMED_READ"
  printf '%s\n' '{"ok":true}'
}

# torrentURL NUL link: the hasTorrent rule, then torrents/add (the window
# confirms a magnet through AddAwaiter; nothing here reads rss/items).
rss_add() {
  rss_fields 2
  local torrent_url=${RSS_FIELDS[0]} link=${RSS_FIELDS[1]} via enc
  rss_rule hasTorrent "$torrent_url" "$link"
  via=$RULE_NORM
  assert_local_base
  enc=$(uri_stdin "$torrent_url") || die "Couldn't check the value."
  rss_post "/api/v2/torrents/add" 1 < <(printf 'urls=%s' "$enc") || die "qBittorrent refused it (${API_FAIL})"
  printf '{"ok":true,"via":"%s"}\n' "$via"
}

# ---------------------------------------------------------------------------
# Slice 5b2: `qbt rss rules|rules-preview-enabled|rule-*`, exactly per
# tests/fixtures/rss-rules-contract.md. Every rule and sentence comes from
# tests/fixtures/rss-autorules-cases.json, enforced by lib/rssautorules.py
# (which also runs pcre2grep, the pattern on a pipe). 5b1's framing holds:
# values on stdin, NUL-separated, reaching python, jq and curl on stdin;
# every write a POST (rss_post) read back from rss/rules; the one GET with
# a value (matchingArticles' ruleName) sends it with curl -G from stdin.
# Response bodies stay in shell variables; JSON lines come from python.
# ---------------------------------------------------------------------------

RULE_USAGE="usage: qbt rss rules|rules-preview-enabled|rule-check|rule-create|rule-set|rule-preview|rule-rename|rule-remove"
RULE_GONE="That rule is gone."
RULE_UNCONFIRMED_SAVE="Couldn't confirm the save."

rule_usage() {
  printf '%s\n' "$RULE_USAGE" >&2
  exit 2
}

# rss_fields for the rule commands: a wrong count is the rules' usage line.
rule_fields() {
  local want=$1 f=""
  RSS_FIELDS=()
  while IFS= read -r -d '' f; do
    RSS_FIELDS+=("$f")
  done
  RSS_FIELDS+=("$f")
  (( ${#RSS_FIELDS[@]} == want )) || rule_usage
}

# lib/rssautorules.py <mode> with the NUL-joined values $2... on stdin.
# RULE_RC is its exit status and RULE_OUT its output; 2 is the usage line
# and 4 an unreadable body, both ending the command here.
rule_py() {
  local mode=$1 out rc=0
  shift
  local IFS=
  out=$( { printf '%s' "$1"; shift; (( $# == 0 )) || printf '\0%s' "$@"; } \
    | python3 "$(qbt_lib_dir)/rssautorules.py" "$mode" 2>/dev/null) || rc=$?
  (( rc == 2 )) && rule_usage
  (( rc == 4 )) && die "qBittorrent sent something unreadable"
  (( rc <= 3 )) || die "Couldn't check the value."
  RULE_RC=$rc
  RULE_OUT=$out
}

# rule_py, where exit 1 is a refusal sentence to print.
rule_py_or_die() {
  rule_py "$@"
  if (( RULE_RC == 1 )); then
    [[ -n $RULE_OUT ]] && die "$RULE_OUT"
    die "Couldn't check the value."
  fi
}

# GET rss/rules into RSS_RULES, else dies.
rss_read_rules() {
  api_try GET "/api/v2/rss/rules" || die "qBittorrent refused it (${API_FAIL})"
  RSS_RULES=$API_BODY
}

# RULE_HAS: "yes" when rss/rules (RSS_RULES) holds the name $1 exactly.
rule_has() {
  rule_py has "$1" "$RSS_RULES"
  (( RULE_RC == 0 )) || die "qBittorrent sent something unreadable"
  RULE_HAS=$RULE_OUT
}

# rss_post's twin for a GET whose query arrives on stdin (curl -G turns the
# --data-binary body into the query), so the value is never on argv. The
# body lands in API_BODY; a failure sets API_FAIL (codes only).
rss_get() {
  local path=$1 out code
  assert_local_base
  ensure_state_dir "$(dirname "$COOKIE_FILE")"
  prepare_auth
  out=$(umask 077; curl -sS -g --noproxy '*' --max-time 5 -w '\n%{http_code}' -G \
    -b "$COOKIE_FILE" -c "$COOKIE_FILE" "${AUTH_ARGS[@]}" --data-binary @- "$(base_url)$path" 2>/dev/null) || true
  API_BODY="" API_FAIL=""
  if [[ $out == *$'\n'* ]]; then
    code=${out##*$'\n'}
    API_BODY=${out%$'\n'*}
  else
    code=$out
  fi
  [[ $code =~ ^[[:digit:]]{3}$ ]] || code=000
  case $code in
    200) return 0 ;;
    403) API_FAIL="$API_KEY_REFUSED" ;;
    000) API_FAIL="couldn't reach qBittorrent" ;;
    *) API_FAIL="HTTP $code" ;;
  esac
  API_BODY=""
  return 1
}

# rss/matchingArticles for the rule $1 into RULE_MATCHING, else dies.
rule_matching() {
  local enc
  enc=$(uri_stdin "$1") || die "Couldn't check the value."
  rss_get "/api/v2/rss/matchingArticles" < <(printf 'ruleName=%s' "$enc") || die "qBittorrent refused it (${API_FAIL})"
  RULE_MATCHING=$API_BODY
}

# POST rss/setRule with the name $1 and the ruleDef JSON $2, else dies.
rule_post_set() {
  local enc_name enc_def
  enc_name=$(uri_stdin "$1") || die "Couldn't check the value."
  enc_def=$(uri_stdin "$2") || die "Couldn't check the value."
  rss_post "/api/v2/rss/setRule" < <(printf 'ruleName=%s&ruleDef=%s' "$enc_name" "$enc_def") \
    || die "qBittorrent refused it (${API_FAIL})"
}

rss_rules() {
  local rules
  assert_local_base
  rss_read_rules
  rules=$RSS_RULES
  api_try GET "/api/v2/app/preferences" || die "qBittorrent refused it (${API_FAIL})"
  rule_py list "$rules" "$API_BODY"
  (( RULE_RC == 0 )) || die "qBittorrent sent something unreadable"
  printf '%s\n' "$RULE_OUT"
}

# key NUL value NUL useRegex: one field's kind, no request.
rss_rule_check() {
  rule_fields 3
  rule_py_or_die check "${RSS_FIELDS[0]}" "${RSS_FIELDS[1]}" "${RSS_FIELDS[2]}"
  printf '%s\n' "$RULE_OUT"
}

# name NUL feedUrl: a new rule, always disabled (OV7).
rss_rule_create() {
  rule_fields 2
  local name feed=${RSS_FIELDS[1]} def
  rule_py_or_die name "${RSS_FIELDS[0]}"
  name=$RULE_OUT
  assert_local_base
  rss_read_rules
  rule_has "$name"
  [[ $RULE_HAS == no ]] || die "There's already a rule called ${name}."
  rule_py create-def "$feed"
  def=$RULE_OUT
  rule_post_set "$name" "$def"
  rss_read_rules
  rule_py created "$name" "$feed" "$RSS_RULES"
  (( RULE_RC == 0 )) || die "Couldn't confirm ${name} was added."
  printf '%s' "$name" | jq -Rsc '{ok: true, name: .}'
}

# The saved rule $1's preview groups into RULE_PREVIEW (RSS_RULES read).
rule_preview_of() {
  local name=$1 matching
  rule_matching "$name"
  matching=$RULE_MATCHING
  rss_read_tree
  rule_py preview "$name" "$RSS_RULES" "$matching" "$RSS_TREE"
  # 3 is the rule missing; anything else (a crash exits 1) isn't "gone".
  (( RULE_RC == 3 )) && die "$RULE_GONE"
  (( RULE_RC == 0 )) || die "qBittorrent sent something unreadable"
  RULE_PREVIEW=$RULE_OUT
}

# name NUL changesJson NUL snapshotJson NUL enable: the contract's nine
# steps. The shape is checked before any request.
rss_rule_set() {
  rule_fields 4
  local name=${RSS_FIELDS[0]} changes=${RSS_FIELDS[1]} snapshot=${RSS_FIELDS[2]} enable=${RSS_FIELDS[3]}
  local def merged m
  rule_py shape "$changes" "$snapshot" "$enable"
  assert_local_base
  rss_read_rules
  rule_has "$name"
  [[ $RULE_HAS == yes ]] || die "$RULE_GONE"
  # D6, OV13, D5/OV10 and the enable word.
  rule_py apply "$name" "$changes" "$snapshot" "$enable" "$RSS_RULES"
  (( RULE_RC == 3 )) && die "$RULE_GONE"
  if (( RULE_RC == 1 )); then
    [[ -n $RULE_OUT ]] && die "$RULE_OUT"
    die "Couldn't check the value."
  fi
  def=$RULE_OUT
  if [[ $enable == on ]]; then
    # Never on without the preview check, before any write.
    rule_preview_of "$name"
    m=$(printf '%s' "$RULE_PREVIEW" | jq -r '.noTorrent | length') || die "qBittorrent sent something unreadable"
    [[ $m =~ ^[[:digit:]]+$ ]] || die "qBittorrent sent something unreadable"
    (( m == 0 )) \
      || die "${m} matching articles have no torrent link, and qBittorrent would retry them forever. Tighten the rule first."
  fi
  rule_post_set "$name" "$def"
  rss_read_rules
  rule_py readback "$name" "$def" "$RSS_RULES"
  (( RULE_RC == 0 )) || die "$RULE_UNCONFIRMED_SAVE"
  # OV9: the episode memory unioned, once.
  rule_py union "$name" "$def" "$RSS_RULES"
  (( RULE_RC == 0 )) || die "$RULE_UNCONFIRMED_SAVE"
  merged=$RULE_OUT
  if [[ -n $merged ]]; then
    rule_post_set "$name" "$merged"
    rss_read_rules
    rule_py readback-merged "$name" "$merged" "$RSS_RULES"
    (( RULE_RC == 0 )) || die "$RULE_UNCONFIRMED_SAVE"
  fi
  printf '%s\n' '{"ok":true}'
}

rss_rule_preview() {
  rule_fields 1
  local name=${RSS_FIELDS[0]}
  assert_local_base
  rss_read_rules
  rule_has "$name"
  [[ $RULE_HAS == yes ]] || die "$RULE_GONE"
  rule_preview_of "$name"
  printf '%s\n' "$RULE_PREVIEW"
}

# Every enabled rule's join, deduped (D8's count).
rss_rules_preview_enabled() {
  local rules names=() n args=()
  assert_local_base
  rss_read_rules
  rules=$RSS_RULES
  rule_py enabled "$rules"
  while IFS= read -r -d '' n; do
    names+=("$n")
  done < <(printf '%s' "$RULE_OUT" | jq -j '.[] | (., "\u0000")')
  rss_read_tree
  for n in "${names[@]}"; do
    rule_matching "$n"
    args+=("$n" "$RULE_MATCHING")
  done
  rule_py preview-enabled "$rules" "$RSS_TREE" "${args[@]}"
  printf '%s\n' "$RULE_OUT"
}

# from NUL to: renameRule is a silent no-op on a clash, so pre-check and
# read back.
rss_rule_rename() {
  rule_fields 2
  local from=${RSS_FIELDS[0]} to enc_from enc_to
  rule_py_or_die name "${RSS_FIELDS[1]}"
  to=$RULE_OUT
  if [[ $to == "$from" ]]; then
    printf '%s' "$to" | jq -Rsc '{ok: true, name: .}'
    return 0
  fi
  assert_local_base
  rss_read_rules
  rule_has "$from"
  [[ $RULE_HAS == yes ]] || die "$RULE_GONE"
  rule_has "$to"
  [[ $RULE_HAS == no ]] || die "There's already a rule called ${to}."
  enc_from=$(uri_stdin "$from") || die "Couldn't check the value."
  enc_to=$(uri_stdin "$to") || die "Couldn't check the value."
  rss_post "/api/v2/rss/renameRule" < <(printf 'ruleName=%s&newRuleName=%s' "$enc_from" "$enc_to") \
    || die "qBittorrent refused it (${API_FAIL})"
  rss_read_rules
  rule_py renamed "$from" "$to" "$RSS_RULES"
  (( RULE_RC == 0 )) || die "Couldn't confirm the rename."
  printf '%s' "$to" | jq -Rsc '{ok: true, name: .}'
}

rss_rule_remove() {
  rule_fields 1
  local name=${RSS_FIELDS[0]} enc
  assert_local_base
  rss_read_rules
  rule_has "$name"
  [[ $RULE_HAS == yes ]] || die "$RULE_GONE"
  enc=$(uri_stdin "$name") || die "Couldn't check the value."
  rss_post "/api/v2/rss/removeRule" < <(printf 'ruleName=%s' "$enc") || die "qBittorrent refused it (${API_FAIL})"
  rss_read_rules
  rule_has "$name"
  [[ $RULE_HAS == no ]] || die "Couldn't confirm ${name} was removed."
  printf '%s\n' '{"ok":true}'
}

cmd_rss() {
  local api_error_detail=code
  case "${1:-}:$#" in
    items:1) rss_items ;;
    article:1) rss_article ;;
    error:1) rss_error ;;
    add-feed:1) rss_add_feed ;;
    add-folder:1) rss_add_folder ;;
    rename:1) rss_rename ;;
    remove:1) rss_remove ;;
    refresh:1) rss_refresh ;;
    mark-read:1) rss_mark_read ;;
    add:1) rss_add ;;
    rules:1) rss_rules ;;
    rules-preview-enabled:1) rss_rules_preview_enabled ;;
    rule-check:1) rss_rule_check ;;
    rule-create:1) rss_rule_create ;;
    rule-set:1) rss_rule_set ;;
    rule-preview:1) rss_rule_preview ;;
    rule-rename:1) rss_rule_rename ;;
    rule-remove:1) rss_rule_remove ;;
    *) rss_usage ;;
  esac
}

