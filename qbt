set_key() {
  local file=$1 key=$2 value=$3
  local section=${4:-Preferences}
  mkdir -p "$(dirname "$file")"
  touch "$file"
  python3 - "$file" "$key" "$value" "$section" <<'PY'
import sys
from pathlib import Path

path, key, value, section = Path(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
header = "[" + section + "]"
lines = path.read_text().splitlines() if path.exists() else []
lines = [ln for ln in lines if not ln.startswith(key + "=")]
out = []
inserted = False
if not any(ln.strip() == header for ln in lines):
    if lines and lines[-1].strip() != "":
        lines.append("")
    lines.append(header)
for ln in lines:
    out.append(ln)
    if ln.strip() == header and not inserted:
        out.append(f"{key}={value}")
        inserted = True
if not inserted:
    out.append(header)
    out.append(f"{key}={value}")
path.write_text("\n".join(out) + "\n")
PY
}

