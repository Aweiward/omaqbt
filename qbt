magnet_meta() {
  python3 - "$1" <<'PY'
import json, re, sys, base64
from urllib.parse import parse_qs, unquote_plus
url = sys.argv[1]
ids = []
for m in re.finditer(r"xt=urn:btih:([A-Za-z0-9]+)", url, re.I):
    v = m.group(1)
    if len(v) == 40 and re.fullmatch(r"[0-9a-fA-F]+", v):
        ids.append(v.lower())
    elif len(v) == 32:
        try:
            ids.append(base64.b32decode(v.upper()).hex())
        except Exception:
            pass
for m in re.finditer(r"xt=urn:btmh:([A-Za-z0-9]+)", url, re.I):
    ids.append(m.group(1).lower())
qs = parse_qs(url.split("?", 1)[-1], keep_blank_values=True)
dn = unquote_plus((qs.get("dn") or [""])[0])
print(json.dumps({"ids": ids, "dn": dn}))
PY
}

