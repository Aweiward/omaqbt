# The value reaches python on stdin, never on argv or in the environment
# (eng 4b D7): it may be the API key, and /proc/*/cmdline is world readable.
# So the script goes in -c rather than on stdin.
set_key() {
  local file=$1 key=$2 value=$3
  local section=${4:-Preferences}
  local script
  (umask 077; mkdir -p "$(dirname "$file")")
  IFS= read -r -d '' script <<'PY' || true
import os, re, sys, tempfile
from pathlib import Path

path, key, section = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
value = sys.stdin.read()
header = "[" + section + "]"
lines = path.read_text().splitlines() if path.exists() else []
# QSettings trims blanks around the key, so " key = v" is the same key.
lines = [ln for ln in lines if not re.match(r"[ \t]*" + re.escape(key) + r"[ \t]*=", ln)]
out = []
inserted = False
if not any(ln.strip() == header for ln in lines):
    if lines and lines[-1].strip() != "":
        lines.append("")
    lines.append(header)
for ln in lines:
    out.append(ln)
    if ln.strip() == header and not inserted:
        out.append(f"{key}={value}")
        inserted = True
if not inserted:
    out.append(header)
    out.append(f"{key}={value}")
# Replaced in one rename, owner-only: a crash never leaves a truncated
# conf, a reader never sees half of one, and the conf holds the API key.
fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".qBittorrent.conf.")
try:
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(out) + "\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)
except BaseException:
    os.unlink(tmp)
    raise
PY
  printf '%s' "$value" | python3 -c "$script" "$file" "$key" "$section"
}

bind_mullvad() {
