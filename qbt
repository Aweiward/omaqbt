# Number of matching rows for $1, used by fetch-metadata below to wait for a
# delete to take effect and for a re-add to reappear.
fetch_metadata_hash_count() {
  local hash=$1
  api GET "/api/v2/torrents/info?hashes=${hash}" 2>/dev/null | jq --arg h "$hash" '[.[] | select((.hash // "" | ascii_downcase) == ($h | ascii_downcase))] | length'
}

# Polls fetch_metadata_hash_count against an overall wall-clock deadline
# (SECONDS, bash's own elapsed-time counter), not an iteration count: each
# GET can itself take up to api()'s own --max-time before failing, so an
# iteration budget (N tries * 0.2s) can't bound the real wall time -- N
# slow/failing GETs at up to 5s each would stretch a 5s budget to N*5s.
# $3 selects "gone" (0) or "present" (nonzero).
fetch_metadata_wait_for() {
  local hash=$1 timeout=$2 want=$3 interval=0.2
  # Belt and suspenders: cmd_fetch_metadata already validates timeout
  # before calling here, but this expansion is the one that would actually
  # blow up, so it re-checks rather than trusting every future caller to
  # have done it first.
  [[ $timeout =~ ^[[:digit:]]+$ ]] || timeout=5
  (( ${#timeout} <= 3 )) || timeout=600
  timeout=$(( 10#$timeout ))
  local deadline=$(( SECONDS + timeout ))
  local n
  while true; do
    # A failed GET (dropped connection, timeout, 5xx) must not read as
    # "gone" -- the pipeline prints nothing, and `[[ "" -eq 0 ]]` is true in
    # bash, so check the assignment's own exit status before trusting $n.
    if n=$(fetch_metadata_hash_count "$hash"); then
      if [[ $want == gone && $n == 0 ]]; then return 0; fi
      if [[ $want == present && $n -ge 1 ]]; then return 0; fi
    fi
    (( SECONDS < deadline )) || return 1
    sleep "$interval"
  done
}

# F12/Review Focus 5: the magnet (and any tracker passkeys inside it) must
# never be printed. Recovery always tries the inbox first -- with the
# 20-item cap bypassed, since that cap guards against a flood of browser
# clicks, not a rescue, and magnet-drain already dedupes an inbox entry
# against the library, so inboxing a torrent that (rarely) still exists in
# qBittorrent is harmless. Only if the inbox itself can't be written (e.g. a
# hardened state dir) does this fall back to a 0600 file, naming only its
# path.
fetch_metadata_rescue() {
  local hash=$1 magnet=$2
  # Disarm the swap's signal trap first, so a second signal can't start
  # a second rescue while this one runs.
  trap - TERM HUP INT
  # A subshell: cmd_magnet_inbox's own `die` (e.g. some unexpected failure)
  # must only end that subshell, never this command, and its stdout
  # ({"ok":true}) must never leak onto ours.
  if (cmd_magnet_inbox "$magnet" --force) >/dev/null 2>&1; then
    die "Couldn't finish re-adding it; the magnet is in your inbox."
  fi
  local dir fallback
  dir=$(magnet_state_dir)
  if (ensure_state_dir "$dir") >/dev/null 2>&1; then
    fallback="$dir/lost-magnet-$(date +%s)-$$.txt"
    if (umask 077; printf '%s\n' "$magnet" >"$fallback") 2>/dev/null && [[ -s $fallback ]]; then
      die "Couldn't finish re-adding it or save it to the inbox; the magnet is saved at: $fallback"
    fi
  fi
  die "Couldn't finish re-adding it, and couldn't save the magnet anywhere; check qBittorrent for hash $hash"
}

# F4, Deviation 1. Swaps a metadata-less torrent for a fresh magnet add so
# qBittorrent goes looking for metadata again. Every refusal below happens
# before the delete; nothing is destroyed unless we already hold the magnet,
# save path, category and tags needed to put it back. Past that point the
# torrent may already be gone no matter what a later step reports, so every
# failure from here on -- the delete call itself failing, the wait-for-gone
# deadline passing, a GET failing mid-poll, or any add failure -- runs the
# same rescue rather than ever claiming the torrent is still safe.
cmd_fetch_metadata() {
  local hash=${1:-}
  local api_error_detail=code
  [[ -n $hash ]] || die "usage: qbt fetch-metadata <hash>"
  valid_single_hash "$hash" || die "invalid hash"

  # Validated, capped and arithmetic-proved before anything else -- in
  # particular before the very first request -- so a bad
  # QBT_FETCH_METADATA_TIMEOUT can never reach `SECONDS + timeout` inside
  # fetch_metadata_wait_for with a raw bash arithmetic error and no rescue
  # able to run once the delete has gone out. [:digit:] not [0-9]: under a
  # UTF-8 locale a non-ASCII "digit"-lookalike (e.g. a fullwidth "１") can
  # otherwise pass a [0-9] range. Unlike the refusals below (which only
  # reject what qBittorrent's own data says), an unparseable override is a
  # broken environment, not qBittorrent's business, so it's rejected
  # outright rather than silently swapped for the default; a parseable but
  # out-of-range value is merely clamped.
  local timeout=${QBT_FETCH_METADATA_TIMEOUT:-5}
  [[ $timeout =~ ^[[:digit:]]+$ ]] || die "invalid QBT_FETCH_METADATA_TIMEOUT"
  # A digit string long enough to overflow bash's integer type would make
  # `10#$timeout` wrap to an unpredictable value rather than just being
  # "large" -- reject the length before doing that arithmetic at all, so
  # the cap below never depends on wraparound behavior. 3 digits comfortably
  # covers the 600 cap with room to spare.
  if (( ${#timeout} > 3 )); then
    timeout=600
  else
    timeout=$(( 10#$timeout ))
    if (( timeout < 1 )); then
      timeout=5
    elif (( timeout > 600 )); then
      timeout=600
    fi
  fi
  # Exercise the exact expansion fetch_metadata_wait_for will do, here,
  # while it's still safe to just die: if this ever fails for a reason the
  # checks above didn't anticipate, it fails before anything has been sent.
  local _deadline_canary
  (( _deadline_canary = SECONDS + timeout )) || die "invalid fetch-metadata timeout"

  local info row count
  info=$(api GET "/api/v2/torrents/info?hashes=${hash}")
  row=$(jq -c --arg h "$hash" '[.[] | select((.hash // "" | ascii_downcase) == ($h | ascii_downcase))]' <<<"$info")
  count=$(jq 'length' <<<"$row")
  [[ $count -eq 1 ]] || die "torrent not found"

  local total_size state magnet savepath category tags
  total_size=$(jq -r '.[0].total_size // -1' <<<"$row")
  state=$(jq -r '.[0].state // empty' <<<"$row")
  magnet=$(jq -r '.[0].magnet_uri // empty' <<<"$row")
  savepath=$(jq -r '.[0].save_path // empty' <<<"$row")
  category=$(jq -r '.[0].category // empty' <<<"$row")
  tags=$(jq -r '.[0].tags // empty' <<<"$row")
  # qBittorrent joins tags with ", "; the WebUI add endpoint wants a bare
  # comma list.
  tags=${tags//, /,}

  # Fail closed: only a clean integer that's <= 0 counts as "no metadata".
  # Anything jq couldn't read as a plain integer is treated the same as
  # "has metadata" rather than assumed safe. [:digit:] (not [0-9], see
  # valid_hashes above): under a UTF-8 locale a non-ASCII "digit"-lookalike
  # can otherwise pass a [0-9] range and reach the `((...))` below with a
  # raw bash arithmetic error on stderr before this dies cleanly.
  [[ $total_size =~ ^-?[[:digit:]]+$ ]] || die "It already has metadata."
  (( total_size <= 0 )) || die "It already has metadata."
  [[ $state == stoppedDL || $state == pausedDL ]] || die "Stop it first."
  [[ -n $magnet ]] || die "No magnet link for this torrent."

  # Not a bare `api POST ...`: that runs in this shell, so `die`'s `exit`
  # would abort the whole command before any rescue ever ran (this is the
  # exact bug: a delete that qBittorrent already applied, but whose
  # response curl never delivered -- e.g. it timed out -- would otherwise
  # kill the script here with the torrent already gone and no rescue).
  # Wrapping it in a command substitution runs it in a subshell instead, so
  # a `die` there only fails the assignment.
  # From the delete on, the torrent may be gone: a TERM/HUP/INT (the
  # window closing, a logout) must still put the magnet in the inbox.
  # "$hash"/"$magnet" expand when the trap fires, from this function's
  # locals. Cleared once the re-add is listed, or by the rescue itself.
  trap 'fetch_metadata_rescue "$hash" "$magnet"; exit 1' TERM HUP INT
  local delete_resp
  if ! delete_resp=$(api POST "/api/v2/torrents/delete" "hashes=${hash}&deleteFiles=false" 2>&1); then
    fetch_metadata_rescue "$hash" "$magnet"
  fi

  fetch_metadata_wait_for "$hash" "$timeout" gone || fetch_metadata_rescue "$hash" "$magnet"

  local add_body
  add_body="urls=$(uri_encode "$magnet")"
  add_body+="&savepath=$(uri_encode "$savepath")"
  add_body+="&category=$(uri_encode "$category")"
  add_body+="&tags=$(uri_encode "$tags")"
  add_body+="&stopCondition=MetadataReceived&stopped=false&paused=false"

  # The add's response body is not read: qBittorrent's success body for it
  # isn't a confirmed contract (every other add path ignores it too). The
  # wait-for-present poll below is the proof -- a failed add never lists
  # the hash, so it still ends in the rescue.
  if ! (api POST "/api/v2/torrents/add" "$add_body") >/dev/null 2>&1; then
    fetch_metadata_rescue "$hash" "$magnet"
  fi
  fetch_metadata_wait_for "$hash" "$timeout" present || fetch_metadata_rescue "$hash" "$magnet"
  trap - TERM HUP INT

  printf '%s\n' '{"ok":true}'
}

