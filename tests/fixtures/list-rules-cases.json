    { "kind": "trackerUrl", "input": "HTTP://tracker.example/announce", "ok": false, "message": "Use an http, https or udp tracker URL.", "why": "uppercase scheme, case-sensitive like qbt's valid_tracker_url" },
    { "kind": "trackerUrl", "input": "tracker.example/announce", "ok": false, "message": "Use an http, https or udp tracker URL.", "why": "no scheme" },
