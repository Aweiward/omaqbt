    { "kind": "trackerUrl", "input": "udp://tracker.example:1337/an nounce", "ok": false, "message": "Use an http, https or udp tracker URL.", "why": "inner space" },
    { "kind": "trackerUrl", "input": "udp://tracker.example:1337/announce\nhttp://tracker.example/announce", "ok": false, "message": "Use an http, https or udp tracker URL.", "why": "a newline: one URL per line" },
    { "kind": "trackerUrl", "input": "udp://tracker.example:1337/announce\r", "ok": false, "message": "Use an http, https or udp tracker URL.", "why": "a carriage return" },
    { "kind": "trackerUrl", "input": "udp://tracker.example:1337/an nounce", "ok": false, "message": "Use an http, https or udp tracker URL.", "why": "a no-break space (printable ASCII only)" },
    { "kind": "trackerUrl", "input": "udp://tracker.example:1337/café", "ok": false, "message": "Use an http, https or udp tracker URL.", "why": "non-ASCII" },
